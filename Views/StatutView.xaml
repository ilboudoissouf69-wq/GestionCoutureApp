<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.StatutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <!-- ================================================================
         STATUT VIEW V3 — Kanban 4 colonnes par pièce.
         Boss / Secrétaire : lecture + modification statut.
         Couturier : consultation uniquement.
    ================================================================ -->

    <Page.Resources>
        <!-- Ambre primaire local — NE PAS redéfinir AccentBrush (global dynamique) -->
        <SolidColorBrush x:Key="PrimaryAmber" Color="#D97706"/>
        <!-- Ardoise foncée locale -->
        <SolidColorBrush x:Key="SlateDark"  Color="#0F172A"/>
        <SolidColorBrush x:Key="SlateMuted" Color="#64748B"/>
        <!-- Bordure Kanban — renommée pour ne pas masquer la clé globale BorderColor (Color) -->
        <SolidColorBrush x:Key="KanbanBorderBrush" Color="#E2E8F0"/>

        <!-- Style commun des en-têtes de colonne Kanban -->
        <Style x:Key="KanbanColumnHeader" TargetType="Border">
            <Setter Property="CornerRadius"    Value="10,10,0,0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <!-- Style carte Kanban -->
        <Style x:Key="KanbanCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="BorderBrush"     Value="{StaticResource KanbanBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Bouton icône transparent -->
        <Style x:Key="BtnIcon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Titre -->
            <RowDefinition Height="Auto"/>  <!-- Filtres + recherche -->
            <RowDefinition Height="Auto"/>  <!-- LoadingIndicator -->
            <RowDefinition Height="*"/>     <!-- Kanban -->
            <RowDefinition Height="Auto"/>  <!-- Pied de page -->
        </Grid.RowDefinitions>

        <!-- ── Titre ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Suivi des pièces — Kanban"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource SlateDark}"/>
            <Border Height="3" Width="44" CornerRadius="2"
                    Background="{StaticResource PrimaryAmber}"
                    HorizontalAlignment="Left" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ── Barre filtres + recherche + filtre couturier ─────────── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="{StaticResource KanbanBorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,10">
            <Grid Margin="14,8,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pills de filtre -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="BtnFiltreRetard"
                            Content="&#x26A0; En retard"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Retard">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#FEE2E2" BorderBrush="#FCA5A5"
                                        BorderThickness="1.5" CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#FECACA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#B91C1C"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreAfaire"
                            Content="&#x25A1; A faire"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="A faire">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#F1F5F9"
                                        BorderBrush="{StaticResource KanbanBorderBrush}"
                                        BorderThickness="1.5" CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#475569"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreEnCours"
                            Content="&#x1F7E1; En cours"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="En cours">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#FEF3C7" BorderBrush="#FDE68A"
                                        BorderThickness="1.5" CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#FDE68A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#92400E"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreTerminee"
                            Content="&#x1F7E2; Terminee"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Terminee">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#DCFCE7" BorderBrush="#86EFAC"
                                        BorderThickness="1.5" CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#BBF7D0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#15803D"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreLivree"
                            Content="&#x1F535; Livree"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Livree">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#DBEAFE" BorderBrush="#93C5FD"
                                        BorderThickness="1.5" CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#BFDBFE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#1D4ED8"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreAll"
                            Content="&#x2630; Tous"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold"
                            Margin="0,3,6,3" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#0F172A"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                    </Button>
                </WrapPanel>

                <!-- Filtre couturier — masqué si role Couturier (géré code-behind) -->
                <ComboBox Grid.Column="1"
                          x:Name="CmbFiltreCouturier"
                          Style="{StaticResource ModernComboBox}"
                          Width="180" Height="34"
                          Margin="8,0,8,0"
                          DisplayMemberPath="Prenom"
                          SelectedValuePath="IdEmploye"
                          SelectionChanged="CmbFiltreCouturier_SelectionChanged"
                          ToolTip="Filtrer par couturier"/>

                <!-- Recherche -->
                <TextBox Grid.Column="2"
                         x:Name="TxtRecherche"
                         Style="{StaticResource ModernTextBox}"
                         Width="200" Height="34"
                         ToolTip="Rechercher un client ou un type de v&#234;tement"
                         TextChanged="TxtRecherche_TextChanged"/>
            </Grid>
        </Border>

        <!-- ── Indicateur chargement ─────────────────────────────────── -->
        <Border Grid.Row="2"
                x:Name="LoadingIndicator"
                Background="#FFFBF5"
                Padding="14,8"
                Visibility="Collapsed"
                CornerRadius="8"
                BorderBrush="{StaticResource PrimaryAmber}"
                BorderThickness="1"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#x23F3;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Chargement..." FontSize="12"
                           Foreground="{StaticResource SlateMuted}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Grille Kanban 4 colonnes ──────────────────────────────── -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="GrilleKanban" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280" MinWidth="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280" MinWidth="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- ════════════════════════════════════════════
                     COLONNE 1 — A FAIRE
                ════════════════════════════════════════════ -->
                <Border Grid.Column="0" CornerRadius="10"
                        BorderBrush="{StaticResource KanbanBorderBrush}"
                        BorderThickness="1" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- En-tête colonne -->
                        <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="A faire" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource SlateDark}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="10"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurAfaire" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Liste cartes -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,8,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="ListeAfaire">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KanbanCard}">
                                                <Grid Margin="12,10,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Ligne 1 : N° commande + badge statut + boutons -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource SlateMuted}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="CMD #"/>
                                                            <Run Text="{Binding IdCommande}"/>
                                                            <Run Text=" — P#"/>
                                                            <Run Text="{Binding IdPieceCommande}"/>
                                                        </TextBlock>
                                                        <!-- Badge En retard -->
                                                        <Border Grid.Column="1"
                                                                Background="#FEE2E2" CornerRadius="6" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="&#x26A0; Retard" FontSize="10"
                                                                       FontWeight="Bold" Foreground="#B91C1C"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Ligne 2 : Client + type vêtement -->
                                                    <TextBlock Grid.Row="1" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111827" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Commande.Client.Prenom, TargetNullValue='', FallbackValue=''}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Commande.Client.Nom, TargetNullValue='Client inconnu', FallbackValue='Client inconnu'}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource SlateMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                                               Text="{Binding TypeVetement}"/>

                                                    <!-- Ligne 3 : Description (tronquée + tooltip) -->
                                                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                               Margin="0,0,0,4"
                                                               Text="{Binding DescriptionPrecision}"
                                                               ToolTip="{Binding DescriptionPrecision}"/>

                                                    <!-- Ligne 4 : Couturier + RDV + actions -->
                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <!-- Couturier assigné -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}"
                                                                           VerticalAlignment="Center">
                                                                    <Run Text="{Binding Couturier.Prenom, TargetNullValue='Non assign&#233;', FallbackValue='Non assign&#233;'}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding Couturier.Nom, TargetNullValue='', FallbackValue=''}"/>
                                                                </TextBlock>
                                                                <!-- Badge ⚠ si pas de couturier -->
                                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="4,1"
                                                                        Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IdCouturier}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#x26A0; A attribuer" FontSize="10"
                                                                               FontWeight="Bold" Foreground="#92400E"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- Date RDV -->
                                                            <TextBlock FontSize="11" Margin="0,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource SlateMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="RDV : "/>
                                                                <Run Text="{Binding Commande.DateFin, StringFormat={}{0:dd/MM/yy}, TargetNullValue='--/--/--'}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Boutons action -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <!-- Avancer statut -->
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x25B6;" FontSize="12"
                                                                    Foreground="{StaticResource PrimaryAmber}"
                                                                    ToolTip="A faire &#x2192; En cours"
                                                                    Click="BtnAvancerStatut_Click"
                                                                    Tag="{Binding}"/>
                                                            <!-- Menu ⋯ -->
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x22EF;" FontSize="16"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Changer le statut (cette pi&#232;ce ou toute la commande)"
                                                                    Click="BtnPasserA_Click"
                                                                    Tag="{Binding}"/>
                                                            <!-- WhatsApp -->
                                                            <Button Content="&#x1F4AC;" FontSize="13"
                                                                    ToolTip="Contacter le client sur WhatsApp"
                                                                    Click="BtnWhatsApp_Click"
                                                                    Tag="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                <Setter Property="ToolTip" Value="&#x26A0; En retard &#x2014; Rappel RDV"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <!-- Fiche atelier -->
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x1F5C2;" FontSize="13"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Ouvrir la fiche atelier"
                                                                    Click="BtnFicheAtelier_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- État vide -->
                                <TextBlock x:Name="TxtVideAfaire"
                                           Text="Aucune pi&#232;ce &#xE0; faire"
                                           FontSize="12" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Spacer -->
                <GridSplitter Grid.Column="1" Width="0" IsEnabled="False"/>

                <!-- ════════════════════════════════════════════
                     COLONNE 2 — EN COURS
                ════════════════════════════════════════════ -->
                <Border Grid.Column="2" CornerRadius="10"
                        BorderBrush="{StaticResource KanbanBorderBrush}"
                        BorderThickness="1" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}"
                                Background="#FEF3C7" BorderBrush="#FDE68A">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="En cours" FontSize="13" FontWeight="Bold"
                                               Foreground="#92400E" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FDE68A" CornerRadius="10"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurEnCours" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,8,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="ListeEnCours">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KanbanCard}"
                                                    BorderBrush="#FDE68A">
                                                <Grid Margin="12,10,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource SlateMuted}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="CMD #"/>
                                                            <Run Text="{Binding IdCommande}"/>
                                                            <Run Text=" — P#"/>
                                                            <Run Text="{Binding IdPieceCommande}"/>
                                                        </TextBlock>
                                                        <Border Grid.Column="1"
                                                                Background="#FEE2E2" CornerRadius="6" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="&#x26A0; Retard" FontSize="10"
                                                                       FontWeight="Bold" Foreground="#B91C1C"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111827" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Commande.Client.Prenom, TargetNullValue='', FallbackValue=''}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Commande.Client.Nom, TargetNullValue='Client inconnu', FallbackValue='Client inconnu'}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource SlateMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                                               Text="{Binding TypeVetement}"/>
                                                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                               Margin="0,0,0,4"
                                                               Text="{Binding DescriptionPrecision}"
                                                               ToolTip="{Binding DescriptionPrecision}"/>

                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}"
                                                                           VerticalAlignment="Center">
                                                                    <Run Text="{Binding Couturier.Prenom, TargetNullValue='Non assign&#233;', FallbackValue='Non assign&#233;'}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding Couturier.Nom, TargetNullValue='', FallbackValue=''}"/>
                                                                </TextBlock>
                                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="4,1"
                                                                        Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IdCouturier}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#x26A0; A attribuer" FontSize="10"
                                                                               FontWeight="Bold" Foreground="#92400E"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource SlateMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="RDV : "/>
                                                                <Run Text="{Binding Commande.DateFin, StringFormat={}{0:dd/MM/yy}, TargetNullValue='--/--/--'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x25B6;" FontSize="12"
                                                                    Foreground="{StaticResource PrimaryAmber}"
                                                                    ToolTip="En cours &#x2192; Terminee"
                                                                    Click="BtnAvancerStatut_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x22EF;" FontSize="16"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Changer le statut"
                                                                    Click="BtnPasserA_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Content="&#x1F4AC;" FontSize="13"
                                                                    ToolTip="Contacter le client sur WhatsApp"
                                                                    Click="BtnWhatsApp_Click"
                                                                    Tag="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                                <Setter Property="ToolTip" Value="&#x26A0; En retard &#x2014; Rappel RDV"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x1F5C2;" FontSize="13"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Ouvrir la fiche atelier"
                                                                    Click="BtnFicheAtelier_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtVideEnCours"
                                           Text="Aucune pi&#232;ce en cours"
                                           FontSize="12" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="0" IsEnabled="False"/>

                <!-- ════════════════════════════════════════════
                     COLONNE 3 — TERMINEE
                ════════════════════════════════════════════ -->
                <Border Grid.Column="4" CornerRadius="10"
                        BorderBrush="{StaticResource KanbanBorderBrush}"
                        BorderThickness="1" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}"
                                Background="#DCFCE7" BorderBrush="#86EFAC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Terminee" FontSize="13" FontWeight="Bold"
                                               Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#BBF7D0" CornerRadius="10"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurTerminee" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,8,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="ListeTerminee">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KanbanCard}"
                                                    BorderBrush="#86EFAC">
                                                <Grid Margin="12,10,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource SlateMuted}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="CMD #"/>
                                                            <Run Text="{Binding IdCommande}"/>
                                                            <Run Text=" — P#"/>
                                                            <Run Text="{Binding IdPieceCommande}"/>
                                                        </TextBlock>
                                                        <!-- Badge "Prête" visible sur cette colonne -->
                                                        <Border Grid.Column="1"
                                                                Background="#DCFCE7" CornerRadius="6" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="&#x2705; Pr&#234;te" FontSize="10"
                                                                       FontWeight="Bold" Foreground="#15803D"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111827" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Commande.Client.Prenom, TargetNullValue='', FallbackValue=''}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Commande.Client.Nom, TargetNullValue='Client inconnu', FallbackValue='Client inconnu'}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource SlateMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                                               Text="{Binding TypeVetement}"/>
                                                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                               Margin="0,0,0,4"
                                                               Text="{Binding DescriptionPrecision}"
                                                               ToolTip="{Binding DescriptionPrecision}"/>

                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}"
                                                                           VerticalAlignment="Center">
                                                                    <Run Text="{Binding Couturier.Prenom, TargetNullValue='Non assign&#233;', FallbackValue='Non assign&#233;'}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding Couturier.Nom, TargetNullValue='', FallbackValue=''}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}">
                                                                <Run Text="RDV : "/>
                                                                <Run Text="{Binding Commande.DateFin, StringFormat={}{0:dd/MM/yy}, TargetNullValue='--/--/--'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x25B6;" FontSize="12"
                                                                    Foreground="{StaticResource PrimaryAmber}"
                                                                    ToolTip="Terminee &#x2192; Livree"
                                                                    Click="BtnAvancerStatut_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x22EF;" FontSize="16"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Changer le statut"
                                                                    Click="BtnPasserA_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Content="&#x1F4AC;" FontSize="13"
                                                                    ToolTip="&#x2705; Pi&#232;ce pr&#234;te &#x2014; Notifier le client"
                                                                    Opacity="1"
                                                                    Click="BtnWhatsApp_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x1F5C2;" FontSize="13"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Ouvrir la fiche atelier"
                                                                    Click="BtnFicheAtelier_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtVideTerminee"
                                           Text="Aucune pi&#232;ce terminee"
                                           FontSize="12" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="5" Width="0" IsEnabled="False"/>

                <!-- ════════════════════════════════════════════
                     COLONNE 4 — LIVREE
                ════════════════════════════════════════════ -->
                <Border Grid.Column="6" CornerRadius="10"
                        BorderBrush="{StaticResource KanbanBorderBrush}"
                        BorderThickness="1" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}"
                                Background="#DBEAFE" BorderBrush="#93C5FD">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Livree" FontSize="13" FontWeight="Bold"
                                               Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#BFDBFE" CornerRadius="10"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurLivree" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,8,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="ListeLivree">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KanbanCard}"
                                                    BorderBrush="#93C5FD">
                                                <Grid Margin="12,10,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource SlateMuted}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="CMD #"/>
                                                            <Run Text="{Binding IdCommande}"/>
                                                            <Run Text=" — P#"/>
                                                            <Run Text="{Binding IdPieceCommande}"/>
                                                        </TextBlock>
                                                        <Border Grid.Column="1"
                                                                Background="#DBEAFE" CornerRadius="6" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="&#x1F4E6; Livr&#233;e" FontSize="10"
                                                                       FontWeight="Bold" Foreground="#1D4ED8"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111827" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Commande.Client.Prenom, TargetNullValue='', FallbackValue=''}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Commande.Client.Nom, TargetNullValue='Client inconnu', FallbackValue='Client inconnu'}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource SlateMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                                               Text="{Binding TypeVetement}"/>
                                                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                               Margin="0,0,0,4"
                                                               Text="{Binding DescriptionPrecision}"
                                                               ToolTip="{Binding DescriptionPrecision}"/>

                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}"
                                                                           VerticalAlignment="Center">
                                                                    <Run Text="{Binding Couturier.Prenom, TargetNullValue='Non assign&#233;', FallbackValue='Non assign&#233;'}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding Couturier.Nom, TargetNullValue='', FallbackValue=''}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource SlateMuted}">
                                                                <Run Text="RDV : "/>
                                                                <Run Text="{Binding Commande.DateFin, StringFormat={}{0:dd/MM/yy}, TargetNullValue='--/--/--'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <!-- Livree = statut final, pas de bouton avancer -->
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x22EF;" FontSize="16"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Changer le statut"
                                                                    Click="BtnPasserA_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Content="&#x1F4AC;" FontSize="13"
                                                                    ToolTip="Contacter le client"
                                                                    Opacity="0.55"
                                                                    Click="BtnWhatsApp_Click"
                                                                    Tag="{Binding}"/>
                                                            <Button Style="{StaticResource BtnIcon}"
                                                                    Content="&#x1F5C2;" FontSize="13"
                                                                    Foreground="{StaticResource SlateMuted}"
                                                                    ToolTip="Ouvrir la fiche atelier"
                                                                    Click="BtnFicheAtelier_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtVideLivree"
                                           Text="Aucune pi&#232;ce livr&#233;e"
                                           FontSize="12" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ── Pied de page : pagination ────────────────────────────── -->
        <Border Grid.Row="4"
                Background="White"
                Padding="16,10"
                BorderBrush="{StaticResource KanbanBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtPaginationInfo"
                           FontSize="12"
                           Foreground="{StaticResource SlateMuted}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnPagePrecedente"
                            Content="&#x2190;" Width="36" Height="32"
                            Margin="0,0,8,0"
                            Click="BtnPagePrecedente_Click"
                            Style="{StaticResource BtnGhost}"
                            IsEnabled="False" FontSize="14"
                            ToolTip="Page pr&#233;c&#233;dente"/>
                    <Button x:Name="BtnPageSuivante"
                            Content="&#x2192;" Width="36" Height="32"
                            Click="BtnPageSuivante_Click"
                            Style="{StaticResource BtnGhost}"
                            IsEnabled="False" FontSize="14"
                            ToolTip="Page suivante"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             MODAL — Livraison non soldée
             Overlay semi-transparent + panneau centré
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              x:Name="ModalLivraisonNonSoldee"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <!-- Fond semi-opaque -->
            <Rectangle Fill="#80000000"/>
            <!-- Panneau centré -->
            <Border Background="White"
                    CornerRadius="12"
                    BorderBrush="{StaticResource KanbanBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border Padding="28,24,28,24">
                    <StackPanel>
                        <!-- Titre -->
                        <TextBlock Text="Livraison non sold&#233;e"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource SlateDark}"
                                   Margin="0,0,0,6"/>
                        <Border Height="2" Background="{StaticResource PrimaryAmber}"
                                HorizontalAlignment="Left" Width="40" Margin="0,0,0,14"/>

                        <!-- Info solde -->
                        <TextBlock x:Name="TxtInfoSoldeRestant"
                                   FontSize="13" Foreground="#374151"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- Motif obligatoire -->
                        <TextBlock Text="Motif de la livraison non sold&#233;e (obligatoire) :"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SlateMuted}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtMotifLivraison"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 Margin="0,0,0,18"/>

                        <!-- Boutons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAnnulerLivraisonNonSoldee"
                                    Content="Annuler"
                                    Style="{StaticResource BtnGhost}"
                                    Height="36" Padding="16,0"
                                    Margin="0,0,10,0"
                                    Click="BtnAnnulerLivraisonNonSoldee_Click"/>
                            <Button x:Name="BtnConfirmerLivraisonNonSoldee"
                                    Content="Confirmer la livraison"
                                    Style="{StaticResource BtnPrimary}"
                                    Height="36" Padding="16,0"
                                    Click="BtnConfirmerLivraisonNonSoldee_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

    </Grid>
</Page>
