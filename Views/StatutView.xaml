<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.StatutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <!-- ================================================================
         STATUT VIEW V2 — une ligne par COMMANDE, dépliable par pièce.
         Boss / Secrétaire : lecture + modification statut.
         Couturier : consultation uniquement.
    ================================================================ -->
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Titre ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Suivi des commandes"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <Border Height="3" Width="44" CornerRadius="2"
                    Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ── Barre de filtres rapides ── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtres onglet-style -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal">

                    <Button x:Name="BtnFiltreRetard"
                            Content="⚠ En retard"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Retard">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5"
                                        BorderThickness="1.5" CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#B91C1C"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreAfaire"
                            Content="⬜ À faire"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="A faire">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1.5" CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#475569"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreEnCours"
                            Content="🟡 En cours"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="En cours">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A"
                                        BorderThickness="1.5" CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#92400E"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreTerminee"
                            Content="🟢 Terminée"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Terminee">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC"
                                        BorderThickness="1.5" CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#15803D"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreLivree"
                            Content="🔵 Livrée"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="Livree">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#DBEAFE" BorderBrush="#93C5FD"
                                        BorderThickness="1.5" CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="#1D4ED8"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnFiltreAll"
                            Content="☰ Tous"
                            Height="32" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,6,4" Cursor="Hand"
                            Click="BtnFiltre_Click" Tag="">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#0F172A"
                                        CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                    </Button>
                </WrapPanel>

                <!-- Recherche -->
                <TextBox Grid.Column="2"
                         x:Name="TxtRecherche"
                         Style="{StaticResource ModernTextBox}"
                         Width="220"
                         TextChanged="TxtRecherche_TextChanged"/>
            </Grid>
        </Border>

        <!-- ── Indicateur chargement ── -->
        <Border Grid.Row="2"
                x:Name="LoadingIndicator"
                Background="#FFFBF5"
                Padding="14"
                Visibility="Collapsed"
                CornerRadius="8"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Chargement..." FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Tableau principal — une ligne par COMMANDE, dépliable ── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridCommandes"
                      Style="{StaticResource ModernGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">

                <!-- ── Colonnes de la ligne commande ── -->
                <DataGrid.Columns>

                    <!-- N° commande -->
                    <DataGridTextColumn Header="N°"
                                        Binding="{Binding IdCommande}"
                                        Width="48" MinWidth="40">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Client -->
                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding Client.Nom}"
                                        Width="*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Vêtements résumés -->
                    <DataGridTextColumn Header="Vêtement(s)"
                                        Binding="{Binding TypeVetementAffiche}"
                                        Width="*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Statut global (badge coloré) -->
                    <DataGridTemplateColumn Header="Statut" Width="140" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3"
                                        HorizontalAlignment="Left" Margin="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatutGlobal}" Value="En cours">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutGlobal}" Value="Terminee">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutGlobal}" Value="Livree">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutGlobal}" Value="Terminee partiellement">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutGlobal}" Value="Livree partiellement">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatutGlobalAffiche}"
                                               FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="En cours">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Terminee">
                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Livree">
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Terminee partiellement">
                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Livree partiellement">
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date RDV — rouge si en retard -->
                    <DataGridTemplateColumn Header="RDV" Width="90" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateFin, StringFormat={}{0:dd/MM/yy}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="4,0"
                                           x:Name="TxtDate"/>
                                <DataTemplate.Triggers>
                                    <!-- Rouge si DateFin dépassée ET commande pas terminée/livrée -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding EstEnRetard}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="TxtDate" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="TxtDate" Property="FontWeight" Value="Bold"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Reste à payer -->
                    <DataGridTemplateColumn Header="Reste dû (FCFA)" Width="110" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResteAPayer, StringFormat={}{0:N0}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResteAPayer}" Value="0">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Couturier(s) -->
                    <DataGridTextColumn Header="Couturier(s)"
                                        Binding="{Binding CouturiersAffiche}"
                                        Width="*" MinWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Boutons : Passer à… + WhatsApp -->
                    <DataGridTemplateColumn Header="Actions" Width="160" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <!-- Menu déroulant "Passer à…" — Boss et Secrétaire seulement -->
                                    <!-- La visibilité est gérée en code-behind via la propriété
                                         BtnForcerVisibility injectée par le code -->
                                    <Button x:Name="BtnPasserA"
                                            Content="Passer à…"
                                            Height="28" Padding="8,0"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Margin="0,0,4,0"
                                            Click="BtnPasserA_Click"
                                            Tag="{Binding IdCommande}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{StaticResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>
                                            <SolidColorBrush Color="White"/>
                                        </Button.Foreground>
                                    </Button>

                                    <!-- Bouton WhatsApp -->
                                    <Button Content="💬"
                                            Width="30" Height="28"
                                            FontSize="14"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            ToolTip="Contacter le client sur WhatsApp"
                                            Click="BtnWhatsApp_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0.55"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Terminee">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="ToolTip" Value="✅ Commande prête — Notifier le client"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutGlobal}" Value="Livree">
                                                        <Setter Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

                <!-- ── Détail dépliable : pièces de la commande ── -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,1,0,1"
                                Padding="24,12,24,12">
                            <StackPanel>
                                <TextBlock Text="Pièces de la commande :"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,8"/>

                                <!-- Liste des pièces -->
                                <ItemsControl x:Name="ListePieces"
                                              ItemsSource="{Binding Pieces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    CornerRadius="6"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Infos pièce -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#111827">
                                                            <Run Text="Pièce #"/>
                                                            <Run Text="{Binding IdPieceCommande}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding TypeVetement}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,2,0,0">
                                                            <Run Text="Couturier : "/>
                                                            <Run Text="{Binding Couturier.Prenom, TargetNullValue='—'}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding Couturier.Nom, TargetNullValue=''}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Badge statut pièce -->
                                                    <Border Grid.Column="1"
                                                            CornerRadius="8" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="Terminee">
                                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="Livree">
                                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatutAffiche}"
                                                                   FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#374151"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Terminee">
                                                                            <Setter Property="Foreground" Value="#065F46"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Livree">
                                                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- ComboBox changement statut pièce
                                                         (visible Boss/Secrétaire, géré code-behind) -->
                                                    <ComboBox Grid.Column="2"
                                                              x:Name="CmbStatutPiece"
                                                              Width="130" Height="28"
                                                              FontSize="11"
                                                              SelectedValue="{Binding Statut, Mode=OneWay}"
                                                              SelectionChanged="CmbStatutPiece_SelectionChanged"
                                                              Tag="{Binding IdPieceCommande}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,0,0">
                                                        <ComboBoxItem Content="À faire" Tag="A faire"/>
                                                        <ComboBoxItem Content="En cours" Tag="En cours"/>
                                                        <ComboBoxItem Content="Terminée" Tag="Terminee"/>
                                                        <ComboBoxItem Content="Livrée" Tag="Livree"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

            </DataGrid>
        </Border>

        <!-- ── Pied : pagination + compteur ── -->
        <Border Grid.Row="4"
                Background="#FAF5F2"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtPaginationInfo"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnPagePrecedente"
                            Content="←" Width="36" Height="32"
                            Margin="0,0,8,0"
                            Click="BtnPagePrecedente_Click"
                            Style="{StaticResource BtnGhost}"
                            IsEnabled="False" FontSize="14"/>
                    <Button x:Name="BtnPageSuivante"
                            Content="→" Width="36" Height="32"
                            Click="BtnPageSuivante_Click"
                            Style="{StaticResource BtnGhost}"
                            IsEnabled="False" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
