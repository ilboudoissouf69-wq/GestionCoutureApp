<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.StatutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      KeyDown="Page_KeyDown">

    <!--
        STATUT VIEW V6 — une carte par pièce, SCROLL GLOBAL unique.
        La Page contient une Grid racine :
          • Row 0 : ScrollViewer (tout le Kanban + en-tête + pied)
          • Row 0 (superposé) : modal livraison non soldée (Panel.ZIndex=100)
        Le Frame dans MainWindow a ScrollViewer.VerticalScrollBarVisibility="Disabled"
        pour ne pas absorber le scroll. Résultat : une seule scrollbar à droite
        qui fait défiler l'ensemble des 4 colonnes simultanément.
    -->

    <Page.Resources>
        <SolidColorBrush x:Key="KanbanSlate900" Color="#0F172A"/>
        <SolidColorBrush x:Key="KanbanSlate700" Color="#334155"/>
        <SolidColorBrush x:Key="KanbanSlate500" Color="#64748B"/>
        <SolidColorBrush x:Key="KanbanSlate400" Color="#94A3B8"/>
        <SolidColorBrush x:Key="KanbanSlate200" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="KanbanAmber"    Color="#D97706"/>

        <!-- Bouton icône compact -->
        <Style x:Key="KanbanBtnIcon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton étape pleine largeur -->
        <Style x:Key="KanbanBtnEtape" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding"         Value="0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             DATATEMPLATE UNIQUE — une carte par commande
             DataContext = Commande
        ========================================================== -->
        <DataTemplate x:Key="CommandeCardTemplate">
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#E8EDF2"
                    BorderThickness="1"
                    Margin="0,0,0,10"
                    Padding="14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.06" Color="#000000" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CMD # + badge retard + bouton ⋯ -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource KanbanSlate400}"
                                       VerticalAlignment="Center">
                                <Run Text="CMD #"/>
                                <Run Text="{Binding IdCommande, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- Badge retard -->
                            <Border Background="#FEE2E2" CornerRadius="4"
                                    Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnRetard, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#x26A0; Retard" FontSize="9" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                        </StackPanel>
                        <!-- Boutons icônes : ✂️ fiche atelier + ⋯ menu statut -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource KanbanBtnIcon}"
                                    FontSize="13"
                                    Background="#F1F5F9"
                                    ToolTip="Fiche de coupe atelier"
                                    Click="BtnFicheAtelier_Click"
                                    Tag="{Binding}">
                                <Button.Content>&#x2702;</Button.Content>
                            </Button>
                            <Button Style="{StaticResource KanbanBtnIcon}"
                                    FontSize="14"
                                    Foreground="{StaticResource KanbanSlate400}"
                                    ToolTip="Changer le statut"
                                    Click="BtnPasserA_Click"
                                    Tag="{Binding}">
                                <Button.Content>&#x22EF;</Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- TypeVetement — gros titre -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding TypeVetementAffiche, Mode=OneWay}"
                               FontSize="15" FontWeight="Black"
                               Foreground="{StaticResource KanbanSlate900}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,3"/>

                    <!-- Nom client -->
                    <TextBlock Grid.Row="2"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource KanbanSlate700}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,3">
                        <Run Text="{Binding Client.Prenom, TargetNullValue='', FallbackValue='', Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Client.Nom, TargetNullValue='', FallbackValue='', Mode=OneWay}"/>
                    </TextBlock>

                    <!-- Description (tooltip complet) -->
                    <TextBlock Grid.Row="3"
                               FontSize="11"
                               Foreground="{StaticResource KanbanSlate500}"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="34"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Pieces[0].DescriptionPrecision, Mode=OneWay, FallbackValue=''}"/>
                                <Setter Property="ToolTip" Value="{Binding Pieces[0].DescriptionPrecision, Mode=OneWay}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Afficher seulement si la première pièce a une description -->
                                    <DataTrigger Binding="{Binding Pieces.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Couturier(s) | Date RDV -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Couturier(s) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F9F5;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource KanbanSlate500}"
                                       Text="{Binding CouturiersAffiche, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="110"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Date RDV -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4C5;" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource KanbanSlate500}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnRetard, Mode=OneWay}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding DateFin, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Bouton étape — adapte texte/couleur selon StatutGlobal -->
                    <Button Grid.Row="7"
                            HorizontalAlignment="Stretch"
                            Click="BtnAvancerStatut_Click"
                            Tag="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KanbanBtnEtape}">
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{StaticResource KanbanSlate200}"/>
                                <Setter Property="Foreground"  Value="{StaticResource KanbanSlate700}"/>
                                <Setter Property="Content"     Value="D&#233;marrer &#x2794;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatutGlobal, Mode=OneWay}" Value="En cours">
                                        <Setter Property="BorderBrush" Value="#93C5FD"/>
                                        <Setter Property="Foreground"  Value="#1E40AF"/>
                                        <Setter Property="Content"     Value="&#x2299; Marquer Pr&#234;te &#x2713;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatutGlobal, Mode=OneWay}" Value="Terminee">
                                        <Setter Property="Background"  Value="#059669"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                        <Setter Property="Content"     Value="&#x1F4E6; Livrer au Client"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatutGlobal, Mode=OneWay}" Value="Terminee partiellement">
                                        <Setter Property="Background"  Value="#059669"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                        <Setter Property="Foreground"  Value="White"/>
                                        <Setter Property="Content"     Value="&#x1F4E6; Livrer au Client"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatutGlobal, Mode=OneWay}" Value="Livree">
                                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                        <Setter Property="Foreground"  Value="#059669"/>
                                        <Setter Property="Content"     Value="&#x2713; Remis au client"/>
                                        <Setter Property="IsEnabled"   Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatutGlobal, Mode=OneWay}" Value="Livree partiellement">
                                        <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                        <Setter Property="Foreground"  Value="#059669"/>
                                        <Setter Property="Content"     Value="&#x2713; Remis au client"/>
                                        <Setter Property="IsEnabled"   Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <!-- ================================================================
         Grid racine — permet de superposer le modal par-dessus le scroll
    ================================================================ -->
    <Grid>

        <!-- ── ScrollViewer GLOBAL : une seule barre de scroll à droite ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ EN-TÊTE ═══ -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="38" Height="38" Background="#FEF3C7"
                            CornerRadius="10" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#x1F4CB;" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Suivi de Confection en Atelier"
                                   FontSize="22" FontWeight="Black"
                                   Foreground="{StaticResource KanbanSlate900}"/>
                        <TextBlock Text="Tableau Kanban par &#233;tape de confection &#x2022; Progression des pi&#232;ces et respect des d&#233;lais"
                                   FontSize="12" Foreground="{StaticResource KanbanSlate500}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2"
                            x:Name="PanelFiltreCouturier"
                            Background="White"
                            BorderBrush="{StaticResource KanbanSlate200}"
                            BorderThickness="1" CornerRadius="8"
                            Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="&#x25BD; Filtrer couturier : "
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource KanbanSlate500}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFiltreCouturier"
                                      Width="160" BorderThickness="0"
                                      Background="Transparent"
                                      DisplayMemberPath="Prenom"
                                      SelectedValuePath="IdEmploye"
                                      SelectionChanged="CmbFiltreCouturier_SelectionChanged"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ BARRE RECHERCHE ═══ -->
                <Border Grid.Row="1" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource KanbanSlate200}"
                        BorderThickness="1" Margin="0,0,0,12">
                    <Grid Margin="14,8,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="12"
                                   Foreground="{StaticResource KanbanSlate500}"
                                   VerticalAlignment="Center">
                            Rechercher (client, type de v&#234;tement&#x2026;)
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 x:Name="TxtRecherche"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="260" Height="34"
                                 TextChanged="TxtRecherche_TextChanged"/>
                    </Grid>
                </Border>

                <!-- ═══ LOADING ═══ -->
                <Border Grid.Row="2"
                        x:Name="LoadingIndicator"
                        Background="#FFFBF5" Padding="14,7"
                        Visibility="Collapsed" CornerRadius="8"
                        BorderBrush="{StaticResource KanbanAmber}"
                        BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#x23F3;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Chargement..." FontSize="12"
                                   Foreground="{StaticResource KanbanSlate500}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ═══ KANBAN 4 COLONNES — hauteur Auto ═══
                     Chaque colonne grandit avec ses cartes.
                     Le ScrollViewer parent fournit le défilement global.
                ═══ -->
                <Grid Grid.Row="3" x:Name="GrilleKanban">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="230"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="230"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="230"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="230"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══ COLONNE 1 — À FAIRE ══ -->
                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="14" Padding="10,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#94A3B8"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#475569">
                                        &#xC0; FAIRE / EN ATTENTE
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="10"
                                        BorderBrush="{StaticResource KanbanSlate200}"
                                        BorderThickness="1" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurAfaire" Text="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource KanbanSlate500}"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ListeAfaire"
                                          ItemTemplate="{StaticResource CommandeCardTemplate}"/>
                            <TextBlock x:Name="TxtVideAfaire"
                                       Text="Aucune commande ici."
                                       FontSize="12" Foreground="#CBD5E1" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,30" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ COLONNE 2 — EN COURS ══ -->
                    <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="14" Padding="10,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#F59E0B"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#92400E">
                                        EN COURS DE CONFECTION
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="10"
                                        BorderBrush="#FDE68A" BorderThickness="1"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurEnCours" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ListeEnCours"
                                          ItemTemplate="{StaticResource CommandeCardTemplate}"/>
                            <TextBlock x:Name="TxtVideEnCours"
                                       Text="Aucune commande ici."
                                       FontSize="12" Foreground="#CBD5E1" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,30" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ COLONNE 3 — TERMINÉE ══ -->
                    <Border Grid.Column="4" Background="#F0F7FF" CornerRadius="14" Padding="10,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#3B82F6"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#1E40AF">
                                        TERMIN&#xC9;E / PR&#xCA;TE
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="10"
                                        BorderBrush="#BFDBFE" BorderThickness="1"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurTerminee" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ListeTerminee"
                                          ItemTemplate="{StaticResource CommandeCardTemplate}"/>
                            <TextBlock x:Name="TxtVideTerminee"
                                       Text="Aucune commande ici."
                                       FontSize="12" Foreground="#CBD5E1" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,30" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ COLONNE 4 — LIVRÉE ══ -->
                    <Border Grid.Column="6" Background="#F0FDF8" CornerRadius="14" Padding="10,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10B981"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#065F46">
                                        LIVR&#xC9;E AU CLIENT
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="10"
                                        BorderBrush="#A7F3D0" BorderThickness="1"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompteurLivree" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ListeLivree"
                                          ItemTemplate="{StaticResource CommandeCardTemplate}"/>
                            <TextBlock x:Name="TxtVideLivree"
                                       Text="Aucune commande ici."
                                       FontSize="12" Foreground="#CBD5E1" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,30" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ═══ PIED DE PAGE ═══ -->
                <Border Grid.Row="4" Background="White" Padding="16,10"
                        BorderBrush="{StaticResource KanbanSlate200}"
                        BorderThickness="0,1,0,0" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtPaginationInfo"
                                   FontSize="12" Foreground="{StaticResource KanbanSlate500}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnPagePrecedente"
                                    Content="&#x2190;" Width="36" Height="32"
                                    Margin="0,0,8,0" Click="BtnPagePrecedente_Click"
                                    Style="{StaticResource BtnGhost}"
                                    IsEnabled="False" FontSize="14"/>
                            <Button x:Name="BtnPageSuivante"
                                    Content="&#x2192;" Width="36" Height="32"
                                    Click="BtnPageSuivante_Click"
                                    Style="{StaticResource BtnGhost}"
                                    IsEnabled="False" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ================================================================
             MODAL — Livraison non soldée
             Panel.ZIndex=100 : couvre le ScrollViewer mais reste dans la Page
        ================================================================ -->
        <Grid x:Name="ModalLivraisonNonSoldee"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <Rectangle Fill="#99000000"/>
            <Border Background="White" Width="480" CornerRadius="16"
                    ClipToBounds="True"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Background="#D97706" Padding="20,14">
                        <TextBlock Text="&#x26A0;&#xFE0F; Autorisation Boss : Commande Non Sold&#233;e"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Margin="20,16,20,0">
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A"
                                BorderThickness="1" CornerRadius="10"
                                Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtInfoSoldeRestant"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#92400E" TextWrapping="Wrap"/>
                                <TextBlock Text="En tant que Boss, vous pouvez autoriser la livraison. Cette d&#233;rogation sera inscrite au Journal d&#x2019;Audit."
                                           FontSize="11" Foreground="#B45309"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Motif de la remise sans paiement total *"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource KanbanSlate700}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtMotifLivraison"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="70" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Padding="8"/>
                    </StackPanel>
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource KanbanSlate200}"
                            BorderThickness="0,1,0,0"
                            Padding="20,12" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAnnulerLivraisonNonSoldee"
                                    Content="Annuler" Height="36" Padding="16,0"
                                    Margin="0,0,10,0" Style="{StaticResource BtnGhost}"
                                    Click="BtnAnnulerLivraisonNonSoldee_Click"/>
                            <Button x:Name="BtnConfirmerLivraisonNonSoldee"
                                    Height="36" Padding="16,7" FontWeight="Bold"
                                    Background="#D97706" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BtnConfirmerLivraisonNonSoldee_Click">
                                <Button.Content>Autoriser la Livraison</Button.Content>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </Grid><!-- Fin Grid racine -->

</Page>
