<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.ClientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC"
      KeyDown="Page_KeyDown">

    <!-- ═══════════════════════════════════════════════════════════════════
         RESSOURCES LOCALES — Charte « Ambre & Ardoise »
         Clés préfixées « Cli » — aucune collision avec les ressources globales
    ═══════════════════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Couleurs de la charte -->
        <SolidColorBrush x:Key="CliAmber"       Color="#D97706"/>
        <SolidColorBrush x:Key="CliAmberHover"  Color="#B45309"/>
        <SolidColorBrush x:Key="CliAmberLight"  Color="#FEF3C7"/>
        <SolidColorBrush x:Key="CliAmberBorder" Color="#FCD34D"/>
        <SolidColorBrush x:Key="CliSlateDark"   Color="#0F172A"/>
        <SolidColorBrush x:Key="CliSlate"       Color="#1E293B"/>
        <SolidColorBrush x:Key="CliSlateMuted"  Color="#475569"/>
        <SolidColorBrush x:Key="CliSlateLight"  Color="#94A3B8"/>
        <SolidColorBrush x:Key="CliBorder"      Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CliRowHover"    Color="#FFFBEB"/>
        <SolidColorBrush x:Key="CliRowSelected" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="CliGreen"       Color="#25D366"/>
        <SolidColorBrush x:Key="CliGreenHover"  Color="#1DAA54"/>
        <SolidColorBrush x:Key="CliRed"         Color="#EF4444"/>
        <SolidColorBrush x:Key="CliHeaderBg"    Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CliHeaderFg"    Color="#475569"/>
        <SolidColorBrush x:Key="CliBodyFg"      Color="#1E293B"/>
        <SolidColorBrush x:Key="CliMutedFg"     Color="#64748B"/>
        <SolidColorBrush x:Key="CliInputBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="CliModalOverlay" Color="#99000000"/>

        <!-- ── Carte blanche (coins arrondis + ombre légère) ─────────── -->
        <Style x:Key="CliCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CliBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.06"
                                      BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox local charte Ambre ──────────────────────────────── -->
        <Style x:Key="CliTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="#FFFFFF"/>
            <Setter Property="BorderBrush"              Value="{StaticResource CliInputBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource CliBodyFg}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"     Value="{StaticResource CliAmber}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton Ambre principal ───────────────────────────────────── -->
        <Style x:Key="CliBtnAmber" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource CliAmber}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource CliAmberHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton fantôme (bordure Ambre) ──────────────────────────── -->
        <Style x:Key="CliBtnGhost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource CliAmber}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CliAmberBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource CliAmberLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton danger (rouge discret) ───────────────────────────── -->
        <Style x:Key="CliBtnDanger" TargetType="Button">
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="Foreground"      Value="{StaticResource CliRed}"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton icône rond discret ───────────────────────────────── -->
        <Style x:Key="CliBtnIcon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Libellé de champ formulaire ─────────────────────────────── -->
        <Style x:Key="CliFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CliSlateMuted}"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

    </Page.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         RACINE : Grid qui contient le layout principal ET la modale overlay
    ═══════════════════════════════════════════════════════════════════════ -->
    <Grid>

        <!-- ── Layout principal ─────────────────────────────────────────── -->
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 : en-tête + titre fiche -->
                <RowDefinition Height="Auto"/>   <!-- 1 : barre de recherche -->
                <RowDefinition Height="*"/>      <!-- 2 : tableau + fiche -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- 0 : colonne tableau -->
                <ColumnDefinition Width="20"/>   <!-- 1 : espace -->
                <ColumnDefinition Width="360"/>  <!-- 2 : colonne fiche -->
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════
                 ROW 0 — EN-TÊTE GAUCHE
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion des Clients"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource CliSlateDark}"/>
                    <Border Height="3" Width="50" CornerRadius="2"
                            Background="{StaticResource CliAmber}"
                            HorizontalAlignment="Left" Margin="0,6,0,4"/>
                    <TextBlock x:Name="TxtNbClients"
                               FontSize="12"
                               Foreground="{StaticResource CliSlateMuted}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CliBtnAmber}"
                        Padding="16,0"
                        Click="BtnOuvrirNouveauClient_Click"
                        ToolTip="Ajouter un nouveau client (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Nouveau Client" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════
                 ROW 0 — EN-TÊTE FICHE DROITE (toujours visible)
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.Column="2"
                    CornerRadius="12,12,0,0"
                    Margin="0,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border CornerRadius="12,12,0,0"
                        BorderBrush="#2E3D52" BorderThickness="1"
                        Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="Fiche Client"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Sélectionnez un client dans le tableau"
                                   FontSize="11" Foreground="#94A3B8"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 ROW 1 — BARRE DE RECHERCHE
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                <TextBox x:Name="TxtRecherche"
                         Style="{StaticResource CliTextBox}"
                         Padding="44,0,12,0"
                         TextChanged="TxtRecherche_TextChanged"/>
                <TextBlock Text="🔍" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="TxtRecherchePlaceholder"
                           Text="Rechercher par nom, prénom ou téléphone…"
                           FontSize="13"
                           Foreground="{StaticResource CliSlateLight}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="44,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════
                 ROW 2 COL 0 — CARTE TABLEAU + PAGINATION
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource CliCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- loading -->
                        <RowDefinition Height="*"/>     <!-- grille ou état vide -->
                        <RowDefinition Height="Auto"/>  <!-- pagination -->
                    </Grid.RowDefinitions>

                    <!-- Indicateur de chargement -->
                    <Border x:Name="LoadingIndicator"
                            Grid.Row="0"
                            Background="{StaticResource CliAmberLight}"
                            BorderBrush="{StaticResource CliAmber}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="12,12,0,0"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chargement des clients…"
                                       FontSize="12"
                                       Foreground="{StaticResource CliSlateMuted}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="GridClients"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CliBorder}"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="56"
                              ColumnHeaderHeight="40"
                              SelectionChanged="GridClients_SelectionChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <!-- Style des lignes -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CliRowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CliRowSelected}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Cellules : pas de sélection bleue WPF par défaut -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="0"/>
                                <Setter Property="Background"      Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"      Value="Transparent"/>
                                        <Setter Property="Foreground"      Value="{StaticResource CliBodyFg}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- En-têtes de colonnes -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"      Value="{StaticResource CliHeaderBg}"/>
                                <Setter Property="Foreground"      Value="{StaticResource CliHeaderFg}"/>
                                <Setter Property="FontWeight"      Value="Bold"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="Padding"         Value="12,0"/>
                                <Setter Property="Height"          Value="40"/>
                                <Setter Property="BorderBrush"     Value="{StaticResource CliBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                            <!-- COL 1 : CLIENT — NomComplet + sous-titre -->
                            <DataGridTemplateColumn Header="CLIENT" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NomComplet}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CliBodyFg}"/>
                                            <TextBlock Text="{Binding SousTitreDerniereCommande}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource CliMutedFg}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- COL 2 : TÉLÉPHONE -->
                            <DataGridTemplateColumn Header="TÉLÉPHONE" Width="155" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0">
                                            <TextBlock Text="📞" FontSize="12"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock FontSize="12"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="{Binding Telephone}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource CliBodyFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Telephone}" Value="">
                                                                <Setter Property="Text"       Value="—"/>
                                                                <Setter Property="Foreground" Value="{StaticResource CliSlateLight}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- COL 3 : COMMANDES — pastille arrondie -->
                            <DataGridTemplateColumn Header="COMMANDES" Width="105" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="12" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource CliAmberLight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NbCommandes}" Value="0">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="{Binding NbCommandes}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource CliAmber}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NbCommandes}" Value="0">
                                                                <Setter Property="Foreground" Value="{StaticResource CliSlateLight}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- COL 4 : ACTIONS -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="130" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0">

                                            <!-- WhatsApp (désactivé si pas de téléphone) -->
                                            <Button ToolTip="Envoyer un message WhatsApp"
                                                    Margin="0,0,4,0"
                                                    Click="BtnWhatsAppTableau_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CliBtnIcon}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Telephone}" Value="">
                                                                <Setter Property="Opacity"   Value="0.3"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="💬" FontSize="13"/>
                                            </Button>

                                            <!-- Modifier -->
                                            <Button Style="{StaticResource CliBtnIcon}"
                                                    ToolTip="Modifier ce client"
                                                    Margin="0,0,4,0"
                                                    Click="BtnModifierClient_Click">
                                                <TextBlock Text="✏️" FontSize="13"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Style="{StaticResource CliBtnDanger}"
                                                    Width="30" Height="30" Padding="0"
                                                    ToolTip="Supprimer ce client"
                                                    Click="BtnSupprimerClient_Click">
                                                <TextBlock Text="🗑️" FontSize="12"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- État vide -->
                    <Border x:Name="PanelEtatVide"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Padding="0,50">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="48"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEtatVide"
                                       Text="Aucun client enregistré"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource CliSlateMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Cliquez sur « + Nouveau Client » pour commencer"
                                       FontSize="12"
                                       Foreground="{StaticResource CliSlateLight}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pagination -->
                    <Border Grid.Row="2"
                            Background="#FAFBFC"
                            BorderBrush="{StaticResource CliBorder}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPaginationInfo"
                                       Grid.Column="0"
                                       FontSize="12"
                                       Foreground="{StaticResource CliSlateMuted}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnPagePrecedente"
                                        Style="{StaticResource CliBtnGhost}"
                                        Padding="12,0" Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="BtnPagePrecedente_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="←" Margin="0,0,4,0"/>
                                        <TextBlock Text="Préc."/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPageSuivante"
                                        Style="{StaticResource CliBtnGhost}"
                                        Padding="12,0"
                                        IsEnabled="False"
                                        Click="BtnPageSuivante_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Suiv."/>
                                        <TextBlock Text="→" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 ROW 2 COL 2 — FICHE DÉTAILLÉE DROITE
            ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource CliCardStyle}"
                    Padding="0" CornerRadius="0,0,12,12">
                <Grid>

                <!-- État : aucune sélection -->
                <Border x:Name="PanelAucuneSelection"
                        Padding="24,60" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="48"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucun client sélectionné"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource CliSlateMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="Cliquez sur une ligne du tableau"
                                   FontSize="12"
                                   Foreground="{StaticResource CliSlateLight}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Fiche client (visible après sélection) -->
                <ScrollViewer x:Name="PanelFicheDetaillee"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel>

                        <!-- En-tête fiche : nom + WhatsApp -->
                        <Border Padding="18,14" CornerRadius="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1E293B" Offset="0"/>
                                    <GradientStop Color="#334155" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFicheNomComplet"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="TxtFicheIdClient"
                                               FontSize="11" Foreground="#94A3B8"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Height="32" Padding="10,0"
                                        Cursor="Hand"
                                        ToolTip="Ouvrir WhatsApp"
                                        Click="BtnFicheWhatsApp_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" CornerRadius="8"
                                                    Background="{StaticResource CliGreen}"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock Text="WhatsApp"
                                                               Foreground="White" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background"
                                                            Value="{StaticResource CliGreenHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Corps fiche -->
                        <StackPanel Margin="18,14,18,18">

                            <!-- Téléphone -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="📞" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFicheTelephone"
                                           FontSize="13"
                                           Foreground="{StaticResource CliBodyFg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Height="1"
                                    Background="{StaticResource CliBorder}"
                                    Margin="0,0,0,14"/>

                            <!-- Historique des commandes -->
                            <TextBlock Text="Historique des commandes"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource CliSlateDark}"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="TxtAucuneCommande"
                                       Text="Aucune commande pour ce client"
                                       FontSize="12"
                                       Foreground="{StaticResource CliSlateLight}"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,10"/>

                            <ItemsControl x:Name="ItemsHistoriqueCommandes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                CornerRadius="8"
                                                BorderBrush="{StaticResource CliBorder}"
                                                BorderThickness="1"
                                                Background="#FAFCFF"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Titre + badge statut -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TitreCommande}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource CliBodyFg}"/>
                                                    <Border Grid.Column="1"
                                                            CornerRadius="4" Padding="6,2"
                                                            Background="{StaticResource CliAmberLight}">
                                                        <TextBlock Text="{Binding StatutAffiche}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource CliAmber}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Résumé pièces + date -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ResumePieces}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource CliMutedFg}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>

                                                <!-- Reste à payer (si > 0) -->
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding ResteAPayerAffiche}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource CliRed}"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding ResteAPayerVisible}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1"
                                    Background="{StaticResource CliBorder}"
                                    Margin="0,6,0,14"/>

                            <!-- Dernières mesures -->
                            <TextBlock Text="Dernières mesures"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource CliSlateDark}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMesuresSource"
                                       FontSize="11"
                                       Foreground="{StaticResource CliSlateMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtAucuneMesure"
                                       Text="Aucune mesure enregistrée"
                                       FontSize="12"
                                       Foreground="{StaticResource CliSlateLight}"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,10"/>
                            <WrapPanel x:Name="ItemsDernieresMesures"
                                       Margin="0,0,0,8"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             MODALE CLIENT — overlay bloquant, ZIndex élevé
        ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ModalClient"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="{StaticResource CliModalOverlay}">

            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MinWidth="440" MaxWidth="500"
                    Style="{StaticResource CliCardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- titre -->
                        <RowDefinition Height="Auto"/>  <!-- corps formulaire -->
                        <RowDefinition Height="Auto"/>  <!-- pied boutons -->
                    </Grid.RowDefinitions>

                    <!-- Barre titre modale -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtModalTitre"
                                           Text="Ajouter un Nouveau Client"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Renseignez les informations du client"
                                           FontSize="11" Foreground="#94A3B8"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- ✕ fermer -->
                            <Button Grid.Column="1"
                                    Width="28" Height="28"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    ToolTip="Fermer (Échap)"
                                    Click="BtnFermerModal_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="6"
                                                Background="Transparent" Padding="4">
                                            <TextBlock Text="✕" FontSize="13"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="#44FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps formulaire (3 champs) -->
                    <Border Grid.Row="1" Padding="24,20">
                        <StackPanel>

                            <!-- Prénom * -->
                            <TextBlock Style="{StaticResource CliFieldLabel}">
                                Prénom <Run Foreground="{StaticResource CliAmber}">*</Run>
                            </TextBlock>
                            <TextBox x:Name="TxtPrenom"
                                     Style="{StaticResource CliTextBox}"
                                     Margin="0,0,0,14"
                                     MaxLength="200"
                                     PreviewTextInput="TxtPrenom_PreviewTextInput"
                                     KeyDown="TxtChamp_KeyDown"/>

                            <!-- Nom * -->
                            <TextBlock Style="{StaticResource CliFieldLabel}">
                                Nom <Run Foreground="{StaticResource CliAmber}">*</Run>
                            </TextBlock>
                            <TextBox x:Name="TxtNom"
                                     Style="{StaticResource CliTextBox}"
                                     Margin="0,0,0,14"
                                     MaxLength="200"
                                     PreviewTextInput="TxtNom_PreviewTextInput"
                                     KeyDown="TxtChamp_KeyDown"/>

                            <!-- Téléphone + bouton WhatsApp -->
                            <TextBlock Text="Téléphone"
                                       Style="{StaticResource CliFieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTelephone"
                                         Grid.Column="0"
                                         Style="{StaticResource CliTextBox}"
                                         MaxLength="20"
                                         KeyDown="TxtChamp_KeyDown"/>
                                <Button Grid.Column="2"
                                        x:Name="BtnWhatsAppPanneau"
                                        Height="40" Padding="12,0"
                                        Cursor="Hand"
                                        ToolTip="Ouvrir WhatsApp pour ce client"
                                        Click="BtnWhatsAppPanneau_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" CornerRadius="8"
                                                    Background="{StaticResource CliGreen}"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="WhatsApp"
                                                               Foreground="White" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background"
                                                            Value="{StaticResource CliGreenHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Pied : Annuler + Enregistrer -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource CliBorder}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12"
                            Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource CliBtnGhost}"
                                    Height="40"
                                    Click="BtnFermerModal_Click">
                                <TextBlock Text="Annuler"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource CliBtnAmber}"
                                    Height="40"
                                    Click="BtnSauvegarderClient_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="Enregistrer"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
