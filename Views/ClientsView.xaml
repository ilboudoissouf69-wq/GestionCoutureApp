<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.ClientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════ GAUCHE — liste ═══════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion des Clients"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <Border Height="3" Width="44" CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="8" Padding="12,6"
                        Background="#F1F5F9"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNbClients"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </Grid>

            <!-- Barre de recherche avec icône -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <TextBox x:Name="TxtRecherche"
                         Style="{StaticResource ModernTextBox}"
                         Padding="42,0,12,0"
                         TextChanged="TxtRecherche_TextChanged"/>
                <TextBlock Text="🔍" FontSize="15"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="14,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Tableau + pagination -->
            <Border Grid.Row="2" Style="{StaticResource CardNoPad}">
                <StackPanel>
                    <!-- Loading -->
                    <Border x:Name="LoadingIndicator"
                            Background="#FFFBF5"
                            Padding="14"
                            Visibility="Collapsed"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chargement..." FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridClients"
                              Style="{StaticResource ModernGrid}"
                              SelectionChanged="GridClients_SelectionChanged"
                              AutoGenerateColumns="False"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom"
                                                Binding="{Binding Nom}"
                                                Width="*" MinWidth="80"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Prénom"
                                                Binding="{Binding Prenom}"
                                                Width="*" MinWidth="80"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <!-- Téléphone + bouton WhatsApp intégré -->
                            <DataGridTemplateColumn Header="Téléphone" Width="170" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Telephone}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0" FontSize="12"
                                                       Foreground="{StaticResource BodyBrush}"/>
                                            <Button Grid.Column="1"
                                                    Content="💬"
                                                    Width="28" Height="26"
                                                    FontSize="12"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Envoyer un message WhatsApp"
                                                    Click="BtnWhatsAppTableau_Click"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Telephone}" Value="">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Border Background="White"
                            Padding="14,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPaginationInfo"
                                       Grid.Column="0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnPagePrecedente"
                                        Content="← Préc."
                                        Height="30" Padding="10,0" FontSize="12"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False"
                                        Click="BtnPagePrecedente_Click"/>
                                <Button x:Name="BtnPageSuivante"
                                        Content="Suiv. →"
                                        Height="30" Padding="10,0" FontSize="12"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False"
                                        Click="BtnPageSuivante_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════ DROITE — fiche client ════════ -->
        <Border Grid.Column="2" Style="{StaticResource CardNoPad}"
                VerticalAlignment="Top">
            <StackPanel>
                <!-- En-tête panneau — dégradé Slate -->
                <Border CornerRadius="12,12,0,0" Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Fiche Client"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Informations et coordonnées"
                                   FontSize="11" Foreground="#94A3B8"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="20,18,20,20">
                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtNom"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14"
                             PreviewTextInput="TxtNom_PreviewTextInput"
                             MaxLength="200"/>

                    <TextBlock Text="Prénom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtPrenom"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14"
                             PreviewTextInput="TxtPrenom_PreviewTextInput"
                             MaxLength="200"/>

                    <!-- Téléphone + bouton WhatsApp -->
                    <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="TxtTelephone"
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button Grid.Column="2"
                                x:Name="BtnWhatsAppPanneau"
                                Height="40" Padding="12,0"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Ouvrir WhatsApp pour ce client"
                                Click="BtnWhatsAppPanneau_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="8"
                                            Background="#25D366"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💬" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="WhatsApp"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#1DAA54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,16"/>

                    <Button Style="{StaticResource BtnPrimary}"
                            Click="BtnAjouter_Click"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✚" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Ajouter ce client" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnNavy}"
                            Click="BtnModifier_Click"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏" FontSize="13" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnDanger}"
                            Click="BtnSupprimer_Click"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="13" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Vider les champs"
                            Style="{StaticResource BtnGhost}"
                            Click="BtnVider_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
