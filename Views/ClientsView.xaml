<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.ClientsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════ GAUCHE ═══════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Gestion des Clients"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border Height="3" Width="40" CornerRadius="2"
                        Background="#CC0000" HorizontalAlignment="Left"
                        Margin="0,6,0,0"/>
            </StackPanel>

            <TextBox Grid.Row="1" x:Name="TxtRecherche"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,14"
                     TextChanged="TxtRecherche_TextChanged"/>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="GridClients"
                          Style="{StaticResource ModernGrid}"
                          SelectionChanged="GridClients_SelectionChanged"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"    Binding="{Binding Nom}"    Width="*"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>

                        <!-- Téléphone + bouton WhatsApp intégré -->
                        <DataGridTemplateColumn Header="Téléphone" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Telephone}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   FontSize="12"/>

                                        <!-- 💬 bouton vert WhatsApp -->
                                        <Button Grid.Column="1"
                                                Content="💬"
                                                Width="26" Height="24"
                                                FontSize="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Envoyer un message WhatsApp"
                                                Click="BtnWhatsAppTableau_Click"
                                                Margin="0,0,2,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <!-- Désactiver si pas de téléphone -->
                                                        <DataTrigger Binding="{Binding Telephone}" Value="">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════ DROITE ═══════════════════════ -->
        <Border Grid.Column="2" Style="{StaticResource Card}"
                Padding="0" VerticalAlignment="Top">
            <StackPanel>
                <!-- En-tête noir -->
                <Border CornerRadius="10,10,0,0" Padding="20,14"
                        Background="#1A1A1A">
                    <TextBlock Text="Détails du client"
                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Border>

                <StackPanel Margin="20,16,20,20">
                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtNom" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Prénom *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtPrenom" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,12"/>

                    <!-- Téléphone + bouton WhatsApp -->
                    <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="TxtTelephone"
                                 Style="{StaticResource ModernTextBox}"/>

                        <!-- Bouton WhatsApp panneau -->
                        <Button Grid.Column="2"
                                x:Name="BtnWhatsAppPanneau"
                                Height="36" Padding="12,0,12,0"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#25D366"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTip="Ouvrir WhatsApp pour ce client"
                                Click="BtnWhatsAppPanneau_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="WhatsApp"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,16"/>

                    <Button Content="✚  Ajouter"
                            Style="{StaticResource BtnSuccess}"
                            Click="BtnAjouter_Click"
                            Margin="0,0,0,8"/>
                    <Button Content="✏  Modifier"
                            Style="{StaticResource BtnNavy}"
                            Click="BtnModifier_Click"
                            Margin="0,0,0,8"/>
                    <Button Content="🗑  Supprimer"
                            Style="{StaticResource BtnDanger}"
                            Click="BtnSupprimer_Click"
                            Margin="0,0,0,8"/>
                    <Button Content="Vider les champs"
                            Style="{StaticResource BtnGhost}"
                            Click="BtnVider_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
