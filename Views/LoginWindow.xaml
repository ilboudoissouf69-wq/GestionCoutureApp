<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GestionCoutureApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retouche Choco — Connexion"
        Height="580" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Fenêtre à coins arrondis, ombre portée -->
    <Border CornerRadius="16"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.30"
                              BlurRadius="40" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════ EN-TÊTE SOMBRE ══════════════════ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E1106" Offset="0.6"/>
                        <GradientStop Color="#451A03" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Bouton fermer coin supérieur droit -->
                    <Button Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="32" Height="32"
                            Margin="0,10,12,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnFermer_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="16"
                                        Background="{TemplateBinding Background}"
                                        Width="32" Height="32">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Logo + identité atelier, centrés -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Logo dans cadre doré arrondi -->
                        <Border Width="76" Height="76"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <Border.Background>
                                <SolidColorBrush Color="#1A1208"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#D97706"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1.5</Thickness>
                            </Border.BorderThickness>
                            <Border.Effect>
                                <DropShadowEffect Color="#D97706" Opacity="0.35"
                                                  BlurRadius="16" ShadowDepth="0"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Resources/logo_retouche_choco.png"
                                   Width="58" Height="58"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"/>
                        </Border>

                        <!-- Trait doré -->
                        <Border Height="2" Width="40" CornerRadius="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#D97706"     Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="RETOUCHE CHOCO"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Système de gestion d'atelier"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ FORMULAIRE ══════════════════ -->
            <Border Grid.Row="1"
                    CornerRadius="0,0,16,16"
                    Background="#F8FAFC">

                <StackPanel Margin="36,28,36,24"
                            VerticalAlignment="Center">

                    <!-- Identifiant -->
                    <TextBlock Text="Identifiant"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="TxtIdentifiant"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="40,0,12,0"/>
                        <!-- Icône loupe -->
                        <TextBlock Text="👤"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,24">
                        <PasswordBox x:Name="TxtPassword"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Padding="40,0,12,0"/>
                        <!-- Icône cadenas -->
                        <TextBlock Text="🔒"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Bouton connexion — ambre -->
                    <Button Content="SE CONNECTER"
                            Style="{StaticResource BtnPrimary}"
                            Height="46"
                            FontSize="14" FontWeight="Bold"
                            Click="BtnConnexion_Click"/>

                    <!-- Message d'erreur -->
                    <Border x:Name="BorderErreur"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,12,0,0"
                            Visibility="Collapsed"
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtErreur"
                                       FontSize="12"
                                       Foreground="#B91C1C"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Copyright -->
                    <TextBlock Text="© 2026  Retouche Choco — Ilassa Design"
                               FontSize="10"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
