<Page x:Class="GestionCoutureApp.Views.CommissionsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- TITRE -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Commissions des Couturiers"
                           FontSize="22"
                        FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border Height="3"
                        Width="48"
                        CornerRadius="2"
                        Background="#CC0000"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Parametres -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Parametres de calcul"
                               FontSize="14"
                            FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Commission (%)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPourcentage"
                                     Text="40"
                                     Style="{StaticResource ModernTextBox}"
                                     PreviewTextInput="TxtPourcentage_PreviewTextInput"
                                     DataObject.Pasting="TxtPourcentage_Pasting"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date debut"
                                       Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateDebut"
                                        Height="38" FontSize="13"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Date fin"
                                       Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateFin"
                                        Height="38" FontSize="13"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <!-- Prime Zéro Défaut -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Prime Zéro Défaut (FCFA)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPrimeZeroDefaut"
                                     Text="5000"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="Montant de la prime accordée au couturier ayant 0 retour sur la période (min. 5 pièces)"/>
                        </StackPanel>
                        <Button Grid.Column="8"
                                Content="Aperçu"
                                Style="{StaticResource BtnPrimary}"
                                Height="38"
                                VerticalAlignment="Bottom"
                                Click="BtnCalculer_Click"/>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Base de calcul"
                                Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbBaseCalcul"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="CmbBaseCalcul_SelectionChanged">
                            <ComboBoxItem Content="Montant réellement encaissé (recommandé)"
                                    Tag="Encaisse"/>
                            <ComboBoxItem Content="Montant total de la commande (même si non soldée)"
                                    Tag="Total"/>
                        </ComboBox>
                        <TextBlock x:Name="TxtAvertissementBase"
                                   FontSize="11"
                                Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"
                                Margin="0,6,0,0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Filtre couturier -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Filtrer par couturier (optionnel)"
                               FontSize="14"
                            FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="CmbCouturier"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="CmbCouturier_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- 5 cartes KPI : décomposition couture / matériaux / reste atelier -->
            <UniformGrid Columns="5" Margin="0,0,0,10">

                <!-- 1 — Total encaissé client -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,6,0" Background="#1A1A1A">
                    <StackPanel>
                        <TextBlock Text="TOTAL ENCAISSÉ CLIENT" FontSize="9" FontWeight="Bold" Foreground="#B0A8A4"/>
                        <TextBlock x:Name="TxtCaEncaisseTotal" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — paiements reçus (couture + matériaux)" FontSize="10" Foreground="#B0A8A4" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2 — Dont matériaux (100% atelier) -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,6,0" Background="#374151">
                    <StackPanel>
                        <TextBlock Text="DONT MATÉRIAUX" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock x:Name="TxtTotalMateriauxKpi" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — revient 100% à l'atelier" FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3 — Couture seule (base de la commission) -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,6,0" Background="#1E3A5F">
                    <StackPanel>
                        <TextBlock Text="COUTURE — BASE COMMISSION" FontSize="9" FontWeight="Bold" Foreground="#93C5FD"/>
                        <TextBlock x:Name="TxtCaTotal" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — seule cette part est commissionnée" FontSize="10" Foreground="#93C5FD" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4 — Commissions à reverser aux couturiers -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,6,0" Background="#CC0000">
                    <StackPanel>
                        <TextBlock Text="COMMISSIONS COUTURIERS" FontSize="9" FontWeight="Bold" Foreground="#FFCCCC"/>
                        <TextBlock x:Name="TxtTotalCommissions" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — à reverser aux couturiers" FontSize="10" Foreground="#FFCCCC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 5 — Ce qui reste pour l'atelier -->
                <Border CornerRadius="8" Padding="14,12" Background="#3D3530">
                    <StackPanel>
                        <TextBlock Text="BÉNÉFICE ATELIER" FontSize="9" FontWeight="Bold" Foreground="#C8B8B0"/>
                        <TextBlock x:Name="TxtResteAtelier" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — matériaux + part couture atelier" FontSize="10" Foreground="#C8B8B0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Primes qualité — bande verte si > 0 -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Background="#065F46">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎁  PRIMES QUALITÉ ZÉRO DÉFAUT : "
                               FontSize="12" FontWeight="Bold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalPrimes" Text="0 FCFA"
                               FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailPrimes" Text=""
                               FontSize="11" Foreground="#A7F3D0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Cet aperçu ne porte que sur les pièces pas encore rattachées à une commission déjà enregistrée. Une fois «Enregistrer» cliqué, ces pièces sont verrouillées et ne réapparaîtront plus dans un futur calcul de commission."
                       FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                    Margin="0,0,0,14"/>

            <!-- Detail par couturier -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Détail par Couturier — Aperçu (rien n'est encore enregistré)"
                               FontSize="14"
                            FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridCommissions"
                              Style="{StaticResource ModernGrid}"
                              Margin="0,0,0,14">
                        <DataGrid.Columns>
                            <!-- Couturier : prend tout l'espace -->
                            <DataGridTextColumn Header="Couturier"
                                    Binding="{Binding Nom}"
                                    Width="*"
                                    MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Pièces"
                                    Binding="{Binding NbCommandes}"
                                    Width="60"
                                    MinWidth="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Encaissé client"
                                    Binding="{Binding TotalEncaisseAffiche}"
                                    Width="Auto"
                                    MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Matériaux"
                                    Binding="{Binding TotalMateriauxAffiche}"
                                    Width="Auto"
                                    MinWidth="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Couture totale"
                                    Binding="{Binding CaTotalAffiche}"
                                    Width="Auto"
                                    MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Encaissé couture"
                                    Binding="{Binding CaEncaisseAffiche}"
                                    Width="Auto"
                                    MinWidth="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Base calcul"
                                    Binding="{Binding BaseAffichee}"
                                    Width="Auto"
                                    MinWidth="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Commission"
                                    Binding="{Binding CommissionAffichee}"
                                    Width="Auto"
                                    MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Qualité -->
                            <DataGridTextColumn Header="Retours"
                                    Binding="{Binding NbRetours}"
                                    Width="65"
                                    MinWidth="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Taux qualité" Width="80" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TauxQualiteAffiche}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TauxQualiteAffiche}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NbRetours}" Value="0">
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="🎁 Prime" Width="90" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="{Binding PrimeQualiteAffiche}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NbRetours}" Value="0">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PrimeQualiteAffiche}"
                                                       FontWeight="Bold" Foreground="#065F46"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Total à verser" Width="100" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#CC0000"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TotalAffiche}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Part atelier" Width="90" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResteAtelierAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#059669"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ResteAtelierAffiche}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnEnregistrer"
                            Content="✅  Enregistrer et verser ces commissions (les pièces seront verrouillées)"
                            Style="{StaticResource BtnPrimary}"
                            Height="42"
                            FontSize="13"
                            FontWeight="Bold"
                            IsEnabled="False"
                            Click="BtnEnregistrer_Click"/>
                </StackPanel>
            </Border>

            <!-- Historique -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Historique des commissions enregistrées"
                               FontSize="14"
                            FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridHistorique"
                              Style="{StaticResource ModernGrid}"
                              SelectionChanged="GridHistorique_SelectionChanged"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date calcul"
                                    Binding="{Binding DateCalculAffichee}"
                                    Width="Auto"
                                    MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Couturier"
                                    Binding="{Binding NomEmployeSnapshot}"
                                    Width="*"
                                    MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Période"
                                    Binding="{Binding PeriodeAffichee}"
                                    Width="Auto"
                                    MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Base"
                                    Binding="{Binding BaseCalcul}"
                                    Width="Auto"
                                    MinWidth="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Commission (FCFA)"
                                    Binding="{Binding MontantAffiche}"
                                    Width="Auto"
                                    MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="🎁 Prime"
                                    Binding="{Binding PrimeAffiche}"
                                    Width="Auto"
                                    MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total versé (FCFA)"
                                    Binding="{Binding TotalAffiche}"
                                    Width="Auto"
                                    MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#CC0000"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Statut"
                                    Binding="{Binding StatutAffichage}"
                                    Width="Auto"
                                    MinWidth="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Enregistré par"
                                    Binding="{Binding NomOperateur}"
                                    Width="Auto"
                                    MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMotifAnnulation"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Tag="Motif de l'annulation (obligatoire)"/>
                        <Button x:Name="BtnAnnulerCommission"
                                Grid.Column="2"
                                Content="Annuler la sélection"
                                Style="{StaticResource BtnDanger}"
                                Height="36"
                                FontSize="12"
                                Click="BtnAnnulerCommission_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtMessageHistorique"
                               FontSize="11"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
