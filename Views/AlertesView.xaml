<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.AlertesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ EN-TÊTE ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16,28,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titre -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Alertes &amp; Rendez-vous"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <Border Height="3" Width="48" CornerRadius="2"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,4"/>
                        <TextBlock Text="Suivi en temps réel de la production et des retraits clients"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Bouton Actualiser -->
                    <Button Grid.Column="1"
                            Content="🔄  Actualiser"
                            Style="{StaticResource BtnGhost}"
                            Height="36" Padding="14,0"
                            VerticalAlignment="Top"
                            Click="BtnActualiser_Click"/>
                </Grid>

                <!-- 4 badges KPI -->
                <UniformGrid Columns="4" Margin="0,0,0,2">
                    <!-- KPI Prêts -->
                    <Border CornerRadius="10" Padding="16,14"
                            Margin="0,0,6,0" Background="#15803D">
                        <StackPanel>
                            <TextBlock Text="🟢 PRÊTS À RETIRER"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#DCFCE7"/>
                            <TextBlock x:Name="TxtBadgeNbPrets" Text="0"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="0,3,0,0"/>
                            <TextBlock Text="commandes prêtes"
                                       FontSize="10" Foreground="#DCFCE7"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI Retards -->
                    <Border CornerRadius="10" Padding="16,14"
                            Margin="0,0,6,0" Background="#B91C1C">
                        <StackPanel>
                            <TextBlock Text="🔴 EN RETARD"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#FCA5A5"/>
                            <TextBlock x:Name="TxtBadgeNbRetards" Text="0"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="0,3,0,0"/>
                            <TextBlock Text="RDV dépassés"
                                       FontSize="10" Foreground="#FCA5A5"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI Aujourd'hui -->
                    <Border CornerRadius="10" Padding="16,14"
                            Margin="0,0,6,0" Background="#D97706">
                        <StackPanel>
                            <TextBlock Text="🟠 AUJOURD'HUI"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#FEF3C7"/>
                            <TextBlock x:Name="TxtBadgeNbAujourdhui" Text="0"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="0,3,0,0"/>
                            <TextBlock Text="livraisons du jour"
                                       FontSize="10" Foreground="#FEF3C7"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI À venir -->
                    <Border CornerRadius="10" Padding="16,14"
                            Background="#1D4ED8">
                        <StackPanel>
                            <TextBlock Text="⚪ 7 JOURS"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#DBEAFE"/>
                            <TextBlock x:Name="TxtBadgeNbImminentes" Text="0"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="0,3,0,0"/>
                            <TextBlock Text="RDV à venir"
                                       FontSize="10" Foreground="#DBEAFE"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ══ CONTENU SCROLLABLE ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,20,28,28">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════
                     SECTION 1 — 🟢 PRÊTES À RETIRER
                ═══════════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#BBF7D0" BorderThickness="1"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- En-tête vert -->
                        <Border CornerRadius="12,12,0,0" Padding="20,14"
                                Background="#15803D">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🟢  Prêtes à Retirer — Commandes Terminées"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="Vêtements terminés · Notifier le client pour le retrait"
                                               FontSize="11" Foreground="#86EFAC"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#166534"
                                        CornerRadius="6" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💬 WhatsApp — commande prête"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Liste -->
                        <ItemsControl x:Name="ListePrets">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0FDF4" BorderThickness="0,0,0,1"
                                            Background="White" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Info principale -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NomClient}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" · " FontSize="12"
                                                               Foreground="#9CA3AF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Telephone}"
                                                               FontSize="11" Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Badge stagnant -->
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Margin="8,0,0,0" Background="#FEF9C3"
                                                            Visibility="{Binding EstStagnant,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="⚠️ Colis stagnant"
                                                                   FontSize="10" Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailPieces}"
                                                           FontSize="11" Foreground="#374151"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Date -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0">
                                                <TextBlock Text="{Binding DateCourte}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#059669"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding HeureRdv}"
                                                           FontSize="11" Foreground="#6B7280"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Boutons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding LibelleBoutonWhatsApp}"
                                                        Height="32" Padding="12,0"
                                                        Margin="0,0,8,0"
                                                        FontSize="11" FontWeight="SemiBold"
                                                        Foreground="White" Background="#25D366"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnWhatsApp_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Content="Détails"
                                                        Height="32" Padding="12,0"
                                                        FontSize="11"
                                                        Foreground="#1E40AF" Background="#EFF6FF"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnVoirDetails_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message vide -->
                        <TextBlock x:Name="TxtZeroPrets"
                                   Text="✅  Aucune commande prête à retirer pour le moment."
                                   FontSize="12" FontStyle="Italic" Foreground="#059669"
                                   Margin="20,12,20,16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     SECTION 2 — 🔴 COMMANDES EN RETARD
                ═══════════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#FECACA" BorderThickness="1"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- En-tête rouge -->
                        <Border CornerRadius="12,12,0,0" Padding="20,14"
                                Background="#B91C1C">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔴  Commandes en Retard — RDV Dépassé"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="Vêtements non terminés dont le RDV est passé · Informer le client"
                                               FontSize="11" Foreground="#FCA5A5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#991B1B"
                                        CornerRadius="6" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💬 WhatsApp — informer client"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Liste -->
                        <ItemsControl x:Name="ListeRetards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FEF2F2" BorderThickness="0,0,0,1"
                                            Background="#FFF5F5" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔴 " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NomClient}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" · " FontSize="12"
                                                               Foreground="#9CA3AF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Telephone}"
                                                               FontSize="11" Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Margin="8,0,0,0" Background="#FEF9C3"
                                                            Visibility="{Binding EstStagnant,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="⚠️ Colis stagnant"
                                                                   FontSize="10" Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailPieces}"
                                                           FontSize="11" Foreground="#374151"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Date (rouge car retard) -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0">
                                                <TextBlock Text="{Binding DateCourte}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#B91C1C"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding HeureRdv}"
                                                           FontSize="11" Foreground="#6B7280"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Boutons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding LibelleBoutonWhatsApp}"
                                                        Height="32" Padding="12,0"
                                                        Margin="0,0,8,0"
                                                        FontSize="11" FontWeight="SemiBold"
                                                        Foreground="White" Background="#EF4444"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnWhatsApp_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Content="Voir Commande"
                                                        Height="32" Padding="12,0"
                                                        FontSize="11"
                                                        Foreground="#1E40AF" Background="#EFF6FF"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnVoirDetails_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message vide -->
                        <TextBlock x:Name="TxtZeroRetard"
                                   Text="✅  Aucune commande en retard."
                                   FontSize="12" FontStyle="Italic" Foreground="#059669"
                                   Margin="20,12,20,16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     SECTION 3 — 🟠 LIVRAISONS PRÉVUES AUJOURD'HUI
                ═══════════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#FED7AA" BorderThickness="1"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- En-tête orange -->
                        <Border CornerRadius="12,12,0,0" Padding="20,14"
                                Background="#D97706">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🟠  Livraisons Prévues Aujourd'hui"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="RDV fixés ce jour · Rappeler le client si besoin"
                                               FontSize="11" Foreground="#FEF3C7"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#B45309"
                                        CornerRadius="6" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💬 WhatsApp — rappel RDV"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Liste -->
                        <ItemsControl x:Name="ListeAujourdhui">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFFBEB" BorderThickness="0,0,0,1"
                                            Background="#FFFBEB" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟠 " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NomClient}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" · " FontSize="12"
                                                               Foreground="#9CA3AF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Telephone}"
                                                               FontSize="11" Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Margin="8,0,0,0" Background="#FEF9C3"
                                                            Visibility="{Binding EstStagnant,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="⚠️ Colis stagnant"
                                                                   FontSize="10" Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailPieces}"
                                                           FontSize="11" Foreground="#374151"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Heure (orange) -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0">
                                                <TextBlock Text="{Binding DateCourte}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#D97706"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding HeureRdv}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#D97706"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Boutons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding LibelleBoutonWhatsApp}"
                                                        Height="32" Padding="12,0"
                                                        Margin="0,0,8,0"
                                                        FontSize="11" FontWeight="SemiBold"
                                                        Foreground="White" Background="#D97706"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnWhatsApp_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Content="Voir Commande"
                                                        Height="32" Padding="12,0"
                                                        FontSize="11"
                                                        Foreground="#1E40AF" Background="#EFF6FF"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnVoirDetails_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message vide -->
                        <TextBlock x:Name="TxtZeroAujourdhui"
                                   Text="Aucune livraison prévue aujourd'hui."
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="20,12,20,16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     SECTION 4 — ⚪ À VENIR SOUS 7 JOURS
                ═══════════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- En-tête bleu/gris -->
                        <Border CornerRadius="12,12,0,0" Padding="20,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0F172A" Offset="0"/>
                                    <GradientStop Color="#1E293B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚪  À Venir sous 7 Jours"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="RDV dans les 7 prochains jours · Anticiper la production"
                                               FontSize="11" Foreground="#94A3B8"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1E3A5F"
                                        CornerRadius="6" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="📅 Voir commande uniquement"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#93C5FD"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Liste -->
                        <ItemsControl x:Name="ListeImminentes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                                            Background="White" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NomClient}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" · " FontSize="12"
                                                               Foreground="#9CA3AF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Telephone}"
                                                               FontSize="11" Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Margin="8,0,0,0" Background="#FEF9C3"
                                                            Visibility="{Binding EstStagnant,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="⚠️ Colis stagnant"
                                                                   FontSize="10" Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailPieces}"
                                                           FontSize="11" Foreground="#374151"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Date -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0">
                                                <TextBlock Text="{Binding DateCourte}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#374151"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding HeureRdv}"
                                                           FontSize="11" Foreground="#6B7280"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Bouton Voir Commande seul -->
                                            <Button Grid.Column="2"
                                                    Content="Voir Commande"
                                                    Height="32" Padding="12,0"
                                                    FontSize="11"
                                                    Foreground="#1E40AF" Background="#EFF6FF"
                                                    BorderThickness="0" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="BtnVoirDetails_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}"
                                                                Height="{TemplateBinding Height}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message vide -->
                        <TextBlock x:Name="TxtZeroImminentes"
                                   Text="Aucun rendez-vous prévu dans les 7 prochains jours."
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="20,12,20,16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ MODAL DÉTAILS COMMANDE ════════════════════════════════════ -->
        <Grid x:Name="ModalDetailsCommande"
              Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed">
            <Border Background="White" CornerRadius="16"
                    Width="560" MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête modal -->
                    <Border Grid.Row="0" CornerRadius="16,16,0,0"
                            Padding="24,18" Background="#1E293B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Détails de la Commande"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtModalSoustitre"
                                           FontSize="12" Foreground="#94A3B8"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Width="32" Height="32"
                                    FontSize="14" Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Click="BtnFermerModal_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps modal -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24,16">
                        <StackPanel>
                            <!-- Client -->
                            <Border Background="#F8FAFC" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CLIENT"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtModalNomClient"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#111827"/>
                                    <TextBlock x:Name="TxtModalTelephone"
                                               FontSize="12" Foreground="#6B7280"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Infos commande -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F0FDF4"
                                        CornerRadius="8" Padding="16,12"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ÉCHÉANCE"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtModalEcheance"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="#059669"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FFF7ED"
                                        CornerRadius="8" Padding="16,12"
                                        Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="RESTE À PAYER"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtModalResteAPayer"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="#D97706"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Pièces -->
                            <TextBlock Text="PIÈCES"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7280" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ListeModalPieces">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="#F3F4F6"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TypeVetement}"
                                                           FontSize="13" Foreground="#111827"
                                                           VerticalAlignment="Center"/>
                                                <!-- Badge statut coloré -->
                                                <Border Grid.Column="1"
                                                        CornerRadius="4" Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Statut}" Value="À faire">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Statut}" Value="Terminée">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Statut}" Value="Livrée">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Statut}"
                                                               FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="À faire">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="Terminée">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Statut}" Value="Livrée">
                                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pied modal -->
                    <Border Grid.Row="2" BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16"
                            Padding="24,14">
                        <Button Content="Fermer"
                                HorizontalAlignment="Right"
                                Height="36" Padding="24,0"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White" Background="#374151"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnFermerModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}"
                                            Height="{TemplateBinding Height}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
