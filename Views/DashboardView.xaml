<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 BANNIÈRE D'ACCUEIL — dégradé sombre Slate → Amber-950
            ══════════════════════════════════════════════════════════ -->
            <Border MinHeight="110" Padding="32,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1C1108" Offset="0.55"/>
                        <GradientStop Color="#451A03" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Texte de bienvenue -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                Margin="0,24,0,24">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtBienvenue"
                                       Text="Bonjour, Boss 👋"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Atelier Retouche Choco  ·  "
                                       FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtDateDuJour"
                                       FontSize="13" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bouton action rapide -->
                    <Button Grid.Column="1"
                            x:Name="BtnNouvelleCommande"
                            VerticalAlignment="Center"
                            Height="42" Padding="20,0"
                            Cursor="Hand"
                            Click="BtnNouvelleCommande_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        Background="#D97706">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Nouvelle Commande"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 CONTENU PRINCIPAL
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Margin="28,24,28,28">

                <!-- ── 4 CARTES KPI ── -->
                <UniformGrid Columns="4" Margin="0,0,0,24">

                    <!-- KPI 1 : CA Encaissé -->
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Icône pastille verte -->
                            <Border Grid.Row="0"
                                    Width="44" Height="44" CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <Border.Background>
                                    <SolidColorBrush Color="#DCFCE7"/>
                                </Border.Background>
                                <TextBlock Text="💰" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="TxtCaJour"
                                           Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="FCFA"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="CA Encaissé du jour"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- KPI 2 : Commandes en atelier -->
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Width="44" Height="44" CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <Border.Background>
                                    <SolidColorBrush Color="#DBEAFE"/>
                                </Border.Background>
                                <TextBlock Text="⏳" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="TxtCommandesEnCours"
                                           Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="commandes"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="En cours de confection"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- KPI 3 : Retards -->
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Width="44" Height="44" CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <Border.Background>
                                    <SolidColorBrush Color="#FEE2E2"/>
                                </Border.Background>
                                <TextBlock Text="⚠️" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="TxtRetards"
                                           Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#B91C1C"/>
                                <TextBlock Text="retards"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="Délais de livraison dépassés"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- KPI 4 : Clients (remplace Dépenses — géré par le code-behind) -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Width="44" Height="44" CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <Border.Background>
                                    <SolidColorBrush Color="#FEF3C7"/>
                                </Border.Background>
                                <TextBlock Text="👥" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="TxtTotalClients"
                                           Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="clients"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="Total enregistrés"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                </UniformGrid>

                <!-- ── SECTION CENTRALE : Graphique + Performance couturiers ── -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Graphique revenus 7 jours -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Revenus des 7 derniers jours"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Encaissements (FCFA)"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Légende -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="3"
                                            Background="#D97706" Margin="0,0,6,0"/>
                                    <TextBlock Text="Encaissé"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <!-- Zone graphique — remplie par code-behind -->
                            <Grid x:Name="GridGraphique" Height="200"/>
                        </StackPanel>
                    </Border>

                    <!-- Performance couturiers -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Performance Couturiers"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Commandes actives par couturier"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,14"/>
                            <DataGrid x:Name="GridCouturiers"
                                      Style="{StaticResource ModernGrid}"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Couturier"
                                                        Binding="{Binding Nom}"
                                                        Width="*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Cmd"
                                                        Binding="{Binding NbCommandes}"
                                                        Width="44"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="✓ Term."
                                                        Binding="{Binding NbTerminees}"
                                                        Width="56"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="⚠ Ret."
                                                        Binding="{Binding NbRetards}"
                                                        Width="52"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Badge pièces à attribuer -->
                            <Border CornerRadius="8" Padding="12,8"
                                    Margin="0,14,0,0"
                                    Background="#FEF3C7"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📌" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontSize="12" Foreground="#92400E"
                                               VerticalAlignment="Center">
                                        <Run Text="Pièces sans couturier : "/>
                                        <Run x:Name="TxtAAttribuer" Text="0"
                                             FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── DERNIÈRES COMMANDES ── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dernières Commandes"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Les 5 commandes les plus récentes"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Trait décoratif ambre -->
                            <Border Grid.Column="1"
                                    Width="4" CornerRadius="2"
                                    VerticalAlignment="Stretch"
                                    Background="#D97706"
                                    Margin="0,2,0,2"/>
                        </Grid>

                        <DataGrid x:Name="GridDernieresCommandes"
                                  Style="{StaticResource ModernGrid}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Client"
                                                    Binding="{Binding Client}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Type de vêtement"
                                                    Binding="{Binding Type}"
                                                    Width="160"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Montant (FCFA)"
                                                    Binding="{Binding Montant}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Statut"
                                                    Binding="{Binding Statut}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Livraison"
                                                    Binding="{Binding DateFin}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
