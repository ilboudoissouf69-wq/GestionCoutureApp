<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <!--
        DASHBOARD V2 — maquette de référence.
        Piège WPF : pas de StackPanel.Spacing (les espacements sont des Margin
        sur les enfants) ; la clé locale « DashBorderBrush » ne s'appelle pas
        « BorderColor » car App.xaml définit déjà une Color globale de ce nom.
    -->

    <Page.Resources>
        <!-- Pinceaux locaux -->
        <SolidColorBrush x:Key="DashBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryAmber"    Color="#D97706"/>
        <SolidColorBrush x:Key="SlateDark"       Color="#0F172A"/>
        <SolidColorBrush x:Key="SlateMuted"      Color="#64748B"/>

        <!-- Carte KPI de la maquette : CornerRadius 14, Padding 18, ombre douce -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="18"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DashBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2"
                                      Opacity="0.04" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- ══════════════════════════════════════════════════════════
                 BANNIÈRE D'ACCUEIL — dégradé Slate-900 → Slate-800 → Amber-950
            ══════════════════════════════════════════════════════════ -->
            <Border CornerRadius="18" Padding="26,22" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E293B" Offset="0.55"/>
                        <GradientStop Color="#451A03" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Badge rôle + titre + sous-titre daté -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="#33F59E0B"
                                BorderBrush="#66F59E0B" BorderThickness="1"
                                CornerRadius="8" Padding="10,4"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtRoleBadge"
                                       Text="RÔLE : —"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#FBBF24"/>
                        </Border>
                        <TextBlock x:Name="TxtBienvenueNom"
                                   Text="Bonjour, 👋"
                                   FontSize="24" FontWeight="Black"
                                   Foreground="White" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Atelier Retouche Choco  ·  "
                                       FontSize="13" Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDateDuJour"
                                       FontSize="13" Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bouton action rapide (x:Name + Click conservés, hover #B45309) -->
                    <Button Grid.Column="1"
                            x:Name="BtnNouvelleCommande"
                            VerticalAlignment="Center"
                            Height="42" Padding="20,0"
                            Cursor="Hand"
                            Click="BtnNouvelleCommande_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}"
                                        Background="#D97706">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Nouvelle Commande"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 4 CARTES KPI
            ══════════════════════════════════════════════════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,20">

                <!-- KPI 1 : Encaissé ce mois (+ ligne secondaire « Aujourd'hui ») -->
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                    Background="#ECFDF5" Margin="0,0,10,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="💰" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="ENCAISSÉ CE MOIS"
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource SlateMuted}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock FontSize="20" FontWeight="Black"
                                   Foreground="{StaticResource SlateDark}">
                            <Run x:Name="TxtKpiEncaisseMois" Text="0"/>
                            <Run Text=" FCFA" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource SlateMuted}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryAmber}" Margin="0,4,0,0">
                            <Run Text="Aujourd'hui : "/>
                            <Run x:Name="TxtCaJour" Text="0"/>
                            <Run Text=" FCFA"/>
                        </TextBlock>
                        <TextBlock Text="Paiements encaissés non annulés"
                                   FontSize="10"
                                   Foreground="{StaticResource SlateMuted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2 : Commandes en cours (non livrées) -->
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                    Background="#EFF6FF" Margin="0,0,10,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="⏳" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="COMMANDES EN COURS"
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource SlateMuted}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock FontSize="20" FontWeight="Black"
                                   Foreground="{StaticResource SlateDark}">
                            <Run x:Name="TxtKpiCommandesEnCours" Text="0"/>
                            <Run Text=" commandes" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource SlateMuted}"/>
                        </TextBlock>
                        <TextBlock Text="Non livrées (en atelier ou prêtes)"
                                   FontSize="10"
                                   Foreground="{StaticResource SlateMuted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3 : Retards -->
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                    Background="#FFF1F2" Margin="0,0,10,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="⚠️" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="RETARDS"
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource SlateMuted}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock FontSize="20" FontWeight="Black" Foreground="#B91C1C">
                            <Run x:Name="TxtKpiRetards" Text="0"/>
                            <Run Text=" retards" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource SlateMuted}"/>
                        </TextBlock>
                        <TextBlock Text="Échéances de livraison dépassées"
                                   FontSize="10"
                                   Foreground="{StaticResource SlateMuted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4 : Dépenses du mois (Boss) OU Clients enregistrés (Secrétaire) -->
                <Grid>
                    <Border x:Name="CarteDepensesMois"
                            Style="{StaticResource KpiCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#FEF3C7" Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="💸" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="DÉPENSES CE MOIS"
                                           FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{StaticResource SlateMuted}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="20" FontWeight="Black"
                                       Foreground="{StaticResource SlateDark}">
                                <Run x:Name="TxtKpiDepensesMois" Text="0"/>
                                <Run Text=" FCFA" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{StaticResource SlateMuted}"/>
                            </TextBlock>
                            <TextBlock Text="Total du mois en cours"
                                       FontSize="10"
                                       Foreground="{StaticResource SlateMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarteClients"
                            Style="{StaticResource KpiCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#FEF3C7" Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="👥" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="CLIENTS ENREGISTRÉS"
                                           FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{StaticResource SlateMuted}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="20" FontWeight="Black"
                                       Foreground="{StaticResource SlateDark}">
                                <Run x:Name="TxtTotalClients" Text="0"/>
                                <Run Text=" clients" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{StaticResource SlateMuted}"/>
                            </TextBlock>
                            <TextBlock Text="Total enregistrés"
                                       FontSize="10"
                                       Foreground="{StaticResource SlateMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════════
                 ÉCHÉANCES (2/3) + CHARGE DES COUTURIERS (1/3)
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Prochaines Échéances de Livraison ── -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20"
                        BorderBrush="{StaticResource DashBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prochaines Échéances de Livraison"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource SlateDark}"/>
                                <TextBlock Text="Retards, livraisons du jour et rendez-vous à venir"
                                           FontSize="11"
                                           Foreground="{StaticResource SlateMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Voir toutes les alertes  →"
                                    Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryAmber}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,2" VerticalAlignment="Bottom"
                                    Click="BtnVoirAlertes_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ItemsEcheancesUrgentes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10"
                                            BorderBrush="{StaticResource DashBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding NomClient}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource SlateDark}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" · " FontSize="12"
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Telephone}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SlateMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4" Padding="6,1"
                                                            Margin="8,0,0,0" Background="#FEE2E2"
                                                            Visibility="{Binding EstEnRetard,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="En retard"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="#B91C1C"/>
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="6,1"
                                                            Margin="4,0,0,0" Background="#FEF3C7"
                                                            Visibility="{Binding EstAujourdhui,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Aujourd'hui"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailPieces}"
                                                           FontSize="11" Foreground="#334155"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DateEcheance, StringFormat='dd/MM/yy HH:mm'}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SlateDark}"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0"/>
                                            <!-- 💬 Prêt : visible uniquement si une pièce est terminée -->
                                            <Button Grid.Column="2"
                                                    Content="💬 Prêt"
                                                    Height="28" Padding="10,0" Margin="10,0,0,0"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="White" Background="#25D366"
                                                    BorderThickness="0" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding VisibilitePretWhatsApp}"
                                                    Tag="{Binding}"
                                                    Click="BtnWhatsAppPret_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtZeroEcheances"
                                   Text="✅ Aucune échéance urgente — tout est sous contrôle."
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource SlateMuted}"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ── Charge des Couturiers ── -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20"
                        BorderBrush="{StaticResource DashBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Charge des Couturiers"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource SlateDark}"/>
                                <TextBlock Text="Pièces actives par couturier"
                                           FontSize="11"
                                           Foreground="{StaticResource SlateMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Atelier  →"
                                    Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryAmber}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,2" VerticalAlignment="Bottom"
                                    Click="BtnVoirAtelier_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ItemsChargeCouturiers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10"
                                            BorderBrush="{StaticResource DashBorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NomComplet}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SlateDark}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TotalPieces}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryAmber}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Jauge 3 segments : prêtes (vert) / en cours (ambre) / reste (gris) -->
                                            <Grid Height="6" Margin="0,8,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding LargeurTerminees}"/>
                                                    <ColumnDefinition Width="{Binding LargeurEnCours}"/>
                                                    <ColumnDefinition Width="{Binding LargeurReste}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#22C55E"
                                                        CornerRadius="3,0,0,3" Margin="0,0,1,0"/>
                                                <Border Grid.Column="1" Background="#F59E0B"
                                                        Margin="0,0,1,0"/>
                                                <Border Grid.Column="2" Background="#CBD5E1"
                                                        CornerRadius="0,3,3,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding RepartitionAffiche}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SlateMuted}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding LigneRetardsCa}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SlateMuted}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Badge pièces sans couturier (réintégré de l'ancien écran) -->
                        <Border CornerRadius="8" Padding="12,8" Margin="0,6,0,0"
                                Background="#FEF3C7"
                                BorderBrush="#FDE68A"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📌" FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Foreground="#92400E"
                                           VerticalAlignment="Center">
                                    <Run Text="Pièces sans couturier : "/>
                                    <Run x:Name="TxtAAttribuer" Text="0"
                                         FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 GRAPHIQUE — Revenus des 7 derniers jours (pleine largeur)
            ══════════════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="16" Padding="20"
                    BorderBrush="{StaticResource DashBorderBrush}" BorderThickness="1"
                    Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Revenus des 7 derniers jours"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource SlateDark}"/>
                            <TextBlock Text="Encaissements (FCFA)"
                                       FontSize="11"
                                       Foreground="{StaticResource SlateMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Légende -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="3"
                                    Background="{StaticResource PrimaryAmber}" Margin="0,0,6,0"/>
                            <TextBlock Text="Encaissé"
                                       FontSize="11"
                                       Foreground="{StaticResource SlateMuted}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Zone graphique — remplie par code-behind -->
                    <Grid x:Name="GridGraphique" Height="200"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 DERNIÈRES COMMANDES (pleine largeur)
            ══════════════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="16" Padding="20"
                    BorderBrush="{StaticResource DashBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dernières Commandes"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource SlateDark}"/>
                            <TextBlock Text="Les 5 commandes les plus récentes"
                                       FontSize="11"
                                       Foreground="{StaticResource SlateMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Trait décoratif ambre -->
                        <Border Grid.Column="1"
                                Width="4" CornerRadius="2"
                                VerticalAlignment="Stretch"
                                Background="{StaticResource PrimaryAmber}"
                                Margin="0,2,0,2"/>
                    </Grid>

                    <DataGrid x:Name="GridDernieresCommandes"
                              Style="{StaticResource ModernGrid}"
                              MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client"
                                                Binding="{Binding Client}"
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Type de vêtement"
                                                Binding="{Binding Type}"
                                                Width="160"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Montant (FCFA)"
                                                Binding="{Binding Montant}"
                                                Width="130"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Statut}"
                                                Width="120"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Livraison"
                                                Binding="{Binding DateFin}"
                                                Width="110"
                                                ElementStyle="{StaticResource DataGridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
