<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.PaiementsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContenuPrincipal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- En-tête -->
                <RowDefinition Height="Auto"/>  <!-- Barre recherche + filtres -->
                <RowDefinition Height="*"/>     <!-- Tableau -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 EN-TÊTE
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="32,28,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre + sous-titre -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icône carré orange -->
                        <Border Width="32" Height="32" CornerRadius="6"
                                Background="#F97316"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Paiements &amp; Encaissements"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Émission de reçus uniques, acomptes, soldes et traçabilité comptable"
                               FontSize="12" Foreground="#94A3B8"
                               Margin="44,5,0,0"/>
                </StackPanel>

                <!-- Bouton Encaisser un Paiement — orange -->
                <Button x:Name="BtnOuvrirModalEncaissement"
                        Grid.Column="1"
                        Height="40" Padding="20,0"
                        FontSize="13" FontWeight="Bold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="BtnOuvrirModalEncaissement_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"      Value="#F97316"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EA6C0A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Encaisser un Paiement"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 BARRE RECHERCHE + FILTRES
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="32,0,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Champ recherche -->
                <Border Grid.Column="0"
                        CornerRadius="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icône loupe -->
                        <TextBlock Grid.Column="0"
                                   Text="🔍" FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   Foreground="#94A3B8"/>

                        <!-- Superposition TextBox + placeholder -->
                        <Grid Grid.Column="1">
                            <!-- Placeholder visible uniquement quand vide ET sans focus -->
                            <TextBlock x:Name="TxtPlaceholderRecherche"
                                       Text="Rechercher par n° reçu, client ou opérateur..."
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>

                            <TextBox x:Name="TxtRecherche"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     Foreground="#334155"
                                     VerticalContentAlignment="Center"
                                     Padding="0,10,10,10"
                                     TextChanged="TxtRecherche_TextChanged"
                                     GotFocus="TxtRecherche_GotFocus"
                                     LostFocus="TxtRecherche_LostFocus"/>
                        </Grid><!-- fin Grid superposition -->
                    </Grid><!-- fin Grid loupe+champ -->
                </Border>

                <!-- Filtres : "Afficher :" + pills -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Afficher :"
                               FontSize="13" Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- Pill Valides -->
                    <RadioButton x:Name="RbValides"
                                 IsChecked="True"
                                 Checked="FiltreStatut_Changed">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd"
                                                    CornerRadius="6"
                                                    Padding="14,7"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#E2E8F0"
                                                    Cursor="Hand">
                                                <TextBlock x:Name="Txt"
                                                           Text="Valides"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd"  Property="Background"   Value="#F97316"/>
                                                    <Setter TargetName="Bd"  Property="BorderBrush"  Value="#F97316"/>
                                                    <Setter TargetName="Txt" Property="Foreground"   Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#F97316"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Pill Annulés -->
                    <RadioButton x:Name="RbAnnules"
                                 Margin="6,0,0,0"
                                 Checked="FiltreStatut_Changed">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd"
                                                    CornerRadius="6"
                                                    Padding="14,7"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#E2E8F0"
                                                    Cursor="Hand">
                                                <TextBlock x:Name="Txt"
                                                           Text="Annulés"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd"  Property="Background"  Value="#F97316"/>
                                                    <Setter TargetName="Bd"  Property="BorderBrush" Value="#F97316"/>
                                                    <Setter TargetName="Txt" Property="Foreground"  Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#F97316"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <!-- Pill Tous -->
                    <RadioButton x:Name="RbTous"
                                 Margin="6,0,0,0"
                                 Checked="FiltreStatut_Changed">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd"
                                                    CornerRadius="6"
                                                    Padding="14,7"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#E2E8F0"
                                                    Cursor="Hand">
                                                <TextBlock x:Name="Txt"
                                                           Text="Tous"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd"  Property="Background"  Value="#F97316"/>
                                                    <Setter TargetName="Bd"  Property="BorderBrush" Value="#F97316"/>
                                                    <Setter TargetName="Txt" Property="Foreground"  Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#F97316"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 ZONE TABLEAU (séparateur + DataGrid + pagination)
            ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Loading -->
                    <RowDefinition Height="*"/>     <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>  <!-- Pagination -->
                </Grid.RowDefinitions>

                <!-- Loading -->
                <Border x:Name="LoadingIndicator"
                        Grid.Row="0"
                        Padding="0,8"
                        Visibility="Collapsed"
                        Background="White">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Chargement…" FontSize="12"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid pleine largeur, style maquette -->
                <DataGrid x:Name="GridPaiements"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          BorderThickness="0"
                          Background="White"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Margin="0,0,0,0">

                    <!-- Style des cellules header -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"    Value="White"/>
                            <Setter Property="Foreground"    Value="#64748B"/>
                            <Setter Property="FontSize"      Value="11"/>
                            <Setter Property="FontWeight"    Value="Bold"/>
                            <Setter Property="Padding"       Value="16,12"/>
                            <Setter Property="BorderBrush"   Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Style des lignes -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush"     Value="#F1F5F9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background"      Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Style des cellules -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"         Value="0"/>
                            <Setter Property="Background"      Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <!-- N° REÇU & DATE -->
                        <DataGridTemplateColumn Width="190" MinWidth="160"
                                                SortMemberPath="RecuNumero">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="N° REÇU &amp; DATE" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748B"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16,10,8,10">
                                        <TextBlock Text="{Binding RecuNumero}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E3A5F"/>
                                        <TextBlock Text="{Binding DatePaiement, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- COMMANDE & CLIENT -->
                        <DataGridTemplateColumn Width="*" MinWidth="180"
                                                SortMemberPath="IdCommande">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="COMMANDE &amp; CLIENT" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748B"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,10,8,10">
                                        <!-- CMD #4 — Prénom Nom -->
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E3A5F">
                                            <Run Text="CMD #"/>
                                            <Run Text="{Binding IdCommande}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Commande.Client.Prenom}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Commande.Client.Nom}"/>
                                        </TextBlock>
                                        <!-- Résumé pièces (ex: Chemise) -->
                                        <TextBlock Text="{Binding Commande.TypeVetementAffiche}"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MODE -->
                        <DataGridTemplateColumn Header="MODE"
                                                Width="130" MinWidth="100"
                                                SortMemberPath="ModePaiement">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="8,8,8,8"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"   Value="#F1F5F9"/>
                                                <Setter Property="BorderBrush"  Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#334155">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding ModePaiement}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- OPÉRATEUR -->
                        <DataGridTemplateColumn Header="OPÉRATEUR"
                                                Width="150" MinWidth="120"
                                                SortMemberPath="NomOperateur">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NomOperateur}"
                                               FontSize="13" Foreground="#334155"
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MONTANT ENCAISSÉ -->
                        <DataGridTemplateColumn Header="MONTANT ENCAISSÉ"
                                                Width="140" MinWidth="120"
                                                SortMemberPath="MontantPaye">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MontantPaye, StringFormat={}{0:N0} FCFA}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#0F172A"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- STATUT -->
                        <DataGridTemplateColumn Header="STATUT"
                                                Width="90" MinWidth="80"
                                                SortMemberPath="EstAnnule">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="8,8,8,8"
                                            CornerRadius="5"
                                            Padding="10,4"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="VALIDE"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="Text"       Value="ANNULÉ"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="ACTIONS"
                                                Width="90" MinWidth="80"
                                                CanUserSort="False"
                                                CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="4,0">

                                        <!-- 🖨️ Imprimer reçu -->
                                        <Button Tag="{Binding}"
                                                Width="32" Height="32"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"
                                                ToolTip="Imprimer le reçu"
                                                Click="BtnLigneRecu_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background"       Value="Transparent"/>
                                                    <Setter Property="BorderThickness"  Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Width="32" Height="32">
                                                                    <TextBlock Text="🖨" FontSize="15"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="Opacity"   Value="0.3"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 🚫 Annuler (Boss + non annulé) -->
                                        <Button Tag="{Binding}"
                                                Width="32" Height="32"
                                                Cursor="Hand"
                                                ToolTip="Annuler ce paiement"
                                                Click="BtnLigneAnnuler_Click"
                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=Page},
                                                                     Path=EstBoss,
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background"       Value="Transparent"/>
                                                    <Setter Property="BorderThickness"  Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Width="32" Height="32">
                                                                    <TextBlock Text="🚫" FontSize="15"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="Opacity"   Value="0.2"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <Border Grid.Row="2"
                        Padding="32,12"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPaginationInfo"
                                   Grid.Column="0"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnPagePrecedente"
                                    Height="34" Padding="14,0" FontSize="12"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="BtnPagePrecedente_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"     Value="White"/>
                                        <Setter Property="Foreground"     Value="#334155"/>
                                        <Setter Property="BorderBrush"    Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="← Précédent" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnPageSuivante"
                                    Height="34" Padding="14,0" FontSize="12"
                                    IsEnabled="False"
                                    Click="BtnPageSuivante_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"     Value="White"/>
                                        <Setter Property="Foreground"     Value="#334155"/>
                                        <Setter Property="BorderBrush"    Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Suivant →" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid><!-- fin Grid Row 2 -->

        </Grid><!-- fin ContenuPrincipal -->


        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY MODAL — ENCAISSEMENT
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayEncaissement"
              Visibility="Collapsed"
              Panel.ZIndex="99">

            <Border Background="#80000000"/>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="540"
                    MaxHeight="680"
                    CornerRadius="14"
                    Background="White"
                    Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête modale -->
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="💳  Encaisser un paiement"
                                           FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Espèces · Mobile Money · Virement · Chèque"
                                           FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Width="28" Height="28" FontSize="13" FontWeight="Bold"
                                    Cursor="Hand" ToolTip="Fermer"
                                    Click="BtnFermerModalEncaissement_Click" VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="Transparent"/>
                                        <Setter Property="Foreground"      Value="#94A3B8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1E3A5F"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,4">

                            <TextBlock Text="Commande *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCommandesNonSoldees"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="DisplayText"
                                      Margin="0,0,0,14"
                                      SelectionChanged="CmbCommande_SelectionChanged"/>

                            <!-- Carte récap -->
                            <Border CornerRadius="10" Padding="16,14" Margin="0,0,0,16"
                                    Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtClientNom" Text="Client : —"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Reste à payer"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtResteExact" Grid.Column="1"
                                                   Text="— FCFA" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                    </Grid>
                                    <Border CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                                            Background="#FEF9EC" BorderBrush="#FCD34D" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Reste après encaissement"
                                                       FontSize="11" Foreground="#92400E"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtResteApres" Grid.Column="1"
                                                       Text="— FCFA" FontSize="13" FontWeight="Bold"
                                                       Foreground="#92400E"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Montant du paiement (FCFA) *"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMontantPaiement"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,14"
                                     PreviewTextInput="TxtMontant_PreviewTextInput"
                                     TextChanged="TxtMontantPaiement_TextChanged"/>

                            <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbModePaiement"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,4"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="💵  Espèces"/>
                                <ComboBoxItem Content="📱  Mobile Money (Orange/Moov/Wave)"/>
                                <ComboBoxItem Content="🏦  Virement"/>
                                <ComboBoxItem Content="📄  Chèque"/>
                            </ComboBox>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pied -->
                    <Border Grid.Row="2" Padding="24,14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Height="38" Padding="18,0" FontSize="13"
                                    Margin="0,0,10,0" Style="{StaticResource BtnGhost}"
                                    Click="BtnFermerModalEncaissement_Click"/>
                            <Button x:Name="BtnValiderPaiement"
                                    Height="38" Padding="18,0" FontSize="13" FontWeight="Bold"
                                    Click="BtnValiderPaiement_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="#16A34A"/>
                                        <Setter Property="Foreground"      Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15803D"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳" FontSize="14" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Valider le paiement" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY MODAL — ANNULATION (Boss) — en-tête rouge
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayAnnulation"
              Visibility="Collapsed"
              Panel.ZIndex="99">

            <Border Background="#80000000"/>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    CornerRadius="14"
                    Background="White"
                    Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête rouge -->
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7F1D1D" Offset="0"/>
                                <GradientStop Color="#991B1B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🚫  Annuler un paiement"
                                           FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Action irréversible — Boss uniquement"
                                           FontSize="11" Foreground="#FCA5A5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Width="28" Height="28" FontSize="13" FontWeight="Bold"
                                    Cursor="Hand" ToolTip="Fermer"
                                    Click="BtnFermerModalAnnulation_Click" VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="Transparent"/>
                                        <Setter Property="Foreground"      Value="#FCA5A5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps -->
                    <StackPanel Grid.Row="1" Margin="24,20,24,4">
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1">
                            <TextBlock x:Name="TxtInfoAnnulation" Text=""
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#991B1B" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="Motif d'annulation * (min. 10 caractères)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtMotifAnnulation"
                                 Height="80" FontSize="13" Padding="10"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="TxtErreurMotif" Text="" FontSize="12"
                                   Foreground="#DC2626" Margin="0,0,0,12"/>
                        <TextBlock Text="Mot de passe Boss (confirmation)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PwdBossAnnulation"
                                     Height="38" FontSize="13" Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,4"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="TxtErreurMdp" Text="" FontSize="12"
                                   Foreground="#DC2626" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- Pied -->
                    <Border Grid.Row="2" Padding="24,14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Height="38" Padding="18,0" FontSize="13"
                                    Margin="0,0,10,0" Style="{StaticResource BtnGhost}"
                                    Click="BtnFermerModalAnnulation_Click"/>
                            <Button x:Name="BtnConfirmerAnnulation"
                                    Height="38" Padding="18,0" FontSize="13" FontWeight="Bold"
                                    Click="BtnConfirmerAnnulation_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="#DC2626"/>
                                        <Setter Property="Foreground"      Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="13" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Confirmer l'annulation" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
