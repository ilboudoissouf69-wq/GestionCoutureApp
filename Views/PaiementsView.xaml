<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.PaiementsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <!--
        Layout racine : Grid à 2 enfants dans la même cellule (Row 0).
          - ContenuPrincipal  : l'écran normal
          - OverlayEncaissement : modale d'encaissement (ZIndex 99, Collapsed par défaut)
          - OverlayAnnulation   : modale d'annulation  (ZIndex 99, Collapsed par défaut)
        Même pattern que CommandesView.
    -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContenuPrincipal" Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <!-- En-tête titre + bouton -->
                <RowDefinition Height="Auto"/>
                <!-- Barre recherche + filtres -->
                <RowDefinition Height="Auto"/>
                <!-- Tableau pleine largeur -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Barre titre + bouton Encaisser ───────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Gestion des Paiements"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtOperateurConnecte"
                               Text="Opérateur : —"
                               FontSize="12" Foreground="#94A3B8" Margin="32,4,0,0"/>
                </StackPanel>

                <!-- Bouton Encaisser un Paiement — orange, même style que CommandesView -->
                <Button x:Name="BtnOuvrirModalEncaissement"
                        Grid.Column="1"
                        Height="36" Padding="16,0"
                        FontSize="13" FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnOuvrirModalEncaissement_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"       Value="#F97316"/>
                            <Setter Property="Foreground"       Value="White"/>
                            <Setter Property="BorderThickness"  Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EA6C0A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="16" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Encaisser un Paiement"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Barre recherche + filtres ────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Champ recherche -->
                <Border Grid.Column="0"
                        CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍" FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   Foreground="#94A3B8"/>
                        <TextBox x:Name="TxtRecherche"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Padding="0,8"
                                 TextChanged="TxtRecherche_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Hint" TileMode="None"
                                                     Opacity="0.4" Stretch="None"
                                                     AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Rechercher par N° reçu, client, opérateur…"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Hint}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Filtres Valides / Annulés / Tous -->
                <Border Grid.Column="1"
                        CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="White"
                        Padding="4,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbValides"
                                     Content="Valides"
                                     IsChecked="True"
                                     Margin="6,4"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="#15803D"
                                     Checked="FiltreStatut_Changed">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DCFCE7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F0FDF4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton x:Name="RbAnnules"
                                     Content="Annulés"
                                     Margin="2,4"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="#B91C1C"
                                     Checked="FiltreStatut_Changed">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton x:Name="RbTous"
                                     Content="Tous"
                                     Margin="2,4"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     Checked="FiltreStatut_Changed">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Tableau + pagination ──────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource CardNoPad}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Indicateur de chargement -->
                        <RowDefinition Height="Auto"/>
                        <!-- DataGrid (défile seul, prend tout l'espace) -->
                        <RowDefinition Height="*"/>
                        <!-- Pagination -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Loading -->
                    <Border x:Name="LoadingIndicator"
                            Grid.Row="0"
                            Padding="14,10"
                            Visibility="Collapsed"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,2"
                            Background="#FFFBF5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chargement…" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid moderne (pas de ScrollViewer englobant) -->
                    <DataGrid x:Name="GridPaiements"
                              Grid.Row="1"
                              Style="{StaticResource ModernGrid}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>

                            <!-- N° REÇU & DATE -->
                            <DataGridTemplateColumn Header="N° Reçu / Date"
                                                    Width="160" MinWidth="140"
                                                    SortMemberPath="RecuNumero">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4">
                                            <TextBlock Text="{Binding RecuNumero}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding DatePaiement, StringFormat={}{0:dd/MM/yy HH:mm}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- COMMANDE & CLIENT -->
                            <DataGridTemplateColumn Header="Commande / Client"
                                                    Width="*" MinWidth="160"
                                                    SortMemberPath="IdCommande">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}">
                                                <Run Text="CMD #"/>
                                                <Run Text="{Binding IdCommande}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,1,0,0">
                                                <Run Text="{Binding Commande.Client.Prenom}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Commande.Client.Nom}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Commande.TypeVetementAffiche}"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- MODE -->
                            <DataGridTextColumn Header="Mode"
                                                Binding="{Binding ModePaiement}"
                                                Width="Auto" MinWidth="110"
                                                ElementStyle="{StaticResource DataGridCellText}"/>

                            <!-- OPÉRATEUR -->
                            <DataGridTextColumn Header="Opérateur"
                                                Binding="{Binding NomOperateur}"
                                                Width="Auto" MinWidth="100"
                                                ElementStyle="{StaticResource DataGridCellText}"/>

                            <!-- MONTANT ENCAISSÉ -->
                            <DataGridTextColumn Header="Montant (FCFA)"
                                                Binding="{Binding MontantPaye, StringFormat={}{0:N0}}"
                                                Width="Auto" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight"          Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- STATUT badge -->
                            <DataGridTemplateColumn Header="Statut"
                                                    Width="90" MinWidth="80"
                                                    SortMemberPath="EstAnnule">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3"
                                                HorizontalAlignment="Center"
                                                Margin="4,2"
                                                ToolTip="{Binding StatutAffichage}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatutAffichage}"
                                                       FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACTIONS -->
                            <DataGridTemplateColumn Header="Actions"
                                                    Width="Auto" MinWidth="100"
                                                    CanUserSort="False"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="4,2">

                                            <!-- 🖨️ Imprimer le reçu -->
                                            <Button Tag="{Binding}"
                                                    Content="🖨️"
                                                    FontSize="14"
                                                    Width="32" Height="32"
                                                    Margin="0,0,4,0"
                                                    Cursor="Hand"
                                                    ToolTip="Imprimer le reçu"
                                                    Click="BtnLigneRecu_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background"      Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="6"
                                                                            Padding="2">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F0F9FF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 🚫 Annuler — visible uniquement Boss, masqué si déjà annulé -->
                                            <Button x:Name="BtnLigneAnnuler"
                                                    Tag="{Binding}"
                                                    Content="🚫"
                                                    FontSize="14"
                                                    Width="32" Height="32"
                                                    Cursor="Hand"
                                                    ToolTip="Annuler ce paiement (Boss uniquement)"
                                                    Click="BtnLigneAnnuler_Click"
                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Page},
                                                                         Path=EstBoss,
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background"      Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="6"
                                                                            Padding="2">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                                <Setter Property="Opacity"   Value="0.25"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Border Grid.Row="2"
                            Padding="16,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPaginationInfo"
                                       Grid.Column="0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnPagePrecedente"
                                        Content="← Préc."
                                        Height="30" Padding="10,0" FontSize="12"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False"
                                        Click="BtnPagePrecedente_Click"/>
                                <Button x:Name="BtnPageSuivante"
                                        Content="Suiv. →"
                                        Height="30" Padding="10,0" FontSize="12"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False"
                                        Click="BtnPageSuivante_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY MODAL — ENCAISSEMENT
             ZIndex 99, Collapsed par défaut
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayEncaissement"
              Visibility="Collapsed"
              Panel.ZIndex="99">

            <!-- Fond semi-transparent -->
            <Border Background="#80000000"/>

            <!-- Carte modale centrée -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="540"
                    MaxHeight="680"
                    CornerRadius="14"
                    Background="White"
                    Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête modale -->
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="💳  Encaisser un paiement"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Espèces · Mobile Money · Virement · Chèque"
                                           FontSize="11" Foreground="#94A3B8"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28" Height="28"
                                    FontSize="13" FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Fermer"
                                    Click="BtnFermerModalEncaissement_Click"
                                    VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"     Value="Transparent"/>
                                        <Setter Property="Foreground"     Value="#94A3B8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1E3A5F"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps scrollable -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,4">

                            <!-- Commande -->
                            <TextBlock Text="Commande *"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCommandesNonSoldees"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="DisplayText"
                                      Margin="0,0,0,14"
                                      SelectionChanged="CmbCommande_SelectionChanged"/>

                            <!-- Carte récapitulative -->
                            <Border CornerRadius="10" Padding="16,14"
                                    Margin="0,0,0,16"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtClientNom"
                                               Text="Client : —"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <Border Height="1"
                                            Background="{StaticResource BorderBrush}"
                                            Margin="0,10"/>
                                    <!-- Reste exact -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Reste à payer"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtResteExact"
                                                   Grid.Column="1"
                                                   Text="— FCFA"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                    </Grid>
                                    <!-- Reste après encaissement (mise à jour dynamique) -->
                                    <Border CornerRadius="6" Padding="10,6"
                                            Margin="0,10,0,0"
                                            Background="#FEF9EC"
                                            BorderBrush="#FCD34D" BorderThickness="1"
                                            Visibility="{Binding ElementName=TxtMontantPaiement,
                                                                  Path=Text,
                                                                  Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Reste après encaissement"
                                                       FontSize="11"
                                                       Foreground="#92400E"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtResteApres"
                                                       Grid.Column="1"
                                                       Text="— FCFA"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#92400E"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Montant -->
                            <TextBlock Text="Montant du paiement (FCFA) *"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMontantPaiement"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,14"
                                     PreviewTextInput="TxtMontant_PreviewTextInput"
                                     TextChanged="TxtMontantPaiement_TextChanged"/>

                            <!-- Mode de paiement — valeurs EXACTES de l'existant -->
                            <TextBlock Text="Mode de paiement"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbModePaiement"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,4"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="💵  Espèces"/>
                                <ComboBoxItem Content="📱  Mobile Money (Orange/Moov/Wave)"/>
                                <ComboBoxItem Content="🏦  Virement"/>
                                <ComboBoxItem Content="📄  Chèque"/>
                            </ComboBox>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pied modale — boutons -->
                    <Border Grid.Row="2"
                            Padding="24,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Annuler"
                                    Height="38" Padding="18,0"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource BtnGhost}"
                                    Click="BtnFermerModalEncaissement_Click"/>
                            <Button x:Name="BtnValiderPaiement"
                                    Height="38" Padding="18,0"
                                    FontSize="13" FontWeight="Bold"
                                    Click="BtnValiderPaiement_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="#16A34A"/>
                                        <Setter Property="Foreground"      Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15803D"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳" FontSize="14" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Valider le paiement"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY MODAL — ANNULATION (Boss) — en-tête rouge
             ZIndex 99, Collapsed par défaut
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayAnnulation"
              Visibility="Collapsed"
              Panel.ZIndex="99">

            <!-- Fond semi-transparent -->
            <Border Background="#80000000"/>

            <!-- Carte modale -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    CornerRadius="14"
                    Background="White"
                    Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête rouge -->
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7F1D1D" Offset="0"/>
                                <GradientStop Color="#991B1B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🚫  Annuler un paiement"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Action irréversible — Boss uniquement"
                                           FontSize="11" Foreground="#FCA5A5"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28" Height="28"
                                    FontSize="13" FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Fermer"
                                    Click="BtnFermerModalAnnulation_Click"
                                    VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="Transparent"/>
                                        <Setter Property="Foreground"      Value="#FCA5A5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps -->
                    <StackPanel Grid.Row="1" Margin="24,20,24,4">

                        <!-- Info paiement -->
                        <Border CornerRadius="8" Padding="14,10"
                                Margin="0,0,0,16"
                                Background="#FEF2F2"
                                BorderBrush="#FCA5A5" BorderThickness="1">
                            <TextBlock x:Name="TxtInfoAnnulation"
                                       Text=""
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#991B1B"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Motif -->
                        <TextBlock Text="Motif d'annulation * (min. 10 caractères)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtMotifAnnulation"
                                 Height="80"
                                 FontSize="13"
                                 Padding="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"/>

                        <!-- Message d'erreur motif -->
                        <TextBlock x:Name="TxtErreurMotif"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#DC2626"
                                   Margin="0,0,0,12"/>

                        <!-- Mot de passe Boss -->
                        <TextBlock Text="Mot de passe Boss (confirmation)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PwdBossAnnulation"
                                     Height="38"
                                     FontSize="13"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,4"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"/>

                        <!-- Message d'erreur mot de passe -->
                        <TextBlock x:Name="TxtErreurMdp"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#DC2626"
                                   Margin="0,0,0,4"/>

                    </StackPanel>

                    <!-- Pied -->
                    <Border Grid.Row="2"
                            Padding="24,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Annuler"
                                    Height="38" Padding="18,0"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource BtnGhost}"
                                    Click="BtnFermerModalAnnulation_Click"/>
                            <Button x:Name="BtnConfirmerAnnulation"
                                    Height="38" Padding="18,0"
                                    FontSize="13" FontWeight="Bold"
                                    Click="BtnConfirmerAnnulation_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="#DC2626"/>
                                        <Setter Property="Foreground"      Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="13" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Confirmer l'annulation"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
