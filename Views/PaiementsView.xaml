<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.PaiementsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── BANNIÈRE TITRE ── -->
        <Border Grid.Row="0"
                CornerRadius="12"
                Padding="24,18"
                Margin="0,0,0,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E1106" Offset="0.6"/>
                    <GradientStop Color="#451A03" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion des Paiements"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"/>
                    <Border Height="2" Width="40" CornerRadius="1"
                            HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#D97706"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="8" Padding="14,8"
                        Background="#0F172A"
                        BorderBrush="#1E293B" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOperateurConnecte"
                                   Text="Opérateur : -"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── CORPS ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- GAUCHE : Tableau paiements -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardNoPad}">
                    <StackPanel>
                        <!-- Loading -->
                        <Border x:Name="LoadingIndicator"
                                Background="#FFFBF5"
                                Padding="14" Visibility="Collapsed"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0,0,0,2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Chargement..." FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GridPaiements"
                                  Style="{StaticResource ModernGrid}"
                                  SelectionChanged="GridPaiements_SelectionChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N° Reçu"
                                                    Binding="{Binding RecuNumero}"
                                                    Width="Auto" MinWidth="110"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Client"
                                                    Binding="{Binding Commande.Client.Nom}"
                                                    Width="*" MinWidth="90"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Montant (FCFA)"
                                                    Binding="{Binding MontantPaye, StringFormat={}{0:N0}}"
                                                    Width="Auto" MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource DataGridCellText}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Mode"
                                                    Binding="{Binding ModePaiement}"
                                                    Width="Auto" MinWidth="85"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Opérateur"
                                                    Binding="{Binding NomOperateur}"
                                                    Width="Auto" MinWidth="90"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="Date / Heure"
                                                    Binding="{Binding DatePaiement, StringFormat={}{0:dd/MM/yy HH:mm}}"
                                                    Width="Auto" MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource DataGridCellText}">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Statut badge -->
                                <DataGridTemplateColumn Header="Statut" Width="90" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    Margin="4,2"
                                                    ToolTip="{Binding StatutAffichage}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatutAffichage}"
                                                           FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <Border Background="White"
                                Padding="14,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPaginationInfo"
                                           Grid.Column="0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnPagePrecedente"
                                            Content="← Préc."
                                            Height="30" Padding="10,0" FontSize="12"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource BtnGhost}"
                                            IsEnabled="False"
                                            Click="BtnPagePrecedente_Click"/>
                                    <Button x:Name="BtnPageSuivante"
                                            Content="Suiv. →"
                                            Height="30" Padding="10,0" FontSize="12"
                                            Style="{StaticResource BtnGhost}"
                                            IsEnabled="False"
                                            Click="BtnPageSuivante_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions bas tableau -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <Button x:Name="BtnGenererRecu"
                            Style="{StaticResource BtnNavy}"
                            Height="38" Padding="16,0"
                            Margin="0,0,10,0"
                            Click="BtnGenererRecu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="13" Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Imprimer le reçu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAnnuler"
                            Style="{StaticResource BtnDanger}"
                            Height="38" Padding="16,0"
                            Click="BtnAnnuler_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚫" FontSize="13" Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Annuler ce paiement" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- DROITE : Formulaire encaissement -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardNoPad}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <!-- En-tête panneau -->
                    <Border CornerRadius="12,12,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="💳  Enregistrer un paiement"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Espèces · Mobile Money · Virement · Chèque"
                                       FontSize="11" Foreground="#94A3B8"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,20">

                        <TextBlock Text="Commande *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbCommande"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="DisplayText"
                                  Margin="0,0,0,14"
                                  SelectionChanged="CmbCommande_SelectionChanged"/>

                        <!-- Résumé commande -->
                        <Border CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,16"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtInfoClient"
                                           Text="Client : -"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <Border Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TOTAL"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtInfoMontant"
                                                   Text="- FCFA"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="RESTE DÛ"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtInfoReste"
                                                   Text="- FCFA"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Déjà payé -->
                                <Border CornerRadius="6" Padding="10,5"
                                        Margin="0,10,0,0"
                                        Background="#DCFCE7"
                                        BorderBrush="#86EFAC" BorderThickness="1">
                                    <TextBlock x:Name="TxtInfoDejaPaye"
                                               Text="Déjà payé : 0 FCFA"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#15803D"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Montant du paiement (FCFA) *"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtMontant"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,14"
                                 PreviewTextInput="TxtMontant_PreviewTextInput"/>

                        <TextBlock Text="Mode de paiement"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbModePaiement"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="💵  Espèces"/>
                            <ComboBoxItem Content="📱  Mobile Money (Orange/Moov/Wave)"/>
                            <ComboBoxItem Content="🏦  Virement"/>
                            <ComboBoxItem Content="📄  Chèque"/>
                        </ComboBox>

                        <Button x:Name="BtnEnregistrer"
                                Style="{StaticResource BtnSuccess}"
                                Height="44"
                                FontSize="13" FontWeight="Bold"
                                Margin="0,0,0,18"
                                Click="BtnEnregistrer_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="15" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Enregistrer le paiement"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,0,0,14"/>

                        <TextBlock Text="Historique des paiements"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListBox x:Name="ListeHistorique"
                                     MaxHeight="160"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding"         Value="10,7"/>
                                        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
