<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.DepensesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- ══ TITRE ══════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dépenses &amp; Bilan Financier"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <Border Height="3" Width="44" CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,4"/>
                    <TextBlock x:Name="TxtPeriodeLabel"
                               Text="Période : ce mois-ci"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <!-- Sélecteur de période rapide -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox x:Name="CmbPeriode" Width="160" Height="34" FontSize="12"
                              SelectionChanged="CmbPeriode_SelectionChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="Aujourd'hui"    Tag="jour"/>
                        <ComboBoxItem Content="Cette semaine"  Tag="semaine"/>
                        <ComboBoxItem Content="Ce mois-ci"     Tag="mois" IsSelected="True"/>
                        <ComboBoxItem Content="Ce trimestre"   Tag="trimestre"/>
                        <ComboBoxItem Content="Cette année"    Tag="annee"/>
                        <ComboBoxItem Content="Personnalisé"   Tag="custom"/>
                    </ComboBox>
                    <!-- Dates personnalisées -->
                    <StackPanel x:Name="PanelDateCustom" Orientation="Horizontal"
                                Visibility="Collapsed">
                        <DatePicker x:Name="DateDebutFiltre" Height="34" FontSize="12"
                                    Width="120" Margin="0,0,6,0"
                                    SelectedDateChanged="DateFiltre_Changed"/>
                        <DatePicker x:Name="DateFinFiltre" Height="34" FontSize="12"
                                    Width="120" Margin="0,0,8,0"
                                    SelectedDateChanged="DateFiltre_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ══ 4 CARTES KPI FINANCIÈRES ═══════════════════════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- 1 — Chiffre d'Affaires Encaissé -->
                <Border CornerRadius="12" Padding="18,14" Margin="0,0,10,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="CHIFFRE D'AFFAIRES ENCAISSÉ" FontSize="9" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtCaEncaisse" Text="0"
                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA — tout l'argent reçu des clients"
                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2 — Charges de fonctionnement -->
                <Border CornerRadius="12" Padding="18,14" Margin="0,0,10,0">
                    <Border.Background>
                        <SolidColorBrush Color="#B91C1C"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="CHARGES DE FONCTIONNEMENT" FontSize="9" FontWeight="Bold"
                                   Foreground="#FCA5A5"/>
                        <TextBlock x:Name="TxtCharges" Text="0"
                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                   Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtChargesDetail" Text="FCFA (dépenses + salaires)"
                                   FontSize="10" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3 — Résultat Brut -->
                <Border CornerRadius="12" Padding="18,14" Margin="0,0,10,0">
                    <Border.Background>
                        <SolidColorBrush Color="#15803D"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="RÉSULTAT BRUT" FontSize="9" FontWeight="Bold"
                                   Foreground="#86EFAC"/>
                        <TextBlock x:Name="TxtMargeBrute" Text="0"
                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                   Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtMargeBruteDetail"
                                   Text="FCFA (recettes − matériaux − commissions validées)"
                                   FontSize="10" Foreground="#86EFAC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4 — Résultat Net -->
                <Border CornerRadius="12" Padding="18,14">
                    <Border.Background>
                        <SolidColorBrush Color="#1D4ED8"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="RÉSULTAT NET" FontSize="9" FontWeight="Bold"
                                   Foreground="#93C5FD"/>
                        <TextBlock x:Name="TxtBeneficeNet" Text="0"
                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Résultat brut − charges de fonctionnement"
                                   FontSize="10" Foreground="#93C5FD" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Détail KPI (sous les cartes) -->
            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,10"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Commissions couturiers validées" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtDetailCommissions" Text="0 FCFA"
                                   FontSize="12" FontWeight="Bold" Foreground="#CC0000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Matériaux avancés (remboursés par les clients)" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDetailMateriaux" Text="0 FCFA"
                                   FontSize="12" FontWeight="Bold" Foreground="#374151"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dépenses de fonctionnement validées" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtDetailDepenses" Text="0 FCFA"
                                   FontSize="12" FontWeight="Bold" Foreground="#374151"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Salaire secrétaire (proraté)" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtDetailSalaire" Text="0 FCFA"
                                   FontSize="12" FontWeight="Bold" Foreground="#374151"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ FORMULAIRE NOUVELLE DÉPENSE ════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Border CornerRadius="12,12,0,0" Padding="20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Enregistrer une dépense" FontSize="14"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <Grid Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <!-- Catégorie -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Catégorie *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCategorie"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="CmbCategorie_SelectionChanged">
                                <ComboBoxItem Content="Charges fixes"       Tag="Charges fixes"/>
                                <ComboBoxItem Content="Masse salariale"     Tag="Masse salariale"/>
                                <ComboBoxItem Content="Matériel &amp; Entretien" Tag="Matériel &amp; Entretien"/>
                                <ComboBoxItem Content="Divers"              Tag="Divers"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Type (dépend de la catégorie) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbTypeDepense"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <!-- Montant -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Montant (FCFA) *"
                                    Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMontant"
                                    Style="{StaticResource ModernTextBox}"
                                     PreviewTextInput="TxtMontant_PreviewTextInput"
                                     DataObject.Pasting="TxtMontant_Pasting"/>

                        </StackPanel>

                            <!-- Date -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Date *" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateDepense" Height="38" FontSize="13"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="20,10,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <!-- Description -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Statut initial -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Statut" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbStatutSaisie" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Validée"     Tag="Validee" IsSelected="True"/>
                                <ComboBoxItem Content="En attente"  Tag="En attente"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Bouton ajouter -->
                        <Button x:Name="BtnAjouter"
                                Grid.Column="4"
                                Content="➕  Enregistrer"
                                Style="{StaticResource BtnSuccess}"
                                Height="38" VerticalAlignment="Bottom"
                                Click="BtnAjouter_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtMessage" FontSize="12"
                               TextWrapping="Wrap" Margin="20,8,20,16"/>
                </StackPanel>
            </Border>

            <!-- ══ FILTRES + HISTORIQUE ════════════════════════════════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- En-tête avec filtres + export -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Historique des dépenses"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <!-- Filtre catégorie -->
                            <ComboBox x:Name="CmbFiltreCategorie" Width="160" Height="32"
                                      FontSize="12" Margin="0,0,8,0"
                                      SelectionChanged="FiltreChanged">
                                <ComboBoxItem Content="Toutes catégories" Tag="Toutes" IsSelected="True"/>
                                <ComboBoxItem Content="Charges fixes"     Tag="Charges fixes"/>
                                <ComboBoxItem Content="Masse salariale"   Tag="Masse salariale"/>
                                <ComboBoxItem Content="Matériel &amp; Entretien" Tag="Matériel &amp; Entretien"/>
                                <ComboBoxItem Content="Divers"            Tag="Divers"/>
                            </ComboBox>

                            <!-- Filtre statut -->
                            <ComboBox x:Name="CmbFiltreStatut" Width="130" Height="32"
                                      FontSize="12" SelectionChanged="FiltreChanged">
                                <ComboBoxItem Content="Tous statuts"  Tag="Tous" IsSelected="True"/>
                                <ComboBoxItem Content="Validées"      Tag="Validee"/>
                                <ComboBoxItem Content="En attente"    Tag="En attente"/>
                                <ComboBoxItem Content="Annulées"      Tag="Annulée"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Boutons export -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnExportCsv"
                                    Style="{StaticResource BtnNavy}"
                                    Height="32" Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="BtnExportCsv_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnValiderSelection"
                                    Style="{StaticResource BtnSuccess}"
                                    Height="32" Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="BtnValider_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="12" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Valider sélection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnDanger}"
                                    Height="32" Padding="12,0"
                                    FontSize="12"
                                    Click="BtnSupprimer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="12" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Annuler sélection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tableau -->
                    <DataGrid x:Name="GridDepenses"
                              Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateAffichee}"
                                                Width="Auto"
                                                MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Catégorie"
                                                Binding="{Binding Categorie}"
                                                Width="Auto"
                                                MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding TypeDepense}"
                                                Width="*"
                                                MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Montant (FCFA)"
                                                Binding="{Binding MontantAffiche}"
                                                Width="Auto"
                                                MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"
                                                MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Par"
                                                Binding="{Binding NomOperateur}"
                                                Width="Auto"
                                                MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- Statut coloré -->
                            <DataGridTemplateColumn Header="Statut" Width="90" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3"
                                                Margin="4,2" HorizontalAlignment="Left"
                                                ToolTip="{Binding StatutAffiche}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#059669"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatutValidation}" Value="En attente">
                                                            <Setter Property="Background" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstAnnulee}" Value="True">
                                                            <Setter Property="Background" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatutAffiche}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pied : total filtré -->
                    <Border CornerRadius="0,0,12,12"
                            Padding="16,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TOTAL AFFICHÉ : "
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotalFiltre"
                                       Text="0 FCFA"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNbFiltre"
                                       Text="  — 0 dépense(s)"
                                       FontSize="12" Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
