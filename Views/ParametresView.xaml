<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.ParametresView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Margin="0,0,0,20">
            <TextBlock Text="Paramètres"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <Border Height="3"
                    Width="40"
                    CornerRadius="2"
                    Background="#CC0000"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Width="440">
            <StackPanel>
                <Border CornerRadius="10,10,0,0"
                        Padding="20,14"
                        Background="#1A1A1A">
                    <TextBlock Text="Réglages généraux"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <StackPanel Margin="20,16,20,20">
                    <TextBlock Text="Délai du rappel 'rendez-vous proche' (heures) *"
                               Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtDelaiAlerte"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Fréquence de synchronisation Google Drive en heures (0 = fin de journée uniquement) *"
                               Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtFrequenceSync"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Salaire mensuel de la secrétaire (FCFA) *"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtSalaireSecretaire"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,18"/>

                    <Separator Background="{StaticResource BorderBrush}"
                               Margin="0,0,0,14"/>

                    <Button Content="Enregistrer"
                            Style="{StaticResource BtnSuccess}"
                            Click="BtnEnregistrer_Click"
                            Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtMessage"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>