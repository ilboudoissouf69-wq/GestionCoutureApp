<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GestionCoutureApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Couture — Retouche Choco"
        Height="700" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             BOUTON NAV — état normal
        ═══════════════════════════════════════════════════════════ -->
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Foreground"               Value="#94A3B8"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="FontWeight"               Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment"      Value="Stretch"/>
            <Setter Property="Padding"                  Value="16,12"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D97706"/>
                                <Setter Property="Foreground"                 Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             BOUTON NAV — état actif (ambre + barre blanche indicatrice)
        ═══════════════════════════════════════════════════════════ -->
        <Style TargetType="Button" x:Key="NavBtnActif" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background"    Value="#D97706"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,1">
                            <Grid>
                                <!-- Barre indicatrice gauche blanche -->
                                <Border Width="3"
                                        CornerRadius="2"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,8"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton nav déconnexion — rouge discret -->
        <Style TargetType="Button" x:Key="NavBtnDanger" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#450A0A"/>
                                <Setter Property="Foreground"                 Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ SIDEBAR ═══════ -->
        <Border Grid.Column="0" Background="#020617">
            <DockPanel>

                <!-- ── En-tête atelier ── -->
                <StackPanel DockPanel.Dock="Top" Margin="0,28,0,0">

                    <!-- Logo dans cadre doré -->
                    <Border Width="64" Height="64"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Border.Background>
                            <SolidColorBrush Color="#1E1A14"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#D97706"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness>1.5</Thickness>
                        </Border.BorderThickness>
                        <Image Source="pack://application:,,,/Resources/logo_retouche_choco.png"
                               Width="48" Height="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Titre atelier -->
                    <TextBlock Text="RETOUCHE CHOCO"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Atelier Ilboudo"
                               FontSize="10"
                               Foreground="#D97706"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Séparateur -->
                <Border DockPanel.Dock="Top"
                        Height="1" Background="#1E293B"
                        Margin="16,18,16,0"/>

                <!-- ── Badge utilisateur connecté ── -->
                <Border DockPanel.Dock="Top"
                        Margin="12,14,12,0"
                        CornerRadius="10"
                        Padding="12,10"
                        Background="#0F172A">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#1E293B"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1</Thickness>
                    </Border.BorderThickness>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Nom utilisateur — mis à jour depuis code-behind -->
                            <TextBlock x:Name="TxtUtilisateur"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       MaxWidth="140"/>
                            <!-- Badge rôle — coloré par code-behind -->
                            <Border x:Name="BadgeRole"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    Background="#D97706">
                                <TextBlock x:Name="TxtRole"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="White"
                                           Text="BOSS"/>
                            </Border>
                        </StackPanel>
                        <!-- Bouton changer mot de passe -->
                        <Button Grid.Column="1"
                                x:Name="BtnChangerMdp"
                                Width="30" Height="30"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="Changer mon mot de passe"
                                Click="BtnChangerMdp_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            Width="30" Height="30">
                                        <TextBlock Text="🔑" FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Séparateur -->
                <Border DockPanel.Dock="Top"
                        Height="1" Background="#1E293B"
                        Margin="16,14,16,0"/>

                <!-- ── Déconnexion en bas ── -->
                <Button x:Name="BtnDeconnexion"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource NavBtnDanger}"
                        Margin="0,0,0,20"
                        Click="BtnDeconnexion_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Déconnexion"  FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Bottom"
                        Height="1" Background="#1E293B"
                        Margin="16,0,16,8"/>

                <!-- ── Navigation principale (ScrollViewer sans barre visible) ── -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Margin="0,10,0,0">
                    <StackPanel>

                        <!-- Groupe principal -->
                        <TextBlock Text="PRINCIPAL"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#475569"
                                   Margin="20,8,0,6"/>

                        <Button x:Name="BtnTableauDeBord"
                                Style="{StaticResource NavBtn}"
                                Click="BtnTableauDeBord_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tableau de bord" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClients"
                                Style="{StaticResource NavBtn}"
                                Click="BtnClients_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clients"         FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCommandes"
                                Style="{StaticResource NavBtn}"
                                Click="BtnCommandes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Commandes"       FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPaiements"
                                Style="{StaticResource NavBtn}"
                                Click="BtnPaiements_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Paiements"       FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnStatut"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnStatut_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏭" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Suivi Atelier"   FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Bouton Alertes avec badge de compteur -->
                        <Button x:Name="BtnAlertes"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnAlertes_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Alertes RDV"     FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Badge compteur urgences -->
                                <Border x:Name="BadgeAlertesBorder"
                                        CornerRadius="10"
                                        MinWidth="20" Height="20"
                                        Background="#EF4444"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                        Padding="5,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="BadgeAlertes"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="0"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnRetours"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnRetours_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retours"         FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Séparateur groupe gestion -->
                        <Border Height="1" Background="#1E293B" Margin="16,10"/>

                        <TextBlock Text="GESTION"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#475569"
                                   Margin="20,0,0,6"
                                   Visibility="Collapsed"
                                   x:Name="LblGroupeGestion"/>

                        <Button x:Name="BtnCommissions"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnCommissions_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Commissions"     FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDepenses"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnDepenses_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📉" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dépenses"        FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Séparateur groupe admin -->
                        <Border Height="1" Background="#1E293B" Margin="16,10"
                                x:Name="SepAdmin" Visibility="Collapsed"/>

                        <TextBlock Text="ADMINISTRATION"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#475569"
                                   Margin="20,0,0,6"
                                   Visibility="Collapsed"
                                   x:Name="LblGroupeAdmin"/>

                        <Button x:Name="BtnTypesVetements"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnTypesVetements_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Types vêtements" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnEmployes"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnEmployes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Employés"        FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnParametres"
                                Style="{StaticResource NavBtn}"
                                Visibility="Collapsed"
                                Click="BtnParametres_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Paramètres"      FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Height="16"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════ ZONE CONTENU ═══════ -->
        <Frame x:Name="ContentFrame"
               Grid.Column="1"
               Background="{StaticResource BackgroundBrush}"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
