<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.CommandesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:GestionCoutureApp.Converters"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Page.Resources>

    <!-- ================================================================
         Layout racine : Grid.  Row 0 = contenu principal (tableau + barre)
                                Row 1 = OVERLAY MODAL (Visibility.Collapsed par défaut)
         Trick WPF : la Grid empile ses enfants par défaut dans la même cellule
         quand on ne précise pas de RowDefinition séparé pour l'overlay ;
         on met l'overlay dans Row 0 avec ZIndex=99 et il couvre tout.
    ================================================================ -->
    <Grid>

        <!-- ════════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
        ════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContenuPrincipal" Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <!-- Titre + barre d'outils -->
                <RowDefinition Height="Auto"/>
                <!-- Tableau pleine largeur -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Barre titre + actions ─────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="22" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Gestion des Commandes"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Commandes multi-pièces, fiches de mesures, échéances et fiches de coupe atelier"
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Bouton nouvelle commande + filtre retard -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">

                    <!-- Compteur retard cliquable -->
                    <Button x:Name="BtnCompteurRetard"
                            Height="36" Padding="12,0"
                            FontSize="12" FontWeight="SemiBold"
                            Cursor="Hand" Margin="0,0,10,0"
                            Click="BtnCompteurRetard_Click"
                            ToolTip="Afficher uniquement les commandes en retard">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="TxtCompteurRetard" Text="🔴 0 retard"/>
                    </Button>

                    <!-- Bouton Nouvelle Commande — orange -->
                    <Button x:Name="BtnOuvrirModalCommande"
                            Height="36" Padding="16,0"
                            FontSize="13" FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnOuvrirModalCommande_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EA6C0A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Nouvelle Commande" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Tableau principal ──────────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- barre recherche/filtres -->
                        <RowDefinition Height="Auto"/>
                        <!-- indicateur chargement -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- pagination -->
                    </Grid.RowDefinitions>

                    <!-- ── Barre recherche + filtres ── -->
                    <Border Grid.Row="0" Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche — par n° commande ou nom client -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="TxtRecherche"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="34"
                                         TextChanged="TxtRecherche_TextChanged"/>
                                <TextBlock Text="🔍  Rechercher par #commande ou nom…"
                                           FontSize="11" Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtRecherche}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Filtres alignés à droite : Statut + Couturier -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <!-- Filtre statut avec label -->
                                <TextBlock Text="▼ Statut :"
                                           FontSize="11" Foreground="#64748B"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbFiltreStatut"
                                          Width="130" Height="32" FontSize="11"
                                          SelectionChanged="CmbFiltreStatut_SelectionChanged"
                                          Margin="0,0,20,0">
                                    <ComboBoxItem Content="Tous les statuts" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="À faire" Tag="A faire"/>
                                    <ComboBoxItem Content="En cours" Tag="En cours"/>
                                    <ComboBoxItem Content="Terminée" Tag="Terminee"/>
                                    <ComboBoxItem Content="Livrée" Tag="Livree"/>
                                </ComboBox>

                                <!-- Filtre couturier avec label -->
                                <TextBlock Text="Couturier :"
                                           FontSize="11" Foreground="#64748B"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbFiltreCouturier"
                                          Width="150" Height="32" FontSize="11"
                                          SelectedValuePath="IdEmploye"
                                          SelectionChanged="CmbFiltreCouturier_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Prenom"/>
                                                        <Binding Path="Nom"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Indicateur de chargement ── -->
                    <Border x:Name="LoadingIndicator"
                            Grid.Row="1"
                            Background="#F8F9FA"
                            Padding="12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chargement..." FontSize="12"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ── DataGrid pleine largeur ── -->
                    <DataGrid x:Name="GridCommandes"
                              Grid.Row="2"
                              Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              MouseDoubleClick="GridCommandes_MouseDoubleClick">

                        <!-- Ligne légèrement rosée si commande en retard -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="ToolTip"
                                                Value="⚠️ Cette commande est en retard"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- ═══ COMMANDE (CMD #N + date) ═══ -->
                            <DataGridTemplateColumn Header="COMMANDE" Width="100" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,7">
                                            <TextBlock FontSize="12" FontWeight="Bold"
                                                       Foreground="#0F172A">
                                                <TextBlock.Text>
                                                    <Binding Path="IdCommande"
                                                             StringFormat="{}CMD #{0}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#64748B"
                                                       Text="{Binding DateDebut,
                                                              StringFormat={}{0:dd/MM/yyyy}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ CLIENT ═══ -->
                            <DataGridTemplateColumn Header="CLIENT" Width="140" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,7">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Client.Nom"/>
                                                        <Binding Path="Client.Prenom"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#94A3B8"
                                                       Text="{Binding Client.Telephone}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ PIÈCES & COUTURIER ═══
                                 Chaque pièce sur sa propre ligne : TypeVetement (Couturier) + badge statut -->
                            <DataGridTemplateColumn Header="PIÈCES &amp; COUTURIER" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Pieces}"
                                                      Margin="8,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,2,0,2">
                                                        <!-- Nom du vêtement -->
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#1E293B"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="100"
                                                                   Text="{Binding TypeVetement}"/>
                                                        <!-- Couturier entre parenthèses -->
                                                        <TextBlock FontSize="10" Foreground="#64748B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0,6,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="80">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}({0})">
                                                                    <Binding Path="Couturier.Prenom"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <!-- Badge statut pièce -->
                                                        <Border CornerRadius="8" Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Terminee">
                                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Statut}" Value="Livree">
                                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatutAffiche}"
                                                                       FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#475569"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="En cours">
                                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="Terminee">
                                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Statut}" Value="Livree">
                                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ LIVRAISON (date + heure retrait) ═══ -->
                            <DataGridTemplateColumn Header="LIVRAISON" Width="90" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,7">
                                            <!-- Date — rouge+gras si en retard -->
                                            <TextBlock Text="{Binding DateFin, StringFormat={}{0:dd/MM/yyyy}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource DataGridCellText}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstEnRetard}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="ToolTip"
                                                                        Value="⚠️ En retard !"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Heure retrait -->
                                            <TextBlock FontSize="10" Foreground="#64748B"
                                                       Text="{Binding HeureFin,
                                                              StringFormat={}à {0:hh\\:mm}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ STATUT GLOBAL (badge pilule) ═══ -->
                            <DataGridTemplateColumn Header="STATUT" Width="100" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Margin="8,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                     Value="En cours">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                     Value="Terminée">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                     Value="Livrée">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatutGlobalAffiche}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                         Value="En cours">
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                         Value="Terminée">
                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatutGlobalAffiche}"
                                                                         Value="Livrée">
                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ FACTURE & SOLDE ═══ -->
                            <DataGridTemplateColumn Header="FACTURE &amp; SOLDE" Width="140" MinWidth="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,7">
                                            <!-- Montant total en gras -->
                                            <TextBlock FontSize="12" FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       Text="{Binding MontantTotalAvecMateriaux,
                                                              StringFormat={}{0:N0} FCFA}"/>
                                            <!-- Reste à payer ou Soldé -->
                                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!-- Impayé par défaut → rouge -->
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="Text"
                                                                Value="{Binding ResteAPayer,
                                                                        StringFormat={}Reste : {0:N0} FCFA}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatutPaiement}"
                                                                         Value="Soldé">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                <Setter Property="Text" Value="Soldé ✓"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ═══ ACTIONS (6 icônes) ═══ -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="195" MinWidth="195">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DataTemplate.Resources>
                                            <!-- Style icône action : fond visible au hover -->
                                            <Style x:Key="BtnAction" TargetType="Button">
                                                <Setter Property="Width"           Value="28"/>
                                                <Setter Property="Height"          Value="26"/>
                                                <Setter Property="FontSize"        Value="13"/>
                                                <Setter Property="Background"      Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor"          Value="Hand"/>
                                                <Setter Property="Margin"          Value="1,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="2,2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataTemplate.Resources>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0">

                                            <!-- ✂️ Fiche Atelier -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="✂️"
                                                    ToolTip="Fiche Atelier"
                                                    Click="BtnActionFicheAtelier_Click"/>

                                            <!-- 🖨️ Reçu -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="🖨️"
                                                    ToolTip="Imprimer le reçu"
                                                    Click="BtnActionRecu_Click"/>

                                            <!-- ✏️ Éditer -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="✏️"
                                                    ToolTip="Modifier la commande"
                                                    Click="BtnActionEditer_Click"/>

                                            <!-- 💳 Paiement -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="💳"
                                                    ToolTip="Enregistrer un paiement"
                                                    Click="BtnActionPaiement_Click"/>

                                            <!-- 💬 WhatsApp -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="💬"
                                                    ToolTip="Notifier le client sur WhatsApp"
                                                    Click="BtnActionWhatsApp_Click"/>

                                            <!-- 🗑️ Supprimer -->
                                            <Button Style="{StaticResource BtnAction}"
                                                    Content="🗑️"
                                                    ToolTip="Supprimer cette commande"
                                                    Click="BtnActionSupprimer_Click"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Pagination ── -->
                    <Border Grid.Row="3" Background="#FAF5F2" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       x:Name="TxtPaginationInfo"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="BtnPagePrecedente" Content="←"
                                        Width="36" Height="32" Margin="0,0,8,0"
                                        Click="BtnPagePrecedente_Click"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False" FontSize="14"/>
                                <Button x:Name="BtnPageSuivante" Content="→"
                                        Width="36" Height="32"
                                        Click="BtnPageSuivante_Click"
                                        Style="{StaticResource BtnGhost}"
                                        IsEnabled="False" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
        <!-- /ContenuPrincipal -->

        <!-- ════════════════════════════════════════════════════════════
             OVERLAY MODAL — "Nouvelle / Modifier Commande"
             Occupe toute la Grid racine (ZIndex=99)
             Visibility.Collapsed par défaut, Visible quand ouvert
        ════════════════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayModalCommande"
              Visibility="Collapsed"
              Panel.ZIndex="99"
              Background="#80000000">

            <!-- Fond semi-opaque cliquable pour fermer -->
            <Rectangle Fill="Transparent"
                       MouseLeftButtonDown="OverlayFond_MouseLeftButtonDown"/>

            <!-- Panneau centré -->
            <Border Background="White"
                    CornerRadius="14"
                    Width="780"
                    MaxHeight="880"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- En-tête sombre -->
                        <RowDefinition Height="Auto"/>
                        <!-- Corps scrollable -->
                        <RowDefinition Height="*"/>
                        <!-- Pied : acompte + valider -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── En-tête modale ── -->
                    <Border Grid.Row="0"
                            CornerRadius="14,14,0,0"
                            Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTitreModal"
                                           Text="Nouvelle Commande"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtSousTitreModal"
                                           Text="Remplissez les informations de la commande"
                                           FontSize="12" Foreground="#94A3B8"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Bouton fermer -->
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="32" Height="32"
                                    FontSize="14"
                                    Foreground="#94A3B8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Click="BtnFermerModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- ── Corps scrollable ── -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,20,24,12">
                        <StackPanel>

                            <!-- ═══════════════════════════════════════
                                 EN-TÊTE COMMANDE
                            ═══════════════════════════════════════ -->
                            <Border Background="#F8FAFC" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,16"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📌  EN-TÊTE COMMANDE"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,12"/>

                                    <!-- Client -->
                                    <TextBlock Text="Client *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbModalClient"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectedValuePath="IdClient"
                                              Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Nom"/>
                                                            <Binding Path="Prenom"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Date + heure -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Date de rendez-vous *"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="DpModalDateFin"
                                                        Height="36" FontSize="13"
                                                        BorderBrush="{StaticResource BorderBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Dépôt (HH:mm)"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <!-- TxtHeureDebut = heure dépôt, lecture seule -->
                                            <TextBox x:Name="TxtHeureDebut"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"
                                                     Background="#F2ECE8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Retrait (HH:mm)"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtModalHeure"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ═══════════════════════════════════════
                                 VÊTEMENTS & PIÈCES
                            ═══════════════════════════════════════ -->
                            <Border Background="#F8FAFC" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,16"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>

                                    <!-- En-tête section pièces + bouton Forcer statut (Boss, édition) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="🧵  VÊTEMENTS &amp; PIÈCES DE LA COMMANDE"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Bouton Forcer statut — Boss uniquement, mode édition -->
                                        <Button Grid.Column="1"
                                                x:Name="BtnForcerStatut"
                                                Content="⚡ Forcer statut (toutes les pièces)"
                                                Height="28" Padding="10,0"
                                                FontSize="11" FontWeight="SemiBold"
                                                Foreground="White" BorderThickness="0"
                                                Cursor="Hand" Visibility="Collapsed"
                                                Click="BtnForcerStatut_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#7C3AED"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#6D28D9"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <!-- Panneau dynamique des cartes de pièces -->
                                    <StackPanel x:Name="PanneauCartesPieces"
                                                Margin="0,0,0,10"/>

                                    <!-- Bouton ajouter une pièce -->
                                    <Button x:Name="BtnAjouterPiece"
                                            Content="➕  Ajouter une pièce"
                                            Height="36" Padding="14,0"
                                            FontSize="12" FontWeight="SemiBold"
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            Click="BtnAjouterPieceModal_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Pied modale : acompte + boutons ── -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            CornerRadius="0,0,14,14"
                            Padding="24,16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Bloc acompte -->
                                <ColumnDefinition Width="*"/>
                                <!-- Boutons -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bloc acompte immédiat -->
                            <StackPanel Grid.Column="0"
                                        x:Name="PanneauAcompte"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Acompte immédiat :"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <TextBox x:Name="TxtModalAcompte"
                                         Width="120" Height="36"
                                         FontSize="13"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Text="0"
                                         Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TxtModalAcompte_PreviewTextInput"/>

                                <TextBlock Text="FCFA" FontSize="12"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="8,0,16,0"/>

                                <ComboBox x:Name="CmbModalModePaiement"
                                          Width="120" Height="36"
                                          FontSize="12">
                                    <ComboBoxItem Content="Espèces" IsSelected="True"/>
                                    <ComboBoxItem Content="Mobile Money"/>
                                    <ComboBoxItem Content="Virement"/>
                                    <ComboBoxItem Content="Chèque"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Boutons Annuler / Valider -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button Content="Annuler"
                                        Width="100" Height="36"
                                        FontSize="13"
                                        Cursor="Hand" Margin="0,0,10,0"
                                        Click="BtnFermerModal_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="BtnValiderNouvelleCommande"
                                        Height="36" Padding="20,0"
                                        FontSize="13" FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnValiderNouvelleCommande_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0F172A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓  " FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtnValider"
                                                   Text="Valider la Commande"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
            <!-- /panneau centré -->

        </Grid>
        <!-- /OverlayModalCommande -->

        <!-- ════════════════════════════════════════════════════════════
             CONTRÔLES LEGACY (hors-écran) — conservés pour compatibilité
             code-behind existant qui les référence par x:Name.
             Placés dans un Grid 0×0 invisible.
        ════════════════════════════════════════════════════════════ -->
        <Grid Width="0" Height="0" Visibility="Collapsed">
            <!-- Contrôles existants dans le panneau droite, maintenant
                 dans la modale ou dans le code dynamique des cartes.
                 On les garde ici pour que le code-behind compile sans
                 changement sur les méthodes non refactorisées. -->

            <!-- En-tête commande (anciens noms) -->
            <ComboBox x:Name="CmbClient" SelectedValuePath="IdClient"/>
            <DatePicker x:Name="DateFin"/>
            <TextBox x:Name="TxtHeureFin"/>

            <!-- Pièce (formulaire ancienne version) -->
            <ComboBox x:Name="CmbTypeVetement" SelectedValuePath="IdTypeVetement"/>
            <ComboBox x:Name="CmbCouturier" SelectedValuePath="IdEmploye"/>
            <ComboBox x:Name="CmbAjustement"/>
            <TextBox x:Name="TxtMontant"/>
            <ComboBox x:Name="CmbStatut"/>
            <ComboBox x:Name="CmbDescription"/>
            <StackPanel x:Name="PanelMesuresDynamiques"/>
            <TextBlock x:Name="TxtIndicationMesures"/>
            <Image x:Name="ImgPhoto"/>
            <TextBlock x:Name="TxtPhotoPlaceholder"/>
            <Button x:Name="BtnSupprimerPhoto" Click="BtnSupprimerPhoto_Click"/>
            <Button x:Name="BtnPrendrePhoto" Click="BtnPrendrePhoto_Click"/>
            <Button x:Name="BtnImporterPhoto" Click="BtnImporterPhoto_Click"/>

            <!-- Panier pièces (panneau droite ancien) -->
            <DataGrid x:Name="ListePieces"/>
            <DataGrid x:Name="ListeMateriaux"/>
            <TextBox x:Name="TxtMatDesignation"
                     PreviewTextInput="TxtMatDesignation_PreviewTextInput"/>
            <TextBox x:Name="TxtMatQuantite"/>
            <TextBox x:Name="TxtMatPrix"/>
            <Button x:Name="BtnAjouterMateriau" Click="BtnAjouterMateriau_Click"/>
            <Button x:Name="BtnConfirmerMateriau" Click="BtnConfirmerMateriau_Click"/>
            <Button x:Name="BtnAnnulerFormulaireMateriau"
                    Click="BtnAnnulerFormulaireMateriau_Click"/>
            <Button x:Name="BtnSupprimerMateriau" Click="BtnSupprimerMateriau_Click"/>
            <StackPanel x:Name="PanelAjoutMateriau"/>
            <Separator x:Name="SepAvantFormulaireMat"/>
            <StackPanel x:Name="PanelListeMateriaux"/>
            <TextBlock x:Name="TxtAucunMateriau"/>
            <TextBlock x:Name="TxtTotalMateriaux"/>
            <StackPanel x:Name="PanelMateriaux"/>
            <StackPanel x:Name="PanelBoutonsPhoto"/>
            <StackPanel x:Name="PanelPhoto"/>
            <TextBlock x:Name="TxtTotalPieces"/>
            <Button x:Name="BtnSupprimerPiece" Click="BtnSupprimerPiece_Click"/>
            <Button x:Name="BtnSauvegarderPiece" Click="BtnSauvegarderPiece_Click"/>
            <Button x:Name="BtnCreer" Click="BtnCreer_Click"/>
            <Button x:Name="BtnModifier" Click="BtnModifier_Click"/>
            <Button x:Name="BtnSupprimer" Click="BtnSupprimer_Click"/>
            <Button x:Name="BtnVider" Click="BtnVider_Click"/>

            <!-- WhatsApp panel droite -->
            <Button x:Name="BtnWhatsAppPrete" Click="BtnWhatsAppPrete_Click"/>
            <Button x:Name="BtnWhatsAppRdv" Click="BtnWhatsAppRdv_Click"/>
            <Button x:Name="BtnWhatsAppPied" Click="BtnWhatsAppPied_Click"/>
            <Button x:Name="BtnFicheAtelier" Click="BtnFicheAtelier_Click"/>
            <TextBlock x:Name="TxtWhatsAppPiedLabel"/>

            <!-- Divers -->
            <StackPanel x:Name="PanelActionsPiece"/>
            <TextBlock x:Name="LblDetailPiece"/>
            <Separator x:Name="SepDetailPiece"/>
            <TextBlock x:Name="LblTypeVetement"/>
            <TextBlock x:Name="LblCouturier"/>
            <StackPanel x:Name="PanelPrix"/>
            <TextBlock x:Name="TxtPrixBase"/>
            <TextBlock x:Name="TxtPrixTotal"/>
            <TextBlock x:Name="LblDescription"/>
            <TextBlock x:Name="LblMontant"/>
            <TextBlock x:Name="LblStatut"/>
            <Separator x:Name="SepMesures"/>
            <TextBlock x:Name="LblPhoto"/>
            <Separator x:Name="SepPhoto"/>
            <TextBlock x:Name="LblReutilisationMesures"/>
            <ComboBox x:Name="CmbMesuresAnterieures"
                      SelectionChanged="CmbMesuresAnterieures_SelectionChanged"/>

            <!-- Bandeau résumé (panel droite) -->
            <Border x:Name="BandeauResume"/>
            <TextBlock x:Name="TxtResumeTotalPieces"/>
            <Border x:Name="ChipTerminee"/>
            <TextBlock x:Name="TxtResumeTerminee"/>
            <Border x:Name="ChipEnCours"/>
            <TextBlock x:Name="TxtResumeEnCours"/>
            <Border x:Name="ChipAfaire"/>
            <TextBlock x:Name="TxtResumeAfaire"/>
            <Border x:Name="ChipLivree"/>
            <TextBlock x:Name="TxtResumeLivree"/>
            <TextBlock x:Name="TxtResumeCouturiers"/>

            <!-- TxtMontant valide le collage -->
            <TextBox x:Name="TxtMontantPasting"
                     DataObject.Pasting="TxtMontant_Pasting"/>
        </Grid>

    </Grid>
</Page>
