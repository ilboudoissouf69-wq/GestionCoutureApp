<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.CommandesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:GestionCoutureApp.Converters"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Page.Resources>

    <!-- ================================================================
         Layout principal : liste gauche (40%) | panneau droite (60%)
    ================================================================ -->
    <Grid Margin="20,20,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             COLONNE GAUCHE — liste des commandes existantes
        ============================================================ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Gestion des Commandes (V2)"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border Height="3" Width="48" CornerRadius="2"
                        Background="#CC0000" HorizontalAlignment="Left"
                        Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Recherche -->
            <TextBox Grid.Row="1"
                     x:Name="TxtRecherche"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,10"
                     TextChanged="TxtRecherche_TextChanged"/>

            <!-- Tableau commandes -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="0">
                <DataGrid x:Name="GridCommandes"
                          Style="{StaticResource ModernGrid}"
                          SelectionChanged="GridCommandes_SelectionChanged"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Photo" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Background="#F2ECE8"
                                            Width="32" Height="32" Margin="4,2">
                                        <Image Source="{Binding Pieces[0].CheminPhoto,
                                               Converter={StaticResource ImagePathConverter}}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Client"
                                            Binding="{Binding Client.Nom}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Pièces"
                                            Binding="{Binding Pieces.Count}"
                                            Width="52"/>
                        <DataGridTextColumn Header="Statut"
                                            Binding="{Binding StatutGlobalAffiche}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding MontantTotalCalcule, StringFormat={}{0:N0}}"
                                            Width="82"/>
                        <DataGridTextColumn Header="RDV"
                                            Binding="{Binding DateFin, StringFormat={}{0:dd/MM}}"
                                            Width="62"/>

                        <!-- ── WhatsApp ── -->
                        <DataGridTemplateColumn Header="💬" Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="💬"
                                            Width="28" Height="26"
                                            FontSize="13"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            ToolTip="Notifier le client sur WhatsApp"
                                            Click="BtnWhatsAppCommande_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Style.Triggers>
                                                    <!-- Vert vif si commande Terminee -->
                                                    <DataTrigger Binding="{Binding StatutGlobalAffiche}" Value="Terminée">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="ToolTip" Value="✅ Commande prête — Notifier le client"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============================================================
             COLONNE DROITE — détails de la commande en cours
        ============================================================ -->
        <Border Grid.Column="2"
                Style="{StaticResource Card}"
                Padding="0"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- En-tête sombre -->
                    <RowDefinition Height="Auto"/>
                    <!-- Corps scrollable -->
                    <RowDefinition Height="*"/>
                    <!-- Pied : actions globales -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── En-tête panneau ── -->
                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        Padding="16,12"
                        Background="#1A1A1A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Détails de la commande"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <!-- Boutons WhatsApp dans l'en-tête -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Notifier commande prête -->
                            <Button x:Name="BtnWhatsAppPrete"
                                    Height="30" Padding="10,0,10,0"
                                    FontSize="11" FontWeight="SemiBold"
                                    Background="#25D366"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    ToolTip="Envoyer WhatsApp : commande prête"
                                    Click="BtnWhatsAppPrete_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💬" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="Prête !"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <!-- Rappel RDV -->
                            <Button x:Name="BtnWhatsAppRdv"
                                    Height="30" Padding="10,0,10,0"
                                    FontSize="11" FontWeight="SemiBold"
                                    Background="#075E54"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    ToolTip="Envoyer WhatsApp : rappel de RDV"
                                    Click="BtnWhatsAppRdv_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏰" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="RDV"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Corps scrollable ── -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16,20,8">
                    <StackPanel>

                        <!-- ════════════════════════════════════════════
                             ZONE 1 — EN-TÊTE COMMANDE
                        ════════════════════════════════════════════ -->
                        <Border Background="#F8F5F3"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📌  EN-TÊTE COMMANDE"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#8B7355"
                                           Margin="0,0,0,12"/>

                                <!-- Client -->
                                <TextBlock Text="Client *"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbClient"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectedValuePath="IdClient"
                                          Margin="0,0,0,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Nom"/>
                                                        <Binding Path="Prenom"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Rendez-vous : date + heure -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Date de rendez-vous *"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="DateFin"
                                                    Height="36" FontSize="13"
                                                    BorderBrush="{StaticResource BorderBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dépôt (HH:mm)"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtHeureDebut"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 Background="#F2ECE8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Retrait (HH:mm)"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtHeureFin"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ════════════════════════════════════════════
                             ZONE 2 — PANIER DE PIÈCES
                        ════════════════════════════════════════════ -->
                        <Border Background="#F8F5F3"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛒  PANIER DE PIÈCES"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#8B7355"
                                           Margin="0,0,0,10"/>

                                <!-- Tableau des pièces -->
                                <DataGrid x:Name="ListePieces"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E5E0DC"
                                          Background="White"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FDFAF8"
                                          MinHeight="80"
                                          Margin="0,0,0,10">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                                         Handler="PieceItem_MouseLeftButtonUp"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#FFF0EB"/>
                                                    <Setter Property="DetailsVisibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FDF5F2"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>

                                    <!-- Détails matériaux affichés sous la ligne sélectionnée -->
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFAF9"
                                                    BorderBrush="#DDD6CF"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,8,12,10">
                                                <StackPanel>
                                                    <!-- En-tête matériaux -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="🧵  Matériaux &amp; Suppléments"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="#8B7355"/>
                                                        <Button Grid.Column="1"
                                                                Content="✏️  Éditer cette pièce"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Height="26" Padding="10,0"
                                                                Background="#CC0000"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Click="BtnEditerPiece_Click"/>
                                                    </Grid>

                                                    <!-- Liste matériaux (si présents) -->
                                                    <ItemsControl ItemsSource="{Binding MaterielSupplements}">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MaterielSupplements.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Designation}"
                                                                               FontSize="11"
                                                                               Foreground="#374151"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               FontSize="11"
                                                                               Foreground="#6B7280"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0} × {1:N0} F">
                                                                                <Binding Path="Quantite"/>
                                                                                <Binding Path="PrixUnitaire"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                    <Border Grid.Column="2"
                                                                            Background="#FFF3F0"
                                                                            CornerRadius="3"
                                                                            Padding="6,2"
                                                                            HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding MontantAffiche}"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Foreground="#CC0000"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Message si aucun matériau -->
                                                    <TextBlock FontSize="11"
                                                               FontStyle="Italic"
                                                               Foreground="#9CA3AF"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MaterielSupplements.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Text" Value="Aucun matériau pour cette pièce — cliquez Éditer pour en ajouter."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type"
                                                            Binding="{Binding TypeVetement}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Couturier"
                                                            Binding="{Binding Couturier.Prenom}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="Statut"
                                                            Binding="{Binding StatutAffiche}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="Prix (FCFA)"
                                                            Binding="{Binding MontantCouture, StringFormat={}{0:N0}}"
                                                            Width="90"/>
                                        <DataGridTemplateColumn Header="Actions" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <!-- Dupliquer -->
                                                        <Button Content="📋"
                                                                Width="26" Height="24"
                                                                FontSize="12"
                                                                ToolTip="Dupliquer cette pièce"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Margin="1"
                                                                Click="BtnDupliquerPiece_Click"/>
                                                        <!-- Éditer -->
                                                        <Button Content="✏️"
                                                                Width="26" Height="24"
                                                                FontSize="12"
                                                                ToolTip="Modifier cette pièce et ses matériaux"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Margin="1"
                                                                Click="BtnEditerPiece_Click"/>
                                                        <!-- Supprimer -->
                                                        <Button Content="🗑️"
                                                                Width="26" Height="24"
                                                                FontSize="12"
                                                                ToolTip="Supprimer cette pièce"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Margin="1"
                                                                x:Name="BtnSupprimerPieceLigne"
                                                                Click="BtnSupprimerPieceLigne_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Total + bouton ajouter -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1A1A1A"
                                            CornerRadius="6"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TOTAL COMMANDE : "
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="#B0A8A4"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTotalPieces"
                                                       Text="0 FCFA"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="1"
                                            x:Name="BtnAjouterPiece"
                                            Content="➕  Ajouter une pièce"
                                            Height="38"
                                            Padding="14,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Background="#CC0000"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="10,0,0,0"
                                            Click="BtnAjouterPiece_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ════════════════════════════════════════════
                             ZONE 3 — FORMULAIRE PIÈCE (caché par défaut,
                             visible à l'édition / ajout d'une pièce)
                        ════════════════════════════════════════════ -->
                        <Border Background="White"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,0,6"
                                BorderBrush="#CC0000"
                                BorderThickness="1.5">
                            <StackPanel>

                                <!-- Titre formulaire pièce -->
                                <TextBlock x:Name="LblDetailPiece"
                                           Text="Nouvelle pièce"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#CC0000"
                                           Margin="0,0,0,12"
                                           Visibility="Collapsed"/>
                                <Separator x:Name="SepDetailPiece"
                                           Background="#F0EBE7"
                                           Margin="0,0,0,12"
                                           Visibility="Collapsed"/>

                                <!-- Réutilisation mesures antérieures -->
                                <TextBlock x:Name="LblReutilisationMesures"
                                           Text="Reprendre les mesures d'une commande précédente"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbMesuresAnterieures"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,12"
                                          Visibility="Collapsed"
                                          SelectionChanged="CmbMesuresAnterieures_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="CMD-{0}  ({1})  •  {2}">
                                                        <Binding Path="IdCommande"/>
                                                        <Binding Path="Commande.DateFin" StringFormat="dd/MM/yy"/>
                                                        <Binding Path="StatutAffiche"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Type de vêtement -->
                                <TextBlock x:Name="LblTypeVetement"
                                           Text="Type de vêtement *"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbTypeVetement"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,10"
                                          DisplayMemberPath="DisplayText"
                                          Visibility="Collapsed"
                                          SelectionChanged="CmbTypeVetement_SelectionChanged"/>

                                <!-- Couturier -->
                                <TextBlock x:Name="LblCouturier"
                                           Text="Couturier attribué"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbCouturier"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,10"
                                          SelectedValuePath="IdEmploye"
                                          Visibility="Collapsed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Prenom"/>
                                                        <Binding Path="Nom"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Prix -->
                                <StackPanel x:Name="PanelPrix"
                                            Margin="0,0,0,10"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="TxtPrixBase"
                                               Text="Prix de base : -"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Ajustement : "
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CmbAjustement"
                                                  Width="110" Height="32" FontSize="12"
                                                  SelectionChanged="CmbAjustement_SelectionChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPrixTotal"
                                               Text="Prix total : -"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock x:Name="LblDescription"
                                           Text="Description / Consignes"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbDescription"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          Height="36" FontSize="13"
                                          DisplayMemberPath="Texte"
                                          Margin="0,0,0,10"
                                          Visibility="Collapsed"/>

                                <!-- Montant -->
                                <TextBlock x:Name="LblMontant"
                                           Text="Montant couture (FCFA) *"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <TextBox x:Name="TxtMontant"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,10"
                                         Visibility="Collapsed"
                                         PreviewTextInput="TxtMontant_PreviewTextInput"
                                         DataObject.Pasting="TxtMontant_Pasting">
                                    <TextBox.Text>
                                        <Binding Path="Text" RelativeSource="{RelativeSource Self}" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <helpers:MontantPositifValidationRule xmlns:helpers="clr-namespace:GestionCoutureApp.Helpers" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <!-- Statut -->
                                <TextBlock x:Name="LblStatut"
                                           Text="Statut de la pièce"
                                           Style="{StaticResource FieldLabel}"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbStatut"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,12"
                                          SelectedIndex="0"
                                          Visibility="Collapsed">
                                    <ComboBoxItem Content="A faire"/>
                                    <ComboBoxItem Content="En cours"/>
                                    <ComboBoxItem Content="Terminee"/>
                                    <ComboBoxItem Content="Livree"/>
                                </ComboBox>

                                <!-- Mesures dynamiques -->
                                <Separator x:Name="SepMesures"
                                           Background="#F0EBE7"
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtIndicationMesures"
                                           Text="Sélectionnez un type de vêtement"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"
                                           Visibility="Collapsed"/>
                                <StackPanel x:Name="PanelMesuresDynamiques"
                                            Margin="0,0,0,12"/>

                                <!-- Photo -->
                                <Separator Background="#F0EBE7" Margin="0,0,0,10"
                                           x:Name="SepPhoto" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblPhoto"
                                           Text="Photo du tissu / modèle"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="Collapsed"/>
                                <StackPanel x:Name="PanelBoutonsPhoto"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,8"
                                            Visibility="Collapsed">
                                    <Button x:Name="BtnImporterPhoto"
                                            Content="📁  Importer"
                                            Style="{StaticResource BtnNavy}"
                                            Height="32" Padding="12,0"
                                            Click="BtnImporterPhoto_Click"
                                            Margin="0,0,8,0"/>
                                    <Button x:Name="BtnPrendrePhoto"
                                            Content="📷  Webcam"
                                            Style="{StaticResource BtnPrimary}"
                                            Height="32" Padding="12,0"
                                            Click="BtnPrendrePhoto_Click"/>
                                </StackPanel>
                                <Border x:Name="PanelPhoto"
                                        Background="#FBF8F6"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="120"
                                        Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Image x:Name="ImgPhoto"
                                               Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="TxtPhotoPlaceholder"
                                                   Text="Aucune photo sélectionnée"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="BtnSupprimerPhoto"
                                                Content="✕"
                                                Width="24" Height="24"
                                                FontSize="11" FontWeight="Bold"
                                                Foreground="White"
                                                Background="{StaticResource DangerBrush}"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,6,6,0"
                                                Visibility="Collapsed"
                                                Click="BtnSupprimerPhoto_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ════════════════════════════════════════
                                     SECTION MATÉRIAUX / SUPPLÉMENTS
                                     Rattachés à la pièce, exclus de la commission
                                ════════════════════════════════════════ -->
                                <Separator x:Name="SepMateriaux"
                                           Background="#E8E0DC"
                                           Margin="0,4,0,14"
                                           Visibility="Collapsed"/>

                                <Border x:Name="PanelMateriaux"
                                        Visibility="Collapsed"
                                        Background="#FAFAF9"
                                        BorderBrush="#DDD6CF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,14">
                                    <StackPanel>

                                        <!-- En-tête section matériaux -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="🧵"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <StackPanel>
                                                    <TextBlock x:Name="LblMateriaux"
                                                               Text="Matériaux &amp; Suppléments"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                    <TextBlock Text="Facturés au client — exclus de la commission couturier"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Total matériaux -->
                                            <Border Grid.Column="1"
                                                    Background="#1A1A1A"
                                                    CornerRadius="4"
                                                    Padding="10,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Total mat. : "
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#A0A0A0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtTotalMateriaux"
                                                               Text="0 FCFA"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Liste des matériaux existants -->
                                        <Border x:Name="PanelListeMateriaux"
                                                Visibility="Collapsed"
                                                Margin="0,0,0,10">
                                            <ItemsControl x:Name="ListeMateriaux">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White"
                                                                BorderBrush="#E8E2DC"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="12,8"
                                                                Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="30"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Désignation -->
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Designation}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Qté × prix -->
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0} × {1:N0} F">
                                                                            <Binding Path="Quantite"/>
                                                                            <Binding Path="PrixUnitaire"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>

                                                                <!-- Montant total ligne -->
                                                                <Border Grid.Column="2"
                                                                        Background="#FFF3F0"
                                                                        CornerRadius="4"
                                                                        Padding="8,3"
                                                                        HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding MontantAffiche}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               Foreground="#CC0000"/>
                                                                </Border>

                                                                <!-- Supprimer -->
                                                                <Button Grid.Column="3"
                                                                        Content="✕"
                                                                        Width="24" Height="24"
                                                                        FontSize="11" FontWeight="Bold"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="#AAAAAA"
                                                                        Cursor="Hand"
                                                                        ToolTip="Supprimer ce matériau"
                                                                        Tag="{Binding IdMateriel}"
                                                                        Click="BtnSupprimerMateriau_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- Message vide -->
                                        <TextBlock x:Name="TxtAucunMateriau"
                                                   Text="Aucun matériau ajouté pour cette pièce."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,10"
                                                   Visibility="Visible"/>

                                        <!-- Séparateur avant formulaire -->
                                        <Separator x:Name="SepAvantFormulaireMat"
                                                   Background="#E8E0DC"
                                                   Margin="0,2,0,10"
                                                   Visibility="Collapsed"/>

                                        <!-- Formulaire d'ajout inline -->
                                        <Border x:Name="PanelAjoutMateriau"
                                                Background="#F0ECE8"
                                                BorderBrush="#D4C8BE"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Nouveau matériau"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="#6B5B4E"
                                                           Margin="0,0,0,10"/>

                                                <!-- Désignation (pleine largeur) -->
                                                <TextBlock Text="Désignation *"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMatDesignation"
                                                         Style="{StaticResource ModernTextBox}"
                                                         Margin="0,0,0,8"/>

                                                <!-- Quantité + Prix sur la même ligne -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Quantité"
                                                                   Style="{StaticResource FieldLabel}"/>
                                                        <TextBox x:Name="TxtMatQuantite"
                                                                 Style="{StaticResource ModernTextBox}"
                                                                 Text="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Prix unitaire (FCFA)"
                                                                   Style="{StaticResource FieldLabel}"/>
                                                        <TextBox x:Name="TxtMatPrix"
                                                                 Style="{StaticResource ModernTextBox}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Boutons formulaire -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✔  Ajouter"
                                                            Style="{StaticResource BtnSuccess}"
                                                            Height="34" Padding="14,0"
                                                            FontSize="12"
                                                            Click="BtnConfirmerMateriau_Click"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="Annuler"
                                                            Style="{StaticResource BtnGhost}"
                                                            Height="34" Padding="12,0"
                                                            FontSize="12"
                                                            Click="BtnAnnulerFormulaireMateriau_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bouton ouvrir formulaire (caché quand formulaire ouvert) -->
                                        <Button x:Name="BtnAjouterMateriau"
                                                Height="34"
                                                FontSize="11" FontWeight="SemiBold"
                                                Background="Transparent"
                                                BorderBrush="#C4B8AE"
                                                BorderThickness="1"
                                                Foreground="#6B5B4E"
                                                Cursor="Hand"
                                                Click="BtnAjouterMateriau_Click">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="＋" FontSize="14"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="Ajouter un matériau / supplément"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>

                                    </StackPanel>
                                </Border>

                                <!-- Bouton Valider pièce -->
                                <Button x:Name="BtnSauvegarderPiece"
                                        Content="💾  Valider et ajouter au panier"
                                        Style="{StaticResource BtnSuccess}"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Margin="0,4,0,0"
                                        Visibility="Collapsed"
                                        Click="BtnSauvegarderPiece_Click"/>

                                <!-- Boutons actions pièce existante -->
                                <StackPanel x:Name="PanelActionsPiece"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                    <Button x:Name="BtnDupliquerPiece"
                                            Content="📋  Dupliquer"
                                            Style="{StaticResource BtnNavy}"
                                            Height="34" Padding="12,0"
                                            Margin="0,0,8,0"
                                            Click="BtnDupliquerPiece_Click"/>
                                    <Button x:Name="BtnSupprimerPiece"
                                            Content="🗑️  Supprimer la pièce"
                                            Style="{StaticResource BtnDanger}"
                                            Height="34" Padding="12,0"
                                            Visibility="Collapsed"
                                            Click="BtnSupprimerPiece_Click"/>
                                    <Button x:Name="BtnForcerStatut"
                                            Content="⚡  Forcer statut"
                                            Style="{StaticResource BtnGhost}"
                                            Height="34" Padding="12,0"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed"
                                            Click="BtnForcerStatut_Click"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── Pied : actions globales commande ── -->
                <Border Grid.Row="2"
                        Padding="20,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Créer -->
                        <Button Grid.Column="0"
                                x:Name="BtnCreer"
                                Content="✚  Créer"
                                Style="{StaticResource BtnSuccess}"
                                Height="36" Padding="14,0"
                                Click="BtnCreer_Click"/>

                        <!-- Modifier -->
                        <Button Grid.Column="1"
                                x:Name="BtnModifier"
                                Content="✏  Modifier"
                                Style="{StaticResource BtnNavy}"
                                Height="36" Padding="14,0"
                                Margin="8,0,0,0"
                                Click="BtnModifier_Click"/>

                        <!-- Vider -->
                        <Button Grid.Column="3"
                                x:Name="BtnVider"
                                Content="Vider"
                                Style="{StaticResource BtnGhost}"
                                Height="36" Padding="14,0"
                                Click="BtnVider_Click"/>

                        <!-- Supprimer -->
                        <Button Grid.Column="5"
                                x:Name="BtnSupprimer"
                                Content="🗑  Supprimer"
                                Style="{StaticResource BtnDanger}"
                                Height="36" Padding="14,0"
                                Click="BtnSupprimer_Click"/>

                        <!-- WhatsApp Notifier — visible uniquement si commande sélectionnée -->
                        <Button Grid.Column="7"
                                x:Name="BtnWhatsAppPied"
                                Height="36" Padding="12,0,12,0"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#25D366"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip="Notifier le client sur WhatsApp"
                                Click="BtnWhatsAppPied_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtWhatsAppPiedLabel"
                                               Text="Notifier"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
