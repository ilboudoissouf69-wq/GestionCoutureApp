<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.RetoursView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0"
                Margin="0,0,0,20">
            <TextBlock Text="Gestion des Retours"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <Border Height="3"
                    Width="48"
                    CornerRadius="2"
                    Background="#CC0000"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Recherche -->
        <TextBox Grid.Row="1"
                 x:Name="TxtRecherche"
                 Style="{StaticResource ModernTextBox}"
                 Margin="0,0,0,14"
                 TextChanged="TxtRecherche_TextChanged"/>

        <!-- Tableau -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0">
            <DataGrid x:Name="GridRetours"
                      Style="{StaticResource ModernGrid}"
                      SelectionChanged="GridRetours_SelectionChanged"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding DateSignalementAffichee}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding Commande.Client.Nom}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Piece"
                                        Binding="{Binding PieceCommande.TypeVetement}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Couturier"
                                        Binding="{Binding Couturier.Nom}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Probleme"
                                        Binding="{Binding DescriptionProbleme}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Statut"
                                        Binding="{Binding StatutAffiche}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>