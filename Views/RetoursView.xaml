<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.RetoursView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TITRE + BOUTON ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Retours &amp; Reprises Gratuites"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border Height="3" Width="48" CornerRadius="2"
                        Background="#CC0000"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,4"/>
                <TextBlock x:Name="TxtCompteur"
                           Text="— retour(s) enregistré(s)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="BtnNouveauRetour"
                    Content="🔄  + Nouveau retour"
                    Style="{StaticResource BtnPrimary}"
                    Height="40" Padding="18,0"
                    FontSize="13" FontWeight="SemiBold"
                    VerticalAlignment="Top"
                    Click="BtnNouveauRetour_Click"/>
        </Grid>

        <!-- ══ BARRE FILTRES ════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="TxtRecherche"
                     Style="{StaticResource ModernTextBox}"
                     Tag="🔍  Rechercher (client, pièce, couturier, motif…)"
                     TextChanged="TxtRecherche_TextChanged"/>

            <ComboBox Grid.Column="2"
                      x:Name="CmbFiltreStatut"
                      Height="38" FontSize="13"
                      SelectionChanged="CmbFiltreStatut_SelectionChanged">
                <ComboBoxItem Content="Tous" IsSelected="True"/>
                <ComboBoxItem Content="Signalé"/>
                <ComboBoxItem Content="En reprise"/>
                <ComboBoxItem Content="Prêt ✓"/>
                <ComboBoxItem Content="Rendu au client"/>
            </ComboBox>
        </Grid>

        <!-- ══ BADGES STATISTIQUES ══════════════════════════════════════════ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔴" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtNbSignale" Text="0"
                                   FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="Signalés" FontSize="9" Foreground="#EF4444"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟡" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtNbEnReprise" Text="0"
                                   FontSize="16" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock Text="En reprise" FontSize="9" Foreground="#F59E0B"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtNbPret" Text="0"
                                   FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="Prêts" FontSize="9" Foreground="#10B981"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="8" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚫" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtNbRendu" Text="0"
                                   FontSize="16" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Text="Rendus" FontSize="9" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ PANNEAU PERFORMANCE QUALITÉ (COMPACTÉ) ═══════════════════════ -->
        <Border Grid.Row="3"
                Background="#1A1A1A"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PERFORMANCE QUALITÉ"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Période :"
                                   FontSize="10" Foreground="#B0A8A4"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbPeriodeQualite"
                                  Width="130" Height="26" FontSize="10"
                                  Background="#2D2D2D"
                                  Foreground="#E5E7EB"
                                  SelectionChanged="CmbPeriodeQualite_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Ce mois-ci" Tag="mois" IsSelected="True"/>
                            <ComboBoxItem Content="Ce trimestre" Tag="trimestre"/>
                            <ComboBoxItem Content="Cette année" Tag="annee"/>
                            <ComboBoxItem Content="Tout" Tag="tout"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="ListePerformance">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A2A"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Medaille}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NomCouturier}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NbPiecesAffiche}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#B0A8A4"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="pièces"
                                                   FontSize="9" Foreground="#6B7280"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NbRetoursAffiche}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NbRetours}" Value="0">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="retours"
                                                   FontSize="9" Foreground="#6B7280"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TauxQualiteAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstExcellent}" Value="True">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstFaible}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="qualité"
                                                   FontSize="9" Foreground="#6B7280"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="5"
                                            CornerRadius="5"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstEligiblePrime}" Value="True">
                                                        <Setter Property="Background" Value="#065F46"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BadgePrime}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TxtAucunePerformance"
                           Text="Aucune donnée de performance pour cette période."
                           FontSize="11" FontStyle="Italic"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ══ TABLEAU (OPTIMISÉ) ═══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="0">
            <DataGrid x:Name="GridRetours"
                      Style="{StaticResource ModernGrid}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0"
                      RowHeight="48">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFF0EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FDF5F2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding DateSignalementAffichee}"
                                        Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Client -->
                    <DataGridTemplateColumn Header="Client" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClientAffiche}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#111827"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Commande.Client.Telephone}"
                                               FontSize="9" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Commande/Pièce -->
                    <DataGridTemplateColumn Header="CMD/Pièce" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,2" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="CMD-{0}">
                                                <Binding Path="IdCommande"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding PieceCommande.TypeVetement}"
                                               FontSize="9" Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Couturier -->
                    <DataGridTemplateColumn Header="Couturier" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,0" VerticalAlignment="Center"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Couturier.Prenom"/>
                                            <Binding Path="Couturier.Nom"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Motif -->
                    <DataGridTemplateColumn Header="Motif" Width="*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DescriptionProbleme}"
                                           Margin="8,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="#374151"
                                           ToolTip="{Binding DescriptionProbleme}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- RDV -->
                    <DataGridTextColumn Header="RDV" Width="85"
                                        Binding="{Binding DateRdvAffichee}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Statut -->
                    <DataGridTemplateColumn Header="Statut" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3"
                                        Margin="4,0" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Statut}" Value="Signale">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="En reprise">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Statut}" Value="Rendu">
                                                    <Setter Property="Background" Value="#6B7280"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                    <Setter Property="Background" Value="#9CA3AF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatutAffiche}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Content="✏️"
                                            Width="26" Height="26"
                                            FontSize="12"
                                            ToolTip="Modifier"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            Click="BtnEditerRetour_Click"/>
                                    <Button x:Name="BtnAvancerStatut"
                                            Width="26" Height="26"
                                            FontSize="12"
                                            ToolTip="Avancer"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            Click="BtnAvancerStatut_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                        <Setter Property="Content" Value="✅"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Rendu">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="50" Height="26"
                                            FontSize="9" FontWeight="SemiBold"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            ToolTip="Notifier via WhatsApp"
                                            Click="BtnWhatsAppRetour_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="💬"/>
                                                <Setter Property="Background" Value="#9CA3AF"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                        <Setter Property="Background" Value="#25D366"/>
                                                        <Setter Property="Content" Value="💬 Prêt"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="🚫"
                                            Width="26" Height="26"
                                            FontSize="12"
                                            ToolTip="Annuler"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            Click="BtnAnnulerRetour_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
