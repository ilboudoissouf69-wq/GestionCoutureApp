<?xml version="1.0" encoding="utf-8"?>
<!--
    RetoursView.xaml — Écran « Retours / Reprises Gratuites Sous Garantie »
    Charte locale Ambre & Ardoise — préfixe Ret pour toutes les clés locales.
    Aucune ressource globale (App.xaml, Resources/*) n'est modifiée.
    Tous les x:Name et gestionnaires d'événements du code-behind sont conservés.
-->
<Page x:Class="GestionCoutureApp.Views.RetoursView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <!-- ═══════════════════════════════════════════════════════════════════
         RESSOURCES LOCALES — charte Ambre & Ardoise (préfixe Ret)
         N'entrent jamais en collision avec les clés globales.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Couleurs locales -->
        <SolidColorBrush x:Key="RetAmber"        Color="#D97706"/>  <!-- Amber-600 -->
        <SolidColorBrush x:Key="RetAmberHover"   Color="#B45309"/>  <!-- Amber-700 -->
        <SolidColorBrush x:Key="RetAmberLight"   Color="#FEF3C7"/>  <!-- Amber-100 -->
        <SolidColorBrush x:Key="RetAmberMid"     Color="#FDE68A"/>  <!-- Amber-200 -->
        <SolidColorBrush x:Key="RetSlateDark"    Color="#0F172A"/>  <!-- Slate-900 -->
        <SolidColorBrush x:Key="RetSlateMuted"   Color="#64748B"/>  <!-- Slate-500 -->
        <SolidColorBrush x:Key="RetSlateBody"    Color="#334155"/>  <!-- Slate-700 -->
        <SolidColorBrush x:Key="RetBorder"       Color="#E2E8F0"/>  <!-- Slate-200 -->
        <SolidColorBrush x:Key="RetPageBg"       Color="#F8FAFC"/>  <!-- Slate-50  -->
        <SolidColorBrush x:Key="RetWhite"        Color="#FFFFFF"/>

        <!-- Style carte locale (carte blanche arrondie) -->
        <Style x:Key="RetCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="BorderBrush"     Value="{StaticResource RetBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>

        <!-- Bouton ambre local (réutilisé dans la page sans toucher BtnPrimary global) -->
        <Style x:Key="RetBtnAmber" TargetType="Button">
            <Setter Property="Height"           Value="42"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="Background"       Value="{StaticResource RetAmber}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Padding"          Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RetAmberHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton fantôme local (secondaire, bordure ardoise) -->
        <Style x:Key="RetBtnGhost" TargetType="Button">
            <Setter Property="Height"           Value="38"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="Normal"/>
            <Setter Property="Foreground"       Value="{StaticResource RetSlateBody}"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="{StaticResource RetBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style en-tête de colonne DataGrid local -->
        <Style x:Key="RetColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"       Value="#F8FAFC"/>
            <Setter Property="Foreground"       Value="#475569"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Padding"          Value="10,10"/>
            <Setter Property="BorderBrush"      Value="#E2E8F0"/>
            <Setter Property="BorderThickness"  Value="0,0,0,2"/>
            <Setter Property="Cursor"           Value="Arrow"/>
        </Style>

        <!-- Style ligne DataGrid local -->
        <Style x:Key="RetRowStyle" TargetType="DataGridRow">
            <Setter Property="Height"   Value="62"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <!-- RDV en retard : fond rose très clair -->
                <DataTrigger Binding="{Binding RdvEnRetard}" Value="True">
                    <Setter Property="Background" Value="#FFF1F2"/>
                </DataTrigger>
                <!-- Ligne annulée : atténuée -->
                <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFBF0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cellule DataGrid local -->
        <Style x:Key="RetCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FocusVisualStyle"       Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         LAYOUT PRINCIPAL : Grid à 5 lignes
         Row 0 = En-tête
         Row 1 = Compteurs de statut
         Row 2 = Barre de filtres
         Row 3 = Panneau Performance Qualité
         Row 4 = Tableau (ligne *, défilement interne)
    ═══════════════════════════════════════════════════════════════════════ -->
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             LIGNE 0 — EN-TÊTE : pastille ambre + titre + bouton
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pastille ambre avec icône 🔄 -->
            <Border Grid.Column="0"
                    Background="{StaticResource RetAmberLight}"
                    BorderBrush="{StaticResource RetAmberMid}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Width="52" Height="52"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">
                <TextBlock Text="🔄"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Titre + sous-titre -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Retours / Reprises Gratuites Sous Garantie"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource RetSlateDark}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TxtCompteur"
                               Text="— retour(s) enregistré(s)"
                               FontSize="12"
                               Foreground="{StaticResource RetSlateMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Bouton principal ambre -->
            <Button Grid.Column="2"
                    x:Name="BtnNouveauRetour"
                    Content="+ Signaler un Retour"
                    Style="{StaticResource RetBtnAmber}"
                    Height="44" Padding="22,0"
                    FontSize="13" FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Click="BtnNouveauRetour_Click"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             LIGNE 1 — BANDE DES 4 COMPTEURS (cartes de statut)
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Signalé — rouge -->
            <Border Grid.Column="0"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#FEE2E2"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <TextBlock Text="⚠️" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNbSignale" Text="0"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#DC2626"/>
                        <TextBlock Text="Signalés"
                                   FontSize="11" Foreground="#EF4444"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- En reprise — ambre -->
            <Border Grid.Column="2"
                    Background="#FFFBEB"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#FEF3C7"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <TextBlock Text="🔧" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNbEnReprise" Text="0"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#D97706"/>
                        <TextBlock Text="En reprise"
                                   FontSize="11" Foreground="#F59E0B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Prêt — bleu/vert -->
            <Border Grid.Column="4"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#DBEAFE"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <TextBlock Text="✅" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNbPret" Text="0"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock Text="Prêts"
                                   FontSize="11" Foreground="#3B82F6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rendu — gris ardoise -->
            <Border Grid.Column="6"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#E2E8F0"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <TextBlock Text="📦" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNbRendu" Text="0"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#475569"/>
                        <TextBlock Text="Rendus"
                                   FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             LIGNE 2 — BARRE DE FILTRES : recherche + filtre statut
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Champ recherche avec placeholder explicite superposé -->
            <Grid Grid.Column="0">
                <TextBox x:Name="TxtRecherche"
                         Style="{StaticResource ModernTextBox}"
                         Height="40"
                         TextChanged="TxtRecherche_TextChanged"/>
                <!-- Placeholder : visible uniquement si TextBox vide et sans focus -->
                <TextBlock IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="#94A3B8">
                    <TextBlock.Text>🔍  Rechercher par nom du client, n° commande (ex. CMD-4), couturier ou motif…</TextBlock.Text>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtRecherche}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Filtre statut — TEXTES EXACTS attendus par AppliquerFiltre() -->
            <ComboBox Grid.Column="2"
                      x:Name="CmbFiltreStatut"
                      Height="40"
                      FontSize="13"
                      Background="White"
                      BorderBrush="{StaticResource RetBorder}"
                      Foreground="{StaticResource RetSlateDark}"
                      SelectionChanged="CmbFiltreStatut_SelectionChanged">
                <ComboBoxItem Content="Tous"             IsSelected="True"/>
                <ComboBoxItem Content="Signalé"/>
                <ComboBoxItem Content="En reprise"/>
                <ComboBoxItem Content="Prêt ✓"/>
                <ComboBoxItem Content="Rendu au client"/>
            </ComboBox>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             LIGNE 3 — PANNEAU PERFORMANCE QUALITÉ (carte ardoise/ambre)
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Margin="0,0,0,16"
                BorderThickness="1"
                BorderBrush="#1E293B">
            <!-- Dégradé ardoise : #0F172A (haut) → #1E293B (bas) -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── EN-TÊTE : titre ambre + sélecteur période ──────── -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titre avec accent ambre -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Barre ambre verticale -->
                        <Border Width="3" Height="20"
                                CornerRadius="2"
                                Background="{StaticResource RetAmber}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="📈"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="PERFORMANCE QUALITÉ DES COUTURIERS"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sélecteur période — ComboBox custom ardoise -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Période :"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- ComboBox Période : template complet ardoise/ambre, déroulement fonctionnel -->
                        <ComboBox x:Name="CmbPeriodeQualite"
                                  Width="148" Height="32"
                                  FontSize="11"
                                  SelectionChanged="CmbPeriodeQualite_SelectionChanged">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background"      Value="#1E293B"/>
                                    <Setter Property="Foreground"      Value="#E2E8F0"/>
                                    <Setter Property="BorderBrush"     Value="#334155"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <!-- ToggleButton = toute la surface cliquable -->
                                                    <ToggleButton x:Name="ToggleBtn"
                                                                  IsChecked="{Binding IsDropDownOpen,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}"
                                                                  Focusable="False"
                                                                  ClickMode="Press">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="tgBd"
                                                                        Background="#1E293B"
                                                                        BorderBrush="#334155"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="26"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Placeholder zone texte -->
                                                                        <ContentPresenter Grid.Column="0"
                                                                                          Margin="10,0,0,0"
                                                                                          VerticalAlignment="Center"/>
                                                                        <!-- Flèche ambre -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="▾"
                                                                                   FontSize="11"
                                                                                   Foreground="#D97706"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="tgBd" Property="BorderBrush" Value="#D97706"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="tgBd" Property="BorderBrush" Value="#D97706"/>
                                                                        <Setter TargetName="tgBd" Property="Background" Value="#0F172A"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <!-- Valeur sélectionnée (par-dessus le ToggleButton) -->
                                                    <ContentPresenter x:Name="ContentSite"
                                                                      IsHitTestVisible="False"
                                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                      Margin="10,0,26,0"
                                                                      VerticalAlignment="Center"/>

                                                    <!-- Popup déroulant -->
                                                    <Popup x:Name="PART_Popup"
                                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                                           AllowsTransparency="True"
                                                           Focusable="False"
                                                           PopupAnimation="Fade"
                                                           Placement="Bottom"
                                                           VerticalOffset="2">
                                                        <Border Background="#1E293B"
                                                                BorderBrush="#D97706"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                MinWidth="{TemplateBinding ActualWidth}"
                                                                Padding="4,4">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" Opacity="0.30"
                                                                                  BlurRadius="12" ShadowDepth="3"/>
                                                            </Border.Effect>
                                                            <ScrollViewer MaxHeight="200"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>

                            <!-- Style des items de la liste déroulante -->
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground"  Value="#E2E8F0"/>
                                    <Setter Property="Background"  Value="Transparent"/>
                                    <Setter Property="Padding"     Value="10,7"/>
                                    <Setter Property="FontSize"    Value="11"/>
                                    <Setter Property="Cursor"      Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="itBd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="5"
                                                        Margin="0,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="itBd" Property="Background" Value="#D97706"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itBd" Property="Background" Value="#92400E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Resources>

                            <ComboBoxItem Content="Ce mois-ci"   Tag="mois"       IsSelected="True"/>
                            <ComboBoxItem Content="Ce trimestre" Tag="trimestre"/>
                            <ComboBoxItem Content="Cette année"  Tag="annee"/>
                            <ComboBoxItem Content="Tout"         Tag="tout"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Liste des performances -->
                <ItemsControl x:Name="ListePerformance"
                              Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Carte ardoise avec liseré ambre à gauche -->
                            <Border Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Liseré ambre -->
                                    <Border Grid.Column="0"
                                            CornerRadius="8,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstExcellent}" Value="True">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstFaible}" Value="True">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstEligiblePrime}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource RetAmber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <!-- Contenu -->
                                    <Grid Grid.Column="1" Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                    <!-- Médaille / rang -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Medaille}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <!-- Nom couturier -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NomCouturier}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NomCouturier}"/>

                                    <!-- Nb pièces -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NbPiecesAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#CBD5E1"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="pièces"
                                                   FontSize="9" Foreground="#64748B"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Nb retours -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NbRetoursAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NbRetours}" Value="0">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="retours"
                                                   FontSize="9" Foreground="#64748B"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Taux qualité -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TauxQualiteAffiche}"
                                                   FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource RetAmber}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstExcellent}" Value="True">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstFaible}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="qualité"
                                                   FontSize="9" Foreground="#64748B"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Badge prime -->
                                    <Border Grid.Column="5"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstEligiblePrime}" Value="True">
                                                        <Setter Property="Background" Value="#065F46"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BadgePrime}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    </Grid><!-- fin Grid contenu col1 -->
                                </Grid><!-- fin Grid liseré+contenu -->
                            </Border><!-- fin Border carte couturier -->
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Message aucune donnée — texte visible en clair sur fond ardoise -->
                <TextBlock x:Name="TxtAucunePerformance"
                           Grid.Row="2"
                           Text="Aucune donnée de performance pour cette période."
                           FontSize="11" FontStyle="Italic"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,4"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             LIGNE 4 — CARTE TABLEAU (DataGrid + état vide)
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                BorderBrush="{StaticResource RetBorder}"
                BorderThickness="1"
                Padding="0">

            <Grid>
                <!-- DataGrid principal -->
                <DataGrid x:Name="GridRetours"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource RetColHeader}"/>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource RetRowStyle}"/>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource RetCellStyle}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- ── DATE SIGNALEMENT ───────────────────────── -->
                        <DataGridTextColumn Header="DATE"
                                            Binding="{Binding DateSignalementAffichee}"
                                            Width="Auto" MinWidth="78">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"           Value="11"/>
                                    <Setter Property="VerticalAlignment"  Value="Center"/>
                                    <Setter Property="Margin"             Value="8,0"/>
                                    <Setter Property="Foreground"         Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ── COMMANDE & PIÈCE ───────────────────────── -->
                        <DataGridTemplateColumn Header="COMMANDE &amp; PIÈCE"
                                                Width="*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RetAmber}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="CMD-{0}">
                                                    <Binding Path="IdCommande"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PieceCommande.TypeVetement}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource RetSlateBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Client + téléphone -->
                                        <TextBlock Text="{Binding ClientAffiche}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RetSlateDark}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ClientAffiche}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Commande.Client.Telephone}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource RetSlateMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── DÉFAUT SIGNALÉ ─────────────────────────── -->
                        <DataGridTemplateColumn Header="DÉFAUT SIGNALÉ"
                                                Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DescriptionProbleme}"
                                               Margin="8,4"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxHeight="52"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource RetSlateBody}"
                                               ToolTip="{Binding DescriptionProbleme}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── COUTURIERS (origine / reprise) ────────── -->
                        <DataGridTemplateColumn Header="COUTURIERS"
                                                Width="Auto" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Origine : "
                                                       FontSize="10"
                                                       Foreground="{StaticResource RetSlateMuted}"/>
                                            <TextBlock Text="{Binding CouturierOrigineAffiche}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource RetSlateBody}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Reprise : "
                                                       FontSize="10"
                                                       Foreground="{StaticResource RetSlateMuted}"/>
                                            <TextBlock Text="{Binding CouturierRepriseAffiche}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource RetAmber}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CouturierRepriseAffiche}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── RDV REPRISE ────────────────────────────── -->
                        <DataGridTextColumn Header="RDV REPRISE"
                                            Binding="{Binding DateRdvAffichee}"
                                            Width="Auto" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"          Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,0"/>
                                    <Setter Property="Foreground"        Value="{StaticResource RetSlateBody}"/>
                                    <Style.Triggers>
                                        <!-- Mise en évidence RDV dépassé -->
                                        <DataTrigger Binding="{Binding RdvEnRetard}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ── STATUT (badge coloré + Annulé) ─────────── -->
                        <DataGridTemplateColumn Header="STATUT"
                                                Width="100" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4"
                                            Margin="4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding StatutAffiche}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Défaut : gris (Rendu) -->
                                                <Setter Property="Background" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Signale">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En reprise">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Rendu">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                    <!-- Annulé prend le dessus -->
                                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatutAffiche}"
                                                   FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Défaut : blanc (pour fond sombre Rendu) -->
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Signale">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="En reprise">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Rendu">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ── ACTIONS (4 boutons compacts) ──────────── -->
                        <DataGridTemplateColumn Header="ACTIONS"
                                                Width="200" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="4,2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">

                                        <!-- Modifier -->
                                        <Button Content="✏️"
                                                Width="30" Height="30"
                                                FontSize="13"
                                                ToolTip="Modifier ce retour"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="1,1"
                                                Click="BtnEditerRetour_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity"   Value="0.3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Avancer le statut (texte contextuel) -->
                                        <Button Height="30"
                                                FontSize="9" FontWeight="SemiBold"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Margin="1,1"
                                                Padding="6,0"
                                                Click="BtnAvancerStatut_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"     Value="▶ Avancer"/>
                                                    <Setter Property="Background"  Value="{StaticResource RetAmber}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Textes selon statut -->
                                                        <DataTrigger Binding="{Binding Statut}" Value="Signale">
                                                            <Setter Property="Content"     Value="🔧 En reprise"/>
                                                            <Setter Property="Background"  Value="#D97706"/>
                                                            <Setter Property="ToolTip"     Value="Passer à En reprise"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="En reprise">
                                                            <Setter Property="Content"     Value="✓ Marquer Prêt"/>
                                                            <Setter Property="Background"  Value="#1D4ED8"/>
                                                            <Setter Property="ToolTip"     Value="Marquer comme Prêt"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                            <Setter Property="Content"     Value="📦 Rendu client"/>
                                                            <Setter Property="Background"  Value="#059669"/>
                                                            <Setter Property="ToolTip"     Value="Marquer comme Rendu au client"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Rendu">
                                                            <Setter Property="Content"     Value="✅ Clôturé"/>
                                                            <Setter Property="Background"  Value="#6B7280"/>
                                                            <Setter Property="IsEnabled"   Value="False"/>
                                                            <Setter Property="ToolTip"     Value="Ce retour est clôturé"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="IsEnabled"   Value="False"/>
                                                            <Setter Property="Content"     Value="Annulé"/>
                                                            <Setter Property="Background"  Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- WhatsApp (actif uniquement si Prêt) -->
                                        <Button Height="30"
                                                FontSize="9" FontWeight="SemiBold"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Margin="1,1"
                                                Padding="6,0"
                                                ToolTip="Notifier le client via WhatsApp (disponible quand Prêt)"
                                                Click="BtnWhatsAppRetour_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"     Value="💬"/>
                                                    <Setter Property="Background"  Value="#9CA3AF"/>
                                                    <Setter Property="IsEnabled"   Value="False"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Pret">
                                                            <Setter Property="Background" Value="#25D366"/>
                                                            <Setter Property="Content"    Value="💬 Prêt!"/>
                                                            <Setter Property="IsEnabled"  Value="True"/>
                                                            <Setter Property="ToolTip"    Value="Envoyer le message WhatsApp au client"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="IsEnabled"  Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Annuler -->
                                        <Button Content="🚫"
                                                Width="30" Height="30"
                                                FontSize="13"
                                                ToolTip="Annuler ce retour (avec motif)"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="1,1"
                                                Click="BtnAnnulerRetour_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity"   Value="0.25"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- ── ÉTAT VIDE (affiché par MettreAJourBadges via Visibility) ── -->
                <Border x:Name="PanneauVide"
                        Background="White"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,48">
                        <TextBlock Text="🔄"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtEtatVide"
                                   Text="Aucun retour enregistré"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource RetSlateDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Signalez un retour via le bouton « + Signaler un Retour »"
                                   FontSize="12"
                                   Foreground="{StaticResource RetSlateMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Page>
