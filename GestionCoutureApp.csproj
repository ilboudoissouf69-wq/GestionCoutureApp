<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Permet dotnet run sur une app WPF (UseWindowsShell=true lance le processus via l'OS) -->
    <UseWindowsShellExecute>true</UseWindowsShellExecute>

    <!-- Icône de l'exécutable (visible dans l'explorateur, la barre des tâches, l'installeur) -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Numéro de version unique (visible dans les propriétés de l'exe) -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <!-- Publication autonome (pas besoin d'installer .NET chez le client).
       Utilisation : dotnet publish -p:PublishProfile=SelfContainedWin64
       (défini dans un profil pour ne pas imposer le RID aux builds de dev). -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'SelfContainedWin64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\logo_retouche_choco.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Webcam migrée vers OpenCvSharp4 -->
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4218" />
    <!-- CommunityToolkit.Mvvm retire : non utilise (app 100% code-behind).
         A reintroduire lors d une migration MVVM progressive. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- Reference explicite : utilisee directement par BackupService (VACUUM INTO). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241024" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.19" />
  </ItemGroup>

  <!-- Accès aux membres internal depuis le projet de tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GestionCoutureApp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Exclure le sous-dossier de tests du SDK WPF (evite que le compilateur
       wpftmp ramasse les fichiers xUnit et echoue). -->
  <ItemGroup>
    <Compile Remove="GestionCoutureApp.Tests\**" />
    <EmbeddedResource Remove="GestionCoutureApp.Tests\**" />
    <None Remove="GestionCoutureApp.Tests\**" />
    <Content Remove="GestionCoutureApp.Tests\**" />
  </ItemGroup>

  <!-- client_secret.json NE DOIT PAS être inclus dans le projet ni copié.
     Il doit être placé manuellement dans %LOCALAPPDATA%\GestionCoutureApp\
     pour des raisons de sécurité (secret OAuth exposé dans le dépôt Git). -->

</Project>
