<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\logo_retouche_choco.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- DETTE TECHNIQUE : AForge.Video / AForge.Video.DirectShow (v2.2.5, 2013)
         Non maintenus depuis 2013 (API DirectShow COM).
         Migration recommandee : OpenCvSharp4.Windows ou Windows.Media.Capture.
         Impact : Views/WebcamCaptureWindow.cs uniquement. -->
    <PackageReference Include="AForge.Video" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" NoWarn="NU1701" />
    <!-- CommunityToolkit.Mvvm retire : non utilise (app 100% code-behind).
         A reintroduire lors d une migration MVVM progressive. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- Reference explicite : utilisee directement par BackupService (VACUUM INTO). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.19" />
  </ItemGroup>

  <!-- Exclure le sous-dossier de tests du SDK WPF (evite que le compilateur
       wpftmp ramasse les fichiers xUnit et echoue). -->
  <ItemGroup>
    <Compile Remove="GestionCoutureApp.Tests\**" />
    <EmbeddedResource Remove="GestionCoutureApp.Tests\**" />
    <None Remove="GestionCoutureApp.Tests\**" />
    <Content Remove="GestionCoutureApp.Tests\**" />
  </ItemGroup>

</Project>
