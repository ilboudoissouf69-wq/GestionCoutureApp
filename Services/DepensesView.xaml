<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GestionCoutureApp.Views.DepensesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- TITRE -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Depenses"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border Height="3"
                        Width="48"
                        CornerRadius="2"
                        Background="#CC0000"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 3 Cartes statistiques -->
            <UniformGrid Columns="3"
                    Margin="0,0,0,20">

                <!-- Total du mois — noir charbon -->
                <Border CornerRadius="8"
                        Padding="18,14"
                        Margin="0,0,8,0"
                        Background="#1A1A1A">
                    <StackPanel>
                        <TextBlock Text="DEPENSES DU MOIS"
                                   FontSize="10"
                                FontWeight="Bold"
                                Foreground="#B0A8A4"/>
                        <TextBlock x:Name="TxtTotalMois"
                                   Text="0"
                                FontSize="28"
                                FontWeight="Bold"
                                   Foreground="White"
                                Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA"
                                FontSize="11"
                                Foreground="#B0A8A4"/>
                    </StackPanel>
                </Border>

                <!-- Aujourd'hui — orange -->
                <Border CornerRadius="8"
                        Padding="18,14"
                        Margin="0,0,8,0"
                        Background="#D97706">
                    <StackPanel>
                        <TextBlock Text="AUJOURD'HUI"
                                   FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FFF3CD"/>
                        <TextBlock x:Name="TxtTotalJour"
                                   Text="0"
                                FontSize="28"
                                FontWeight="Bold"
                                   Foreground="White"
                                Margin="0,4,0,2"/>
                        <TextBlock Text="FCFA"
                                FontSize="11"
                                Foreground="#FFF3CD"/>
                    </StackPanel>
                </Border>

                <!-- Nombre — rouge -->
                <Border CornerRadius="8"
                        Padding="18,14"
                        Background="#CC0000">
                    <StackPanel>
                        <TextBlock Text="NOMBRE CE MOIS"
                                   FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FFCCCC"/>
                        <TextBlock x:Name="TxtNbDepenses"
                                   Text="0"
                                FontSize="28"
                                FontWeight="Bold"
                                   Foreground="White"
                                Margin="0,4,0,2"/>
                        <TextBlock Text="depense(s)"
                                FontSize="11"
                                Foreground="#FFCCCC"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Formulaire d'ajout -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <Border CornerRadius="10,10,0,0"
                            Padding="20,14"
                            Background="#1A1A1A">
                        <TextBlock Text="Nouvelle depense"
                                   FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"/>
                    </Border>

                    <Grid Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Type *"
                                    Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbTypeDepense"
                                    Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Loyer"/>
                                <ComboBoxItem Content="Electricite"/>
                                <ComboBoxItem Content="Eau"/>
                                <ComboBoxItem Content="Materiel"/>
                                <ComboBoxItem Content="Transport"/>
                                <ComboBoxItem Content="Salaires"/>
                                <ComboBoxItem Content="Divers"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Montant (FCFA) *"
                                    Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMontant"
                                    Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Date *"
                                    Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateDepense"
                                    Height="38"
                                    FontSize="13"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="20,12,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Description"
                                    Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtDescription"
                                    Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Ajouter"
                                Style="{StaticResource BtnSuccess}"
                                Height="38"
                                VerticalAlignment="Bottom"
                                Click="BtnAjouter_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtMessage"
                               FontSize="12"
                            TextWrapping="Wrap"
                            Margin="20,8,20,16"/>
                </StackPanel>
            </Border>

            <!-- Liste des depenses -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Historique des depenses"
                               FontSize="14"
                            FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridDepenses"
                              Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateDepense, StringFormat=\{0:dd/MM/yyyy\}}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding TypeDepense}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Montant (FCFA)"
                                                Binding="{Binding Montant, StringFormat=\{0:N0\}}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Par"
                                                Binding="{Binding NomOperateur}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0">
                        <Button Content="Supprimer la selection"
                                Style="{StaticResource BtnDanger}"
                                Height="34"
                                FontSize="12"
                                Click="BtnSupprimer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>