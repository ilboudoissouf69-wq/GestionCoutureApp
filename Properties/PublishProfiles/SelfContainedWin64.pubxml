<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication AUTONOME pour Windows 64 bits.
  L'exécutable produit n'exige pas l'installation du runtime .NET sur le poste cible.

  Commande :
      dotnet publish GestionCoutureApp.csproj -c Release -p:PublishProfile=SelfContainedWin64

  Sortie : dossier <racine>\publish\  (récupéré par le script Inno Setup)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PublishDir>publish\</PublishDir>
    <DeleteExistingFiles>True</DeleteExistingFiles>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
